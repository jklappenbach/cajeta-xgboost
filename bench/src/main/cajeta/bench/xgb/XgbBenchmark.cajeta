package bench.xgb;

import dev.cajeta.bench.Benchmark;

/**
 * What every dev.cajeta.xgboost row shares: area `ml` (the pages live under
 * bench/ml/, spec §12.8, so the ids are ml/xgb-*), the library and platform,
 * and the per-variant state a measured variant leaves for the harness to
 * read back. Whether a variant runs, and why not, are functions of the
 * variant (supportsVariant, skipReasonFor); nothing is stashed between
 * harness calls. Every subclass's prepare(v) starts with begin(v).
 */
public class XgbBenchmark extends Benchmark {

    public String note;
    public String ds;
    public String mdl;
    public int64 nIn;

    public XgbBenchmark() {
        this.note = "";
        this.ds = "";
        this.mdl = "";
        this.nIn = -1;
    }

    public String area() {
        return "ml";
    }

    public String library() {
        return "dev.cajeta.xgboost";
    }

    public String libraryVersion() {
        return "0.7.0";
    }

    public String platform() {
        return "dev.cajeta.xgboost 0.7.0";
    }

    public String competitorNote() {
        return this.note;
    }

    public String datasetInfo() {
        return this.ds;
    }

    public String model() {
        return this.mdl;
    }

    public int64 inputSize() {
        return this.nIn;
    }

    // The start of a measured variant: the per-variant state back to empty.
    public void begin(String v) {
        this.note = "";
        this.ds = "";
        this.mdl = "";
        this.nIn = -1;
    }

    // Why `v` cannot run here, or "" when it can.
    public #String whyNot(String v) {
        if (v.equals("device")) {
            if (Data.noGpu()) {
                return "GPU held by another session (CAJETA_BENCH_NO_GPU=1)";
            }
        }
        if (!Data.has("xgb/X.npy")) {
            return "dataset xgb/X.npy not generated (run bench.sh, which runs gen_data.py)";
        }
        return "";
    }

    public boolean supportsVariant(String v) {
        String why #= this.whyNot(v);
        return why.isEmpty();
    }

    // The skipped row is made right after this call: it carries no state of
    // the variant measured before it.
    public String skipReasonFor(String v) {
        this.begin(v);
        String why #= this.whyNot(v);
        return "" + why;
    }
}
