{
    // cajeta-xgboost — a bit-exact-to-NVIDIA GBDT (gradient-boosted decision
    // tree) trainer and predictor: XGBoost's gpu_hist algorithm reproduced in
    // pure Cajeta, deterministic to the bit against the reference's CUDA
    // output (quantile sketch, int64 fixed-point histogram, split selection,
    // objectives with device-transcendental models). See docs/ for the tour
    // and the determinism contract.
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable
    // `.cja` rather than an executable.
    //
    // VERSIONING — `details.version` is the SINGLE source of truth. It names
    // the built archive (`dev.cajeta.xgboost-<version>.cja`), it is what CI
    // publishes to Olla, and CI asserts a `v*` tag agrees with it. The old
    // VERSION file is gone — that duplication is what shipped cajeta-codec's
    // 0.7.1 as a 0.7.0 artifact.

    "details": {
        "name":               "dev.cajeta.xgboost",
        "version":            "0.4.0",
        "description":        "cajeta-xgboost — bit-exact-to-NVIDIA GBDT training and prediction",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // The toolchain this library is built and gated against. It is not here
        // for being the newest release — it is here because nothing in this tree
        // builds under the pins it replaces, measured on this checkout against
        // the released v0.29.0 from a cleared artifact cache.
        //
        // A consumer's compiler re-checks a DEPENDENCY archive's own sources, so
        // the dependency pins and the toolchain move together or not at all. At
        // the old pins the test binary never links: unit 0.2.0 stops it with
        // CAJETA_ERROR_CAPTURED_BORROW_PARAM naming `pred`, and with that raised,
        // ml 0.10.0 stops it again naming `x`. Neither symbol exists in this
        // library. The archives that do link are unit 0.3.0 and ml 0.10.2, and
        // both were cut by v0.29.0.
        //
        // The second thing the floor bought is the tour. v0.29.0 raises
        // CAJETA_ERROR_OWNED_RESULT_NEEDS_TRANSFER where a `#`-returning call is
        // received with a plain `=`, and the tour had 105 of them, every one
        // invisible under the old v0.17.4 pin.
        //
        // Keep this in step with CAJETA_VERSION in .github/workflows/release.yml.
        // They are separate knobs: this one is documentation, the workflow's is
        // what CI installs, and a stale value here is a false claim about what
        // builds.
        "toolchain": {
            "version": "0.29.0"
        },

        // cajeta.math.sfu.SfuMath loads the probed SFU tables (RCP_TABLE / EX2_TABLE) and
        // FixtureLoader reads golden fixtures from disk.
        "capabilities": ["filesystem"],

        // U12: @Kernel device codegen for every backend the toolchain emits —
        // the runtime picks CUDA -> HIP -> Vulkan -> CPU at first device
        // touch, so one archive serves phoenix (CUDA), Strix Halo
        // (HIP/Vulkan), and GPU-less CI (CPU emulation). Needs >= v0.17.2
        // (classpath @Kernel registration + the backend-tagged registry).
        "xpu-backend": "nvptx,amdgpu,vulkan,cpu",

        // The core stdlib (cajeta.lang, cajeta.math, cajeta.nucleo, …) is
        // built into the toolchain — not declared, not fetched.
        // dev.cajeta.ml supplies the ecosystem estimator protocol
        // (Estimator/Predictor) that XGBRegressor conforms to, plus the
        // Metrics/Split machinery the adapter and its tests lean on;
        // run-tests.sh resolves it (sibling checkout → store → Olla).
        //
        // 0.10.0 -> 0.10.2 is a required floor, not a courtesy raise. The 0.10.0
        // archive carries dev.cajeta.ml.data.Batches, which keeps a plain
        // `Tensor<float32> x` parameter in a field of the same name, and this
        // toolchain's captured-borrow check rejects it — measured here as
        // CAJETA_ERROR_CAPTURED_BORROW_PARAM naming `x`, a symbol this library
        // does not contain. 0.10.2 stores it with `#=`.
        "dependencies": {
            "dev.cajeta.ml": "0.10.2"
        },

        // The suite is driven by cajeta-unit's reflective @Test discovery;
        // run-tests.sh resolves the archive (sibling checkout, then store,
        // then a sha256-verified Olla fetch at this pin).
        //
        // 0.2.0 -> 0.3.0 for the same reason and by the same measurement: 0.2.0
        // brings a PredMatcher that keeps a plain function parameter `pred` in a
        // field, and the test binary refuses to link with
        // CAJETA_ERROR_CAPTURED_BORROW_PARAM naming it. 0.3.0 takes the predicate
        // owned.
        "dev-dependencies": {
            "dev.cajeta.unit": "0.3.0"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` — this is a library; the build emits a .cja.
        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            // Delegates to ./run-tests.sh: the suite compiles test sources
            // against the built .cja with cajeta-unit on the classpath, and
            // the script owns fixture/capture wiring (XGBOOST_FIXTURES,
            // RCP_TABLE, EX2_TABLE, EXPF_SWEEP — capture-dependent tests
            // self-skip when the .gitignore'd 32 MB tables are absent).
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "tour": {
            // The runnable tour (tour/src): builds the library, compiles the
            // tour against it, runs it. Exits non-zero if any demonstrated
            // claim fails — the tour doubles as a public-surface smoke test.
            "description": "Build + run the guided tour of the public API",
            "actions": [
                { "action": "exec", "command": "./run-tour.sh" }
            ]
        },

        "release": {
            "description": "Optimized release build of the library (.cja)",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
