package dev.cajeta.xgboost.tour;

import cajeta.math.Tensor;
import dev.cajeta.xgboost.api.GBDT;
import dev.cajeta.xgboost.api.Params;
import dev.cajeta.xgboost.booster.Model;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.objective.SquaredError;
import dev.cajeta.xgboost.objective.Logistic;
import dev.cajeta.xgboost.objective.Softmax;

// Objectives — what the booster is actually minimizing, and the three
// tasks that fall out of it.
//
// An objective is two functions of (margin, label): the first-order
// gradient and the second-order hessian. That is the entire contract; the
// tree builder consumes grad/hess and never learns which loss produced
// them. Everything downstream — the quantile sketch, the fixed-point
// histogram, the split search — is objective-agnostic, which is why a
// K-class fit is simply K trees per round over K gradient slices.
//
//   SQUARED_ERROR  reg:squarederror — 1 group, identity link, raw margin
//   LOGISTIC       binary:logistic  — 1 group, sigmoid link -> probability
//   SOFTMAX        multi:softmax    — K groups, softmax link -> class
//
// Set it on Params (with numClass for softmax) and GBDT.fit does the rest:
//
//   Params p = heap Params();
//   p.objective = Objective.SOFTMAX;  p.numClass = 3;
//
// Prediction applies the inverse link: GBDT.predict gives raw margins,
// predictProba gives calibrated probabilities, predictClass gives the
// decision. The same house table drives all three tasks — price as a
// number, "is it expensive?" as a yes/no, and a price tier as a class.
public class ObjectivesDemo extends DemoClass {

    public void execute() {
        this.section("7. Objectives — regression, binary, and multiclass from one table");

        Tensor<float64> x = Data.x();
        float64[] price = Data.y(x);
        int64 n = Data.rows();
        int64 nf = Data.features();

        // --- the gradients themselves ------------------------------------
        // Squared error: residual gradient, constant hessian — which is why
        // a squared-error leaf is just a (regularized) mean residual.
        float64 g = SquaredError.grad((float32) 12.0, (float64) 10.0);
        float64 h = SquaredError.hess((float32) 12.0, (float64) 10.0);
        this.check(g == (float64) 2.0 && h == (float64) 1.0,
            "squared error: grad = margin - label, hess = 1");
        // Logistic: sigmoid is the link; the hessian peaks at the boundary
        // (p(1-p) = 0.25), which is why confident rows stop moving.
        float32 p0 = Logistic.sigmoid((float32) 0.0);
        this.check(p0 > (float32) 0.4999 && p0 < (float32) 0.5001,
            "sigmoid(0) = 0.5 — the decision boundary");
        this.check(Logistic.hess((float32) 0.0, (float64) 1.0) > (float64) 0.24,
            "logistic hess = p(1-p), maximal at the boundary");
        // Softmax: shift-invariant, so a row's gradients sum to zero.
        int64 K = (int64) 3;
        float32[] mm = heap float32[K];
        float64[] cls = heap float64[1];
        cls[0] = (float64) 1.0;
        float64[] mg = heap float64[K];
        float64[] mh = heap float64[K];
        Softmax.gradHess(mm, cls, (int64) 1, K, mg, mh);
        float64 sum = mg[0] + mg[1] + mg[2];
        this.check(mg[1] < (float64) 0.0 && sum > (float64) 0.0 - (float64) 0.001
            && sum < (float64) 0.001,
            "softmax: true class pushed up, per-row gradients sum to zero");

        // --- binary:logistic, trained ------------------------------------
        float64[] expensive = Data.expensiveLabels(price);
        Params bp = heap Params();
        bp.objective = Objective.LOGISTIC;
        bp.rounds = (int64) 12;
        bp.maxDepth = (int64) 4;
        Model bm = GBDT.fit(x, expensive, n, nf, bp);
        this.check(bm.numClass == (int64) 1,
            "binary:logistic is a single output group — one tree per round");
        this.check(bm.rounds == (int64) 12, "12 rounds -> 12 trees");

        float32[] proba = GBDT.predictProba(bm, x, n, nf);
        int64[] guess = GBDT.predictClass(bm, x, n, nf);
        boolean inRange = true;
        int64 correct = (int64) 0;
        int64 i = (int64) 0;
        while (i < n) {
            if (!(proba[i] > (float32) 0.0 && proba[i] < (float32) 1.0)) {
                inRange = false;
            }
            if ((float64) guess[i] == expensive[i]) { correct = correct + (int64) 1; }
            i = i + (int64) 1;
        }
        float64 acc = (float64) correct / (float64) n;
        System.stdout.println("   binary:logistic — training accuracy "
            + acc + ", P(expensive) for row 0 = " + (float64) proba[0]);
        this.check(inRange,
            "the sigmoid link puts every prediction strictly inside (0, 1)");
        this.check(acc > (float64) 0.95,
            "the trees separate expensive listings (accuracy > 95%)");
        // The link is monotone, so the class decision needs no exp at all:
        // margin > 0 is exactly probability > 0.5.
        float32[] rawMargin = GBDT.predict(bm, x, n, nf);
        boolean agrees = true;
        i = (int64) 0;
        while (i < n) {
            int64 fromMargin = rawMargin[i] > (float32) 0.0 ? (int64) 1 : (int64) 0;
            if (fromMargin != guess[i]) { agrees = false; }
            i = i + (int64) 1;
        }
        this.check(agrees,
            "margin > 0 <=> proba > 0.5 — the decision is link-free");

        // --- multi:softmax, trained --------------------------------------
        float64[] tier = Data.tierLabels(price);
        Params mp = heap Params();
        mp.objective = Objective.SOFTMAX;
        mp.numClass = Data.tiers();
        mp.rounds = (int64) 12;
        mp.maxDepth = (int64) 4;
        Model mm2 = GBDT.fit(x, tier, n, nf, mp);
        this.check(mm2.numClass == Data.tiers(),
            "the model records its class count");
        this.check(mm2.rounds == (int64) 12 * Data.tiers(),
            "K groups: 12 rounds x 3 classes = 36 trees, round-major");

        float32[] mproba = GBDT.predictProba(mm2, x, n, nf);
        int64[] mguess = GBDT.predictClass(mm2, x, n, nf);
        boolean rowsSumToOne = true;
        int64 mcorrect = (int64) 0;
        i = (int64) 0;
        while (i < n) {
            float64 rs = (float64) 0.0;
            int64 k = (int64) 0;
            while (k < Data.tiers()) {
                rs = rs + (float64) mproba[i * Data.tiers() + k];
                k = k + (int64) 1;
            }
            if (rs < (float64) 0.999 || rs > (float64) 1.001) { rowsSumToOne = false; }
            if ((float64) mguess[i] == tier[i]) { mcorrect = mcorrect + (int64) 1; }
            i = i + (int64) 1;
        }
        float64 macc = (float64) mcorrect / (float64) n;
        System.stdout.println("   multi:softmax — training accuracy " + macc
            + ", row 0 predicted " + Data.tierName(mguess[0])
            + " (true " + Data.tierName((int64) tier[0]) + ")");
        this.check(rowsSumToOne,
            "softmax gives a proper distribution: every row's probabilities sum to 1");
        this.check(macc > (float64) 0.90,
            "3-class price tiers recovered (accuracy > 90%)");

        // Determinism holds for classification too — it is a property of the
        // engine, not of the objective.
        Model again = GBDT.fit(x, tier, n, nf, mp);
        float32[] mproba2 = GBDT.predictProba(again, x, n, nf);
        this.check(DemoClass.sameBitsAll(mproba, mproba2, n * Data.tiers()),
            "a refit reproduces the class probabilities bit-for-bit");

        // A softmax fit without a class count is refused rather than
        // silently trained as a one-group model.
        Params bad = heap Params();
        bad.objective = Objective.SOFTMAX;
        boolean refused = false;
        try {
            Model never = GBDT.fit(x, tier, n, nf, bad);
        } catch (cajeta.error.RecoverableException e) {
            refused = true;
        }
        this.check(refused, "multi:softmax without numClass >= 2 is refused");
    }
}
