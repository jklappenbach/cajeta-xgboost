package dev.cajeta.xgboost.tour;

import cajeta.collection.ArrayList;
import dev.cajeta.xgboost.XGBoost;

/**
 * The cajeta-xgboost tour — a runnable walk through the full public
 * surface, one self-checking demo per topic:
 *
 *   ParamsDemo      the knobs, the defaults, the determinism contract
 *   PrepDemo        quantile cuts + binning (bin once, train many)
 *   TrainDemo       fit, bit-identical refits, the transparent Model
 *   MissingDemo     NaN routed by each node's learned default direction
 *   ImportanceDemo  get_score parity — and the D2 gap, shown not hidden
 *   ObjectivesDemo  the gradients underneath — and the D1 gap
 *   PersistDemo     serialize to a file, reload, predict identically
 *   InternalsDemo   one round through the int64 fixed-point machinery
 *   FastMathDemo    modelling the GPU's special-function units
 *   EstimatorDemo   xgboost as a dev.cajeta.ml Predictor
 *
 *     ./run-tour.sh          # build the library + ml dep, compile, run
 *
 * Every demo PRINTS what it demonstrates and CHECKS it: the tour exits
 * non-zero the moment a demonstrated claim stops being true. Narrative
 * companion: docs/Tour.md.
 *
 * The dataset (Data.cajeta) is a deterministic house-price table with
 * named features and genuinely missing values — no RNG, no files, no
 * clock — so the tour produces identical bits on every machine, which is
 * rather the point of this library.
 */
public final class Tour {

    public static int32 main() {
        System.stdout.println("cajeta-xgboost tour — library version " + XGBoost.version());
        DemoClass.checks = 0;
        DemoClass.failures = 0;

        ArrayList<DemoClass> demos = heap ArrayList<DemoClass>();
        demos.add(heap ParamsDemo());
        demos.add(heap PrepDemo());
        demos.add(heap TrainDemo());
        demos.add(heap MissingDemo());
        demos.add(heap ImportanceDemo());
        demos.add(heap ObjectivesDemo());
        demos.add(heap PersistDemo());
        demos.add(heap InternalsDemo());
        demos.add(heap FastMathDemo());
        demos.add(heap EstimatorDemo());

        int32 i = 0;
        int32 n = (int32) demos.count();
        while (i < n) {
            demos.get(i).execute();
            i = i + 1;
        }

        System.stdout.println("");
        if (DemoClass.failures > 0) {
            System.stdout.println("TOUR FAILED: " + DemoClass.failures
                + " of " + DemoClass.checks + " checks");
            return 1;
        }
        System.stdout.println("tour complete — " + DemoClass.checks
            + " demonstrated claims, all checked");
        return 0;
    }
}
