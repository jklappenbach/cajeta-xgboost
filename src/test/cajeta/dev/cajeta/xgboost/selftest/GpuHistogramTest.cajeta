package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.gpu.GpuHistogram;
import dev.cajeta.xgboost.gpu.GpuTrainState;
import dev.cajeta.xgboost.tree.Split;
import dev.cajeta.xgboost.tree.SplitFinder;
import dev.cajeta.xgboost.tree.GradientQuantiser;
import dev.cajeta.xgboost.tree.Histogram;

/**
 * U12.1.1 — the GPU histogram is bit-identical to the CPU one on a fixture.
 * The kernel runs on whatever backend `cajeta.xpu` selects (CUDA → HIP →
 * Vulkan → CPU emulation), so this same test IS the cross-backend identity
 * probe: Vulkan on the Strix Halo dev box, CUDA on phoenix-wsl, CPU
 * emulation on hosted CI — one assertion, §8.2/§8.3 evidence everywhere it
 * runs. Integer-only accumulation (host quantization + native int64
 * atomics) is what makes the claim backend-independent.
 */
public class GpuHistogramTest {

    public GpuHistogramTest() { return; }

    static void assertSame(Histogram cpu, Histogram gpu) {
        Assert.equals(gpu.nbins, cpu.nbins);
        Assert.equals(gpu.nf, cpu.nf);
        Assert.equals(gpu.totalG, cpu.totalG);
        Assert.equals(gpu.totalH, cpu.totalH);
        int64 b = (int64) 0;
        while (b < cpu.nbins) {
            Assert.equals(gpu.g[b], cpu.g[b]);
            Assert.equals(gpu.h[b], cpu.h[b]);
            b = b + (int64) 1;
        }
        return;
    }

    // Root histogram over all rows, tiny_reg (5 features, 200 rows).
    @Test
    public void rootHistogramBitIdenticalToCpu() {
        FixtureLoader f #= FixtureLoader.open("tiny_reg");
        float64[] g #= f.gradRound((int32) 0);
        float64[] h #= f.hessRound((int32) 0);
        int64 n = (int64) g.count();
        GradientQuantiser q #= GradientQuantiser.build(g, h, n);

        Histogram cpu #= Histogram.buildAll(f.bins(), f.cutPtrs(), q, g, h, n);
        Histogram gpu #= GpuHistogram.buildAll(f.bins(), f.cutPtrs(), q, g, h, n);
        assertSame(cpu, gpu);
        return;
    }

    // A partitioned build (position-based, like every non-root node), on the
    // missing-value fixture so the bin == -1 skip path is exercised too.
    @Test
    public void partitionedHistogramBitIdenticalToCpu() {
        FixtureLoader f #= FixtureLoader.open("tiny_reg_missing");
        float64[] g #= f.gradRound((int32) 0);
        float64[] h #= f.hessRound((int32) 0);
        int64 n = (int64) g.count();
        GradientQuantiser q #= GradientQuantiser.build(g, h, n);

        // A deterministic 2-way partition: rows alternate between nodes 1/2.
        int64[] position = heap int64[n];
        int64 r = (int64) 0;
        while (r < n) {
            position[r] = (int64) 1 + r % (int64) 2;
            r = r + (int64) 1;
        }

        Histogram cpu1 #= Histogram.buildPos(f.bins(), f.cutPtrs(), q, g, h,
                                            position, (int64) 1, n);
        Histogram gpu1 #= GpuHistogram.buildPos(f.bins(), f.cutPtrs(), q, g, h,
                                               position, (int64) 1, n);
        assertSame(cpu1, gpu1);

        Histogram cpu2 #= Histogram.buildPos(f.bins(), f.cutPtrs(), q, g, h,
                                            position, (int64) 2, n);
        Histogram gpu2 #= GpuHistogram.buildPos(f.bins(), f.cutPtrs(), q, g, h,
                                               position, (int64) 2, n);
        assertSame(cpu2, gpu2);
        return;
    }

    // Negative quantized gradients cross the u32 word boundary constantly;
    // large_reg (20k×50, 5% missing, 256 bins/feature) hammers the
    // int64 atomic scatter at real bin occupancy.
    @Test
    public void largeRootHistogramBitIdenticalToCpu() {
        FixtureLoader f #= FixtureLoader.open("large_reg");
        float64[] g #= f.gradRound((int32) 0);
        float64[] h #= f.hessRound((int32) 0);
        int64 n = (int64) g.count();
        GradientQuantiser q #= GradientQuantiser.build(g, h, n);

        Histogram cpu #= Histogram.buildAll(f.bins(), f.cutPtrs(), q, g, h, n);
        Histogram gpu #= GpuHistogram.buildAll(f.bins(), f.cutPtrs(), q, g, h, n);
        assertSame(cpu, gpu);
        return;
    }

    /** Asserts node `nid`'s segment histogram equals the CPU builder's over `position`. */
    static void assertSegmentHistogram(GpuTrainState st, FixtureLoader f, GradientQuantiser q,
                                       float64[] g, float64[] h, int64[] position,
                                       int64 nid, int64 n) {
        Histogram cpu #= Histogram.buildPos(f.bins(), f.cutPtrs(), q, g, h, position, nid, n);
        int64[] hg = heap int64[cpu.nbins];
        int64[] hh = heap int64[cpu.nbins];
        int64[] tg = heap int64[8];
        int64[] th = heap int64[8];
        st.buildNode(nid, hg, hh, tg, th, (int64) 0);
        int64 b = (int64) 0;
        while (b < cpu.nbins) {
            Assert.equals(hg[b], cpu.g[b]);
            Assert.equals(hh[b], cpu.h[b]);
            b = b + (int64) 1;
        }
        Assert.equals(tg[nid], cpu.totalG);
        Assert.equals(th[nid], cpu.totalH);
        return;
    }

    // int64-scan-verbs 7.1.3: a node's histogram built from its segment equals
    // the CPU builder's bit for bit, missing values (15%) included.
    @Test
    public void segmentHistogramsBitIdenticalToCpu() {
        FixtureLoader f #= FixtureLoader.open("tiny_reg_missing");
        float64[] g #= f.gradRound((int32) 0);
        float64[] h #= f.hessRound((int32) 0);
        int64 n = (int64) g.count();
        int64 nf = f.cutPtrs().shapeAt(0) - (int64) 1;
        GradientQuantiser q #= GradientQuantiser.build(g, h, n);
        GpuTrainState st #= GpuTrainState.create(f.bins(), f.cutPtrs(), n);
        st.beginTree(q, g, h, (int64) 8);
        int64[] position = heap int64[n];
        GpuHistogramTest.assertSegmentHistogram(st, f, q, g, h, position, (int64) 0, n);

        Histogram root #= Histogram.buildAll(f.bins(), f.cutPtrs(), q, g, h, n);
        Split s #= SplitFinder.findBest(root, f.cutPtrs(), f.cutValues(), q,
                                       (float64) 1.0, (float64) 0.0, (float64) 1.0);
        int64[] cnts #= st.split(s, f.cutPtrs(), (int64) 0, (int64) 1, (int64) 2);
        int64[] cpuCnts #= GpuPartitionTest.cpuPartition(f.bins(), f.cutPtrs(), s, position,
                                                        (int64) 0, (int64) 1, (int64) 2, nf, n);
        Assert.equals(cnts[0], cpuCnts[0]);
        GpuHistogramTest.assertSegmentHistogram(st, f, q, g, h, position, (int64) 1, n);
        GpuHistogramTest.assertSegmentHistogram(st, f, q, g, h, position, (int64) 2, n);
        return;
    }
}
