package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.booster.Booster;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.booster.Model;

/**
 * U10.1.3 — the parity runner reports the exact `(round, node, field)` of the first
 * divergence. Trains `tiny_reg` (bit-exact reg model), then:
 *   - a clean model compares bit-identical (empty message, and margins clean);
 *   - a one-bit mutation to round-0 node-0's base weight is caught and reported with
 *     the round, the node, and the field named — the "drift fails with the exact
 *     location" guarantee, exercised without needing the large fixture.
 */
public class ParityRunnerTest {

    public ParityRunnerTest() { return; }

    static #Model trainTinyReg(FixtureLoader f, int64 rounds, float32[] marginHistory) {
        Tensor<float64> yT = f.y();
        int64 n = yT.shapeAt(0);
        float64[] label = heap float64[n];
        int64 i = (int64) 0;
        while (i < n) { label[i] = yT.flatGet(i); i = i + (int64) 1; }
        return Booster.train(f.bins(), f.cutPtrs(), f.cutValues(), label, n, rounds,
                             (int64) 4, (int64) 0,
                             (float64) 1.0, (float64) 0.0, (float64) 0.0, (float64) 1.0,
                             (float64) 0.3, (float64) 0.5, Objective.SQUARED_ERROR, (int64) 1, marginHistory);
    }

    @Test
    public void cleanModelComparesBitIdentical() {
        FixtureLoader f = FixtureLoader.open("tiny_reg");
        int64 rounds = (int64) 3;
        int64 n = f.y().shapeAt(0);
        float32[] marginHistory = heap float32[rounds * n];
        Model m = ParityRunnerTest.trainTinyReg(f, rounds, marginHistory);

        String treeDiff = ParityRunner.compareTrees(m, f, rounds);
        Assert.that(treeDiff).isEqualTo("");

        String marginDiff = ParityRunner.compareMargins(marginHistory, f.margins(), rounds, n);
        Assert.that(marginDiff).isEqualTo("");
        return;
    }

    @Test
    public void mutationIsReportedWithExactLocation() {
        FixtureLoader f = FixtureLoader.open("tiny_reg");
        int64 rounds = (int64) 3;
        int64 n = f.y().shapeAt(0);
        float32[] marginHistory = heap float32[rounds * n];
        Model m = ParityRunnerTest.trainTinyReg(f, rounds, marginHistory);

        // Perturb round-0 node-0's base weight by one step — must be caught.
        m.baseWeights[0] = m.baseWeights[0] + (float32) 1.0;

        String diff = ParityRunner.compareTrees(m, f, rounds);
        Assert.isFalse(diff.equals(""));
        Assert.isTrue(diff.contains("round 0"));
        Assert.isTrue(diff.contains("node 0"));
        Assert.isTrue(diff.contains("base_weight"));
        return;
    }
}
