package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.fastmath.FastMath;
import dev.cajeta.xgboost.objective.Softmax;

/**
 * U7.1.1 (round 0) — `multi:softprob` grad/hess bit-identical to the reference dump
 * (`tiny_multi`, K=4). Round 0's per-class margins are all the base (0), so
 * `expf(·)=1`, `wsum=K`, `p=1/K=0.25` exactly (no `expf`): `grad = 0.25 − onehot`,
 * `hess = 2·0.25·0.75 = 0.375`. Validates the softmax grad/hess formula and the
 * `[n*K]` layout; later rounds hit `expf` (U12).
 */
public class SoftmaxObjectiveTest {

    public SoftmaxObjectiveTest() { return; }

    @Test
    public void roundZeroGradHessBitIdentical() {
        FixtureLoader f = FixtureLoader.open("tiny_multi");
        Tensor<float64> yT      = f.y();
        Tensor<float64> refGrad = f.grad();   // [rounds, n, K] flat
        Tensor<float64> refHess = f.hess();
        int64 n = yT.shapeAt(0);
        int64 K = (int64) 4;

        float64[] label = heap float64[n];
        int64 i = (int64) 0;
        while (i < n) { label[i] = yT.flatGet(i); i = i + (int64) 1; }

        float32[] margin = heap float32[n * K];   // all 0 = base margin
        float64[] grad = heap float64[n * K];
        float64[] hess = heap float64[n * K];
        Softmax.gradHess(margin, label, n, K, grad, hess);

        int64 t = (int64) 0;
        while (t < n * K) {
            Assert.thatFloat(grad[t]).isEqualTo(refGrad.flatGet(t));
            Assert.thatFloat(hess[t]).isEqualTo(refHess.flatGet(t));
            t = t + (int64) 1;
        }
        return;
    }

    /**
     * Multi-round softmax grad/hess bit-identical to REAL device ground truth
     * — device_grad/device_hess.npy captured on PHOENIX (RTX 4090,
     * tools/gpuprobe/probe_device_grads.cu: the verbatim multiclass_obj.cu
     * GetGradient kernel), keyed by input margin row. Nonzero margins hit
     * device expf on every term, so this pins the whole Softmax op order —
     * float-min wmax seed, float32-rounded terms into the float64 wsum,
     * recomputed p, the reference clamp. Validated 7200/7200 exact at capture
     * time. Needs the probed ex2 table; self-skips without it.
     */
    @Test
    public void multiRoundGradHessDeviceBitIdentical() {
        if (!FastMath.hasEx2Table()) {
            return;
        }
        FixtureLoader f = FixtureLoader.open("tiny_multi");
        Tensor<float64> yT      = f.y();
        Tensor<float64> devGrad = f.deviceGrad();   // [rows, n, K]
        Tensor<float64> devHess = f.deviceHess();
        Tensor<float64> margins = f.margins();      // [rows, n, K]
        int64 n = yT.shapeAt(0);
        int64 K = (int64) 4;
        int64 rows = devGrad.shapeAt(0);

        float64[] label = heap float64[n];
        int64 i = (int64) 0;
        while (i < n) { label[i] = yT.flatGet(i); i = i + (int64) 1; }

        float32[] margin = heap float32[n * K];
        float64[] grad = heap float64[n * K];
        float64[] hess = heap float64[n * K];

        int64 r = (int64) 0;
        while (r < rows) {
            int64 base = r * n * K;
            int64 t = (int64) 0;
            while (t < n * K) {
                margin[t] = (float32) margins.flatGet(base + t);
                t = t + (int64) 1;
            }
            Softmax.gradHess(margin, label, n, K, grad, hess);
            t = (int64) 0;
            while (t < n * K) {
                Assert.thatFloat(grad[t]).isEqualTo(devGrad.flatGet(base + t));
                Assert.thatFloat(hess[t]).isEqualTo(devHess.flatGet(base + t));
                t = t + (int64) 1;
            }
            r = r + (int64) 1;
        }
        return;
    }
}
