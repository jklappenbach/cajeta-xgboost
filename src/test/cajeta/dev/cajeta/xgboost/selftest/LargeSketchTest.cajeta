package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.sketch.Sketch;

/**
 * U10.2.2 / spec §7.2 at scale — cajeta's pruned GK sketch vs the NVIDIA GPU reference
 * for `large_reg` (20k×50, every feature continuous → pruned to 256 bins).
 *
 * HISTORY: the first port ran the CPU `WQSummary::SetPrune` over a distinct
 * summary and drifted on ~83% of interior picks (structure + endpoints exact).
 * gpu-numeric-fidelity U3 established the device NEVER runs SetPrune: it prunes
 * RAW per-row entries via `PruneImpl` + `BinarySearchQuery` (independent float32
 * rank target per output, verbatim entry picks), collapses duplicates after
 * (`ScanInput`), prunes again in `MakeCuts`, then `Unique` + `FixError`.
 * `Sketch.cuts` now models that pipeline; `largeRegInteriorCutsBitIdentical`
 * asserts every interior cut to the bit (plan 3.1.1).
 */
public class LargeSketchTest {

    public LargeSketchTest() { return; }

    static boolean isNaN(float32 v) {
        return (Cajeta.f32ToBits(v) & (int32) 0x7FFFFFFF) > (int32) 0x7F800000;
    }

    @Test
    public void largeRegCutStructureAndEndpointsBitIdentical() {
        FixtureLoader f = FixtureLoader.open("large_reg");
        Tensor<float64> x     = f.x();
        Tensor<int64>   refCp = f.cutPtrs();
        Tensor<float64> refCv = f.cutValues();
        int64 n  = x.shapeAt(0);
        int64 nf = x.shapeAt(1);

        int64[] cutPtrs = heap int64[nf + (int64) 1];
        float32[] cuts = Sketch.cuts(x, n, nf, (int64) 256, cutPtrs);

        // (a) cut_ptrs bit-exact — 256 bins per continuous feature.
        int64 i = (int64) 0;
        while (i < nf + (int64) 1) {
            Assert.that(cutPtrs[i]).isEqualTo(refCp.flatGet(i));
            i = i + (int64) 1;
        }
        // (b) per-feature endpoints bit-exact (min/max sentinels) + strictly increasing.
        int64 ff = (int64) 0;
        while (ff < nf) {
            int64 a = cutPtrs[ff];
            int64 b = cutPtrs[ff + (int64) 1];
            Assert.thatFloat((float64) cuts[a]).isEqualTo(refCv.flatGet(a));                 // min sentinel
            Assert.thatFloat((float64) cuts[b - (int64) 1]).isEqualTo(refCv.flatGet(b - (int64) 1)); // max sentinel
            int64 c = a + (int64) 1;
            while (c < b) {
                Assert.isTrue(cuts[c] > cuts[c - (int64) 1]);   // strictly increasing (no NaN, ordered)
                c = c + (int64) 1;
            }
            ff = ff + (int64) 1;
        }
        return;
    }

    /** gpu-numeric-fidelity 3.1.1 — EVERY `large_reg` cut value bit-identical to
     *  the NVIDIA 3.1.2 reference, interior included. */
    @Test
    public void largeRegInteriorCutsBitIdentical() {
        FixtureLoader f = FixtureLoader.open("large_reg");
        Tensor<float64> x     = f.x();
        Tensor<int64>   refCp = f.cutPtrs();
        Tensor<float64> refCv = f.cutValues();
        int64 n  = x.shapeAt(0);
        int64 nf = x.shapeAt(1);

        int64[] cutPtrs = heap int64[nf + (int64) 1];
        float32[] cuts = Sketch.cuts(x, n, nf, (int64) 256, cutPtrs);

        int64 total = cutPtrs[nf];
        Assert.that(total).isEqualTo(refCp.flatGet(nf));
        int64 i = (int64) 0;
        while (i < total) {
            Assert.thatFloat((float64) cuts[i]).isEqualTo(refCv.flatGet(i));
            i = i + (int64) 1;
        }
        return;
    }
}
