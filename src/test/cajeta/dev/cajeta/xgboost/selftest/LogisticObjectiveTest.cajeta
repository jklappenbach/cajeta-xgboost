package dev.cajeta.xgboost.selftest;

import dev.cajeta.xgboost.fastmath.FastMath;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.objective.Logistic;

/**
 * U6.1.1 — `binary:logistic` grad/hess vs the per-round reference dump
 * (`grad.npy`/`hess.npy`, `tiny_binary`). `grad = sigmoid(margin) − y`,
 * `hess = max(p(1−p), 1e-16)`, all float32.
 *
 * Round 0's margin is the base `logit(0.5)=0`, where `sigmoid(0)=0.5` **exactly**
 * (no `expf`), so round 0 is bit-identical — validating the grad/hess formula, the
 * base margin, and the hess floor. Rounds 1+ evaluate `sigmoid` at nonzero margins
 * and hit the `expf` transcendental: cajeta's libm `expf` differs from the
 * reference `expf` by ~1 ULP on some rows (`multiRoundGradHessBitIdentical`,
 * `@Disabled`). Bit-exact `expf` is the same class of GPU-transcendental fidelity
 * as `__fdividef` (U4.4) — probe + model, deferred.
 */
public class LogisticObjectiveTest {

    public LogisticObjectiveTest() { return; }

    @Test
    public void roundZeroGradHessBitIdentical() {
        FixtureLoader f = FixtureLoader.open("tiny_binary");
        Tensor<float64> yT      = f.y();
        Tensor<float64> refGrad = f.grad();
        Tensor<float64> refHess = f.hess();
        int64 n = yT.shapeAt(0);

        float32 base = Logistic.baseMargin((float64) 0.5);   // 0
        int64 i = (int64) 0;
        while (i < n) {
            float64 g = Logistic.grad(base, yT.flatGet(i));
            float64 he = Logistic.hess(base, yT.flatGet(i));
            Assert.thatFloat(g).isEqualTo(refGrad.flatGet(i));
            Assert.thatFloat(he).isEqualTo(refHess.flatGet(i));
            i = i + (int64) 1;
        }
        return;
    }

    /**
     * UN-GATED 2026-07-29 against REAL device ground truth. The original
     * fixture (grad.npy rounds >= 1) was a numpy reconstruction and matched no
     * device-faithful model; device_grad/device_hess.npy were captured on
     * PHOENIX (RTX 4090, tools/gpuprobe/probe_device_grads.cu — verbatim 3.1.2
     * objective kernels) and this asserts bit-identity against THOSE, keyed by
     * input margin row. Validated 1500/1500 exact at capture time. Requires
     * the probed ex2 table (device expf); self-skips without it, like every
     * capture-gated bit-exactness assertion.
     */
    @Test
    public void multiRoundGradHessBitIdentical() {
        if (!FastMath.hasEx2Table()) {
            return;
        }
        FixtureLoader f = FixtureLoader.open("tiny_binary");
        Tensor<float64> yT      = f.y();
        Tensor<float64> devGrad = f.deviceGrad();
        Tensor<float64> devHess = f.deviceHess();
        Tensor<float64> margins = f.margins();
        int64 n = yT.shapeAt(0);
        int64 rows = devGrad.shapeAt(0);

        int64 r = (int64) 0;
        while (r < rows) {
            int64 rn = r * n;
            int64 i = (int64) 0;
            while (i < n) {
                float32 mIn = (float32) margins.flatGet(rn + i);
                Assert.thatFloat(Logistic.grad(mIn, yT.flatGet(i))).isEqualTo(devGrad.flatGet(rn + i));
                Assert.thatFloat(Logistic.hess(mIn, yT.flatGet(i))).isEqualTo(devHess.flatGet(rn + i));
                i = i + (int64) 1;
            }
            r = r + (int64) 1;
        }
        return;
    }
}
