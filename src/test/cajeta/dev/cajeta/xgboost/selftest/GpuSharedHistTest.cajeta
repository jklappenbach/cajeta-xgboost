package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import cajeta.xpu.Autotune;
import dev.cajeta.xgboost.booster.Booster;
import dev.cajeta.xgboost.booster.Model;
import dev.cajeta.xgboost.gpu.GpuHistogram;
import dev.cajeta.xgboost.gpu.GpuTrainState;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.tree.GradientQuantiser;

/** xgboost-device-training Unit 10: workgroup-shared histograms and a tuned tile. */
public class GpuSharedHistTest {

    public GpuSharedHistTest() { return; }

    // 10.1.1: the shared build is the CPU histogram for the root and each level, in one group or several.
    @Test
    public void theSharedBuildIsTheCpuHistogramOnEveryFixture() {
        GpuHistogram.forceMinSharedRows((int64) -1);
        GpuHistogram.forceTileRows((int64) 1024);
        Assert.isTrue(GpuLevelTest.compareLevels("tiny_reg", (int64) 2) >= (int64) 1);
        Assert.isTrue(GpuLevelTest.compareLevels("tiny_reg_missing", (int64) 2) >= (int64) 1);
        Assert.isTrue(GpuLevelTest.compareLevels("large_reg", (int64) 8) >= (int64) 1);
        GeneratedSet s #= GeneratedSet.of((int64) 20000, (int64) 50);
        Assert.isTrue(GpuLevelTest.compareLevelsOn(s.bins, s.cutPtrs, s.cutValues, s.g, s.h, (int64) 8) >= (int64) 2);
        GpuHistogram.forceTileRows((int64) 0);
        return;
    }

    // 10.1.2: every tile candidate gives the CPU histogram.
    @Test
    public void everyTileCandidateGivesTheSameHistogram() {
        GpuHistogram.forceMinSharedRows((int64) -1);
        int64[] cands #= GpuHistogram.tileCandidates();
        int64 i = (int64) 0;
        while (i < (int64) cands.count()) {
            GpuHistogram.forceTileRows(cands[i]);
            GpuLevelTest.compareLevels("large_reg", (int64) 8);
            i = i + (int64) 1;
        }
        GpuHistogram.forceTileRows((int64) 0);
        return;
    }

    // 10.1.2: the tuned tile is remembered, so a second fit's state does not time again.
    @Test
    public void theTunedTileIsRemembered() {
        GpuHistogram.forceMinSharedRows((int64) -1);
        GpuHistogram.forceTileRows((int64) 0);
        FixtureLoader f #= FixtureLoader.open("large_reg");
        float64[] g #= f.gradRound((int32) 0);
        float64[] h #= f.hessRound((int32) 0);
        int64 n = (int64) g.count();
        GradientQuantiser q #= GradientQuantiser.build(g, h, n);
        GpuTrainState a #= GpuTrainState.create(f.bins(), f.cutPtrs(), n);
        String name #= a.tileTuneName();
        Autotune.invalidate(GpuTrainState.tuneDir, name);
        int64 t0 = GpuHistogram.tunings();
        a.beginTree(q, g, h, (int64) 8);
        a.buildSlot((int64) 0);
        Assert.equals((int64) 1, GpuHistogram.tunings() - t0);
        GpuTrainState b #= GpuTrainState.create(f.bins(), f.cutPtrs(), n);
        b.beginTree(q, g, h, (int64) 8);
        b.buildSlot((int64) 0);
        Assert.equals((int64) 1, GpuHistogram.tunings() - t0);
        Assert.equals(a.tileRows(), b.tileRows());
        Assert.isTrue(a.tileRows() > (int64) 0);
        return;
    }

    /** A depth-6 device fit of large_reg's labels over three rounds. */
    static #Model fitLargeReg(FixtureLoader f, float64[] label, int64 n) {
        GpuTrainState st #= GpuTrainState.create(f.bins(), f.cutPtrs(), n);
        return Booster.train(null, f.cutPtrs(), f.cutValues(), label,
                             n, (int64) 3, (int64) 6, (int64) 0,
                             (float64) 1.0, (float64) 0.0, (float64) 0.0,
                             (float64) 1.0, (float64) 0.3, (float64) 0.5,
                             Objective.SQUARED_ERROR, (int64) 1, null, true, st);
    }

    // 10.1.2: a forced tile gives the tuned tile's model.
    @Test
    public void aForcedTileGivesTheTunedModel() {
        GpuHistogram.forceMinSharedRows((int64) -1);
        GpuHistogram.forceTileRows((int64) 0);
        FixtureLoader f #= FixtureLoader.open("large_reg");
        Tensor<float64> yT #= f.y();
        int64 n = yT.size();
        float64[] label #= ApiTest.labelOf(f, n);
        Model tuned #= GpuSharedHistTest.fitLargeReg(f, label, n);
        int64[] cands #= GpuHistogram.tileCandidates();
        GpuHistogram.forceTileRows(cands[cands.count() - 1]);
        Model forced #= GpuSharedHistTest.fitLargeReg(f, label, n);
        GpuHistogram.forceTileRows((int64) 0);
        GrowDeviceTest.assertSameModel(tuned, forced, (int64) 3, n);
        return;
    }

    // 10.1.3: a feature with more bins than a group holds falls back to the global build, and matches.
    @Test
    public void anOversizedFeatureFallsBackToTheGlobalBuild() {
        GpuHistogram.forceMinSharedRows((int64) -1);
        int64 n = (int64) 20000;
        int64 nf = (int64) 2;
        int64 wide = GpuHistogram.groupBins() + (int64) 100;
        int32[] bA = heap int32[n * nf];
        float64[] g = heap float64[n];
        float64[] h = heap float64[n];
        int64 r = (int64) 0;
        while (r < n) {
            bA[r * nf] = (int32) ((r * (int64) 37 + r / (int64) 7) % wide);
            bA[r * nf + (int64) 1] = (int32) ((r * (int64) 11 + r / (int64) 3) % (int64) 256);
            if (r % (int64) 17 == (int64) 0) { bA[r * nf + (int64) 1] = (int32) -1; }
            g[r] = (float64) ((r * (int64) 7) % (int64) 13) - (float64) 6.0;
            h[r] = (float64) 1.0;
            r = r + (int64) 1;
        }
        int64[] bShape = heap int64[2];
        bShape[0] = n;
        bShape[1] = nf;
        Tensor<int32> bins #= Tensor.of<int32>(bA, bShape);
        int64[] cpA = heap int64[3];
        cpA[1] = wide;
        cpA[2] = wide + (int64) 256;
        int64[] cpShape = heap int64[1];
        cpShape[0] = (int64) 3;
        Tensor<int64> cp #= Tensor.of<int64>(cpA, cpShape);
        float64[] cvA = heap float64[cpA[2]];
        int64 c = (int64) 0;
        while (c < cpA[2]) { cvA[c] = (float64) c; c = c + (int64) 1; }
        int64[] cvShape = heap int64[1];
        cvShape[0] = cpA[2];
        Tensor<float64> cv #= Tensor.of<float64>(cvA, cvShape);
        Assert.equals((int64) 0, GpuLevelTest.compareLevelsOn(bins, cp, cv, g, h, (int64) 2));
        return;
    }

    // 11.1.1: a fit that chooses the global build is the CPU histogram, and gives the shared fit's model.
    @Test
    public void theGlobalChoiceGivesTheSharedModel() {
        GpuHistogram.forceMinSharedRows((int64) -1);
        GpuHistogram.forceTileRows(GpuHistogram.globalBuild());
        GpuLevelTest.compareLevels("large_reg", (int64) 8);
        FixtureLoader f #= FixtureLoader.open("large_reg");
        Tensor<float64> yT #= f.y();
        int64 n = yT.size();
        float64[] label #= ApiTest.labelOf(f, n);
        GpuTrainState st #= GpuTrainState.create(f.bins(), f.cutPtrs(), n);
        Model global #= Booster.train(null, f.cutPtrs(), f.cutValues(), label,
                                     n, (int64) 3, (int64) 6, (int64) 0,
                                     (float64) 1.0, (float64) 0.0, (float64) 0.0,
                                     (float64) 1.0, (float64) 0.3, (float64) 0.5,
                                     Objective.SQUARED_ERROR, (int64) 1, null, true, st);
        Assert.isTrue(!st.buildsShared());
        Assert.isTrue(st.sharedGroups() >= (int64) 1);
        GpuHistogram.forceTileRows((int64) 1024);
        Model shared #= GpuSharedHistTest.fitLargeReg(f, label, n);
        GpuHistogram.forceTileRows((int64) 0);
        GrowDeviceTest.assertSameModel(shared, global, (int64) 3, n);
        return;
    }
}
