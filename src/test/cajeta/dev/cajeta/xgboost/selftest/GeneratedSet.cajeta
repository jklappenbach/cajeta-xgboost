package dev.cajeta.xgboost.selftest;

import cajeta.math.Tensor;
import dev.cajeta.xgboost.sketch.Binner;
import dev.cajeta.xgboost.sketch.Sketch;

/** A generated `n x nf` set binned at 256, with squared-error gradients at margin 0.5. */
public final class GeneratedSet {
    public Tensor<int32> bins;
    public Tensor<int64> cutPtrs;
    public Tensor<float64> cutValues;
    public float64[] g;
    public float64[] h;

    public GeneratedSet() { return; }

    /** PrepTiming's generated values, sketched and binned on the host, labelled `a - 0.5 b`. */
    public static #GeneratedSet of(int64 n, int64 nf) {
        GeneratedSet s = heap GeneratedSet();
        Tensor<float64> x #= PrepTiming.generated(n, nf);
        int64[] cutPtrsA = heap int64[nf + (int64) 1];
        float32[] cuts #= Sketch.cuts(x, n, nf, (int64) 256, cutPtrsA);
        int64 total = cutPtrsA[nf];
        float64[] cv = heap float64[total];
        int64 c = (int64) 0;
        while (c < total) { cv[c] = (float64) cuts[c]; c = c + (int64) 1; }
        int64[] cvShape = heap int64[1];
        cvShape[0] = total;
        int64[] cpShape = heap int64[1];
        cpShape[0] = nf + (int64) 1;
        s.cutValues #= Tensor.of<float64>(cv, cvShape);
        s.cutPtrs #= Tensor.of<int64>(cutPtrsA, cpShape);
        int32[] binsA #= Binner.bin(x, s.cutPtrs, s.cutValues, n, nf);
        int64[] bShape = heap int64[2];
        bShape[0] = n;
        bShape[1] = nf;
        s.bins #= Tensor.of<int32>(binsA, bShape);
        s.g #= heap float64[n];
        s.h #= heap float64[n];
        int64 r = (int64) 0;
        while (r < n) {
            float64 a = x.flatGet(r * nf);
            float64 b = x.flatGet(r * nf + (int64) 1);
            if (a != a) { a = (float64) 0.0; }
            if (b != b) { b = (float64) 0.0; }
            s.g[r] = (float64) 0.5 - (a - (float64) 0.5 * b);
            s.h[r] = (float64) 1.0;
            r = r + (int64) 1;
        }
        return #s;
    }
}
