package dev.cajeta.xgboost.selftest;

import cajeta.math.Tensor;
import cajeta.time.Clock;
import dev.cajeta.xgboost.sketch.Binner;
import dev.cajeta.xgboost.sketch.Sketch;

/**
 * xgboost-data-prep 1.1.1: `Sketch.cuts` and `Binner.bin` timed on large_reg
 * and on a generated 200k x 50 set, and a probe of `Tensor.flatGet` against a
 * plain array read in the binner's loop shape. Runs only with XGB_TIME_PREP
 * set, and prints medians.
 */
public class PrepTiming {

    public PrepTiming() { return; }

    /** A deterministic `[n, nf]` set from an xorshift stream, one NaN in 97 cells. */
    static #Tensor<float64> generated(int64 n, int64 nf) {
        float64[] v = heap float64[n * nf];
        uint64 s = (uint64) 88172645463325252;
        int64 i = (int64) 0;
        while (i < n * nf) {
            s = s ^ (s << (uint64) 13);
            s = s ^ (s >> (uint64) 7);
            s = s ^ (s << (uint64) 17);
            if (i % (int64) 97 == (int64) 0) {
                v[i] = Cajeta.bitsToF64((int64) 9221120237041090560);
            } else {
                v[i] = (float64) ((int64) (s >> (uint64) 40)) / (float64) 16777216.0;
            }
            i = i + (int64) 1;
        }
        int64[] shape = heap int64[2];
        shape[0] = n;
        shape[1] = nf;
        return Tensor.of<float64>(v, shape);
    }

    static void timePrep(String label, Tensor<float64> x, int64 reps) {
        int64 n = x.shapeAt(0);
        int64 nf = x.shapeAt(1);
        int64[] sk = heap int64[reps];
        int64[] bn = heap int64[reps];
        int64[] s1 = heap int64[reps];
        int64 r = (int64) 0;
        while (r < reps) {
            int64[] cutPtrsA = heap int64[nf + (int64) 1];
            int64 t0 = Clock.nanoTime();
            float32[] cuts #= Sketch.cuts(x, n, nf, (int64) 256, cutPtrsA);
            sk[r] = Clock.nanoTime() - t0;
            int64[] cutPtrsS = heap int64[nf + (int64) 1];
            int64 ts = Clock.nanoTime();
            float32[] cutsS #= Sketch.cutsWith(x, n, nf, (int64) 256, cutPtrsS, (int64) 1);
            s1[r] = Clock.nanoTime() - ts;
            int64 total = cutPtrsA[nf];
            float64[] cv = heap float64[total];
            int64 c = (int64) 0;
            while (c < total) { cv[c] = (float64) cuts[c]; c = c + (int64) 1; }
            int64[] cvShape = heap int64[1];
            cvShape[0] = total;
            Tensor<float64> cutValues #= Tensor.of<float64>(cv, cvShape);
            int64[] cpShape = heap int64[1];
            cpShape[0] = nf + (int64) 1;
            Tensor<int64> cutPtrs #= Tensor.of<int64>(cutPtrsA, cpShape);
            int64 t1 = Clock.nanoTime();
            int32[] bins #= Binner.bin(x, cutPtrs, cutValues, n, nf);
            bn[r] = Clock.nanoTime() - t1;
            r = r + (int64) 1;
        }
        System.stdout.println("prep " + label + " n " + n + " nf " + nf + ": sketch "
            + FeatureScanTiming.median(sk, reps) / (int64) 1000000 + " ms (one task "
            + FeatureScanTiming.median(s1, reps) / (int64) 1000000 + " ms, "
            + FeatureScanTiming.median(s1, reps) / (nf * (int64) 1000) + " us a column), bin "
            + FeatureScanTiming.median(bn, reps) / (int64) 1000000 + " ms, median of " + reps);
        return;
    }

    /** Reads `count` cut values the binner's way, through flatGet and through an array. */
    static void probeFlatGet(Tensor<float64> cutValues) {
        int64 m = cutValues.size();
        float64[] arr = heap float64[m];
        int64 i = (int64) 0;
        while (i < m) { arr[i] = cutValues.flatGet(i); i = i + (int64) 1; }
        int64 count = (int64) 20000000;
        float32 acc = (float32) 0.0;
        int64 t0 = Clock.nanoTime();
        i = (int64) 0;
        while (i < count) {
            acc = acc + (float32) cutValues.flatGet(i % m);
            i = i + (int64) 1;
        }
        int64 tf = Clock.nanoTime() - t0;
        float32 acc2 = (float32) 0.0;
        int64 t1 = Clock.nanoTime();
        i = (int64) 0;
        while (i < count) {
            acc2 = acc2 + (float32) arr[i % m];
            i = i + (int64) 1;
        }
        int64 ta = Clock.nanoTime() - t1;
        System.stdout.println("flatGet probe: " + (tf * (int64) 1000) / count + " ps per read through flatGet, "
            + (ta * (int64) 1000) / count + " ps per array read (sums " + acc + ", " + acc2 + ")");
        return;
    }

    @Test
    public void sketchAndBinAtTheFixtureAndGeneratedShapes() {
        if (System.env.get("XGB_TIME_PREP") == null) { return; }
        FixtureLoader f #= FixtureLoader.open("large_reg");
        Tensor<float64> x #= f.x();
        PrepTiming.probeFlatGet(f.cutValues());
        PrepTiming.timePrep("large_reg", x, (int64) 5);
        Tensor<float64> g #= PrepTiming.generated((int64) 200000, (int64) 50);
        PrepTiming.timePrep("generated", g, (int64) 3);
        return;
    }
}
