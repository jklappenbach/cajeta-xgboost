package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.booster.Booster;
import dev.cajeta.xgboost.fastmath.FastMath;
import dev.cajeta.xgboost.booster.Model;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.tree.Tree;
import dev.cajeta.xgboost.tree.TreeBuilder;

/**
 * U10.1.1 (binary at scale) — `large_binary` (20k×50, depth 6). The round-0
 * tree exercises the builder on binary gradients (`0.5 − y`, hess `0.25`,
 * expf-free) at real depth and bin occupancy. The full-model test covers
 * rounds 1+ — unblocked by gpu-numeric-fidelity U1 (`FastMath.expf`, the
 * device `MUFU.EX2` model): every tree and every per-round margin
 * bit-identical to the NVIDIA reference through the sigmoid link.
 *
 * The `large_binary` labels are exactly balanced (y = logits > median), so
 * `Σ grad = Σ(0.5 − y) = 0` exactly, and `CalcWeight = −Σgrad/(Σhess+λ)` must yield
 * `−0.0` (XGBoost's unary `-G`), not the `+0.0` of `0.0 − G`. `SplitFinder.leafWeight`
 * now uses unary negation, so the root `base_weight` signed zero matches. Like reg,
 * binary round-0 shows no split-selection near-tie divergence at scale.
 */
public class LargeBinaryTest {

    public LargeBinaryTest() { return; }

    @Test
    public void roundZeroBinaryTreeBitIdenticalAtScale() {
        FixtureLoader f = FixtureLoader.open("large_binary");
        float64[] g = f.gradRound(0);
        float64[] h = f.hessRound(0);
        int64 n = (int64) g.count();

        Tree t = TreeBuilder.growTree(f.bins(), f.cutPtrs(), f.cutValues(), g, h, n,
                                      (int64) 6, (int64) 0,
                                      (float64) 1.0, (float64) 0.0, (float64) 0.0, (float64) 1.0,
                                      (float64) 0.3);

        String diff = ParityRunner.compareTree(t, f, (int32) 0);
        Assert.that(diff).isEqualTo("");
        return;
    }

    // 10.1.1 (binary, rounds 1+) — the full 3-round binary model through the
    // sigmoid link, bit-identical per tree/node and per-round margin.
    @Test
    public void fullBinaryModelBitIdenticalAtScale() {
        // Rounds 1+ are expf-dependent: bit-exactness needs the probed
        // MUFU.EX2 capture (EX2_TABLE), absent in CI — self-skip there.
        if (!FastMath.hasEx2Table()) {
            return;
        }
        FixtureLoader f = FixtureLoader.open("large_binary");
        Tensor<float64> yT = f.y();
        int64 n = yT.shapeAt(0);
        float64[] label = heap float64[n];
        int64 i = (int64) 0;
        while (i < n) { label[i] = yT.flatGet(i); i = i + (int64) 1; }

        int64 rounds = (int64) 3;
        float32[] marginHistory = heap float32[rounds * n];
        Model m = Booster.train(f.bins(), f.cutPtrs(), f.cutValues(), label, n, rounds,
                                (int64) 6, (int64) 0,
                                (float64) 1.0, (float64) 0.0, (float64) 0.0, (float64) 1.0,
                                (float64) 0.3, (float64) 0.5, Objective.LOGISTIC, (int64) 1,
                                marginHistory);

        String treeDiff = ParityRunner.compareTrees(m, f, rounds);
        Assert.that(treeDiff).isEqualTo("");
        String marginDiff = ParityRunner.compareMargins(marginHistory, f.margins(), rounds, n);
        Assert.that(marginDiff).isEqualTo("");
        return;
    }
}
