package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.tree.Tree;
import dev.cajeta.xgboost.tree.TreeBuilder;

/**
 * U10.1.1 (binary at scale) — the round-0 binary tree for `large_binary` (20k×50,
 * depth 6). Round-0 gradients (`0.5 − y`, hess `0.25`) are expf-free, so the tree is
 * bit-exact independent of the U12 `expf` link; full-model binary parity (rounds 1+)
 * stays U12-gated. This exercises the builder on binary gradients at real depth and
 * bin occupancy — bit-exact at scale (all nodes, splits included).
 *
 * The `large_binary` labels are exactly balanced (y = logits > median), so
 * `Σ grad = Σ(0.5 − y) = 0` exactly, and `CalcWeight = −Σgrad/(Σhess+λ)` must yield
 * `−0.0` (XGBoost's unary `-G`), not the `+0.0` of `0.0 − G`. `SplitFinder.leafWeight`
 * now uses unary negation, so the root `base_weight` signed zero matches. Like reg,
 * binary round-0 shows no split-selection near-tie divergence at scale.
 */
public class LargeBinaryTest {

    public LargeBinaryTest() { return; }

    @Test
    public void roundZeroBinaryTreeBitIdenticalAtScale() {
        FixtureLoader f = FixtureLoader.open("large_binary");
        float64[] g = f.gradRound(0);
        float64[] h = f.hessRound(0);
        int64 n = (int64) g.count();

        Tree t = TreeBuilder.growTree(f.bins(), f.cutPtrs(), f.cutValues(), g, h, n,
                                      (int64) 6, (int64) 0,
                                      (float64) 1.0, (float64) 0.0, (float64) 0.0, (float64) 1.0,
                                      (float64) 0.3);

        String diff = ParityRunner.compareTree(t, f, (int32) 0);
        Assert.that(diff).isEqualTo("");
        return;
    }
}
