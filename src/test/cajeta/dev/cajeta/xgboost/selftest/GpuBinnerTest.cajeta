package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import cajeta.math.npio.Npy;
import dev.cajeta.xgboost.api.GBDT;
import dev.cajeta.xgboost.api.Params;
import dev.cajeta.xgboost.booster.Model;
import dev.cajeta.xgboost.gpu.GpuTrainState;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.sketch.Binner;
import dev.cajeta.xgboost.sketch.Sketch;

/**
 * xgboost-data-prep 4.1: the device bin matrix equals `Binner.bin`'s cell for
 * cell, and a device fit uploads the raw values once and no bin matrix.
 */
public class GpuBinnerTest {

    public GpuBinnerTest() { return; }

    static void assertDeviceBins(String label, Tensor<float64> x, Tensor<int64> cp, Tensor<float64> cv) {
        int64 n = x.shapeAt(0);
        int64 nf = x.shapeAt(1);
        int64 total = cp.flatGet(nf);
        float32[] cuts = heap float32[total];
        int64 c = (int64) 0;
        while (c < total) { cuts[c] = (float32) cv.flatGet(c); c = c + (int64) 1; }
        int32[] want #= Binner.bin(x, cp, cv, n, nf);
        GpuTrainState st #= GpuTrainState.fromValues(x, cp, cuts, n);
        int32[] got #= st.deviceBins();
        int64 i = (int64) 0;
        while (i < n * nf) {
            if (got[i] != want[i]) {
                Assert.fail(label + ": cell " + i + " bins to " + got[i] + " on the device, " + want[i] + " on the host");
            }
            i = i + (int64) 1;
        }
        return;
    }

    static void checkFixture(String fixture) {
        FixtureLoader f #= FixtureLoader.open(fixture);
        Tensor<float64> x #= f.x();
        Tensor<int64> cp #= f.cutPtrs();
        Tensor<float64> cv #= f.cutValues();
        GpuBinnerTest.assertDeviceBins(fixture, x, cp, cv);
        return;
    }

    @Test
    public void deviceBinsEqualTheHostBinnerOnTheFixtures() {
        GpuBinnerTest.checkFixture("tiny_reg");
        GpuBinnerTest.checkFixture("tiny_reg_missing");
        GpuBinnerTest.checkFixture("tiny_multi");
        GpuBinnerTest.checkFixture("large_reg");
        GpuBinnerTest.checkFixture("covertype");
        FixtureLoader z #= FixtureLoader.open("zeros");
        Tensor<float64> zx #= z.x();
        Tensor<int64> zcp #= Npy.loadI64(z.path("cut_ptrs_16.npy"));
        Tensor<float64> zcv #= Npy.loadF64(z.path("cut_values_16.npy"));
        GpuBinnerTest.assertDeviceBins("zeros", zx, zcp, zcv);
        return;
    }

    @Test
    public void deviceBinsEqualTheHostBinnerOnTheGeneratedSet() {
        Tensor<float64> g #= PrepTiming.generated((int64) 200000, (int64) 50);
        int64 nf = (int64) 50;
        int64[] cpA = heap int64[nf + (int64) 1];
        float32[] cuts #= Sketch.cuts(g, (int64) 200000, nf, (int64) 256, cpA);
        int64 total = cpA[nf];
        float64[] cvA = heap float64[total];
        int64 c = (int64) 0;
        while (c < total) { cvA[c] = (float64) cuts[c]; c = c + (int64) 1; }
        int64[] cvShape = heap int64[1]; cvShape[0] = total;
        int64[] cpShape = heap int64[1]; cpShape[0] = nf + (int64) 1;
        Tensor<float64> cv #= Tensor.of<float64>(cvA, cvShape);
        Tensor<int64> cp #= Tensor.of<int64>(cpA, cpShape);
        GpuBinnerTest.assertDeviceBins("generated", g, cp, cv);
        return;
    }

    @Test
    public void deviceBinsEqualTheHostBinnerOnTheEdges() {
        // Feature 0 has one cut, feature 1 four (one of them -0), feature 2 five.
        int64 nf = (int64) 3;
        float64[] cutsA = heap float64[10];
        cutsA[0] = (float64) 0.5;
        cutsA[1] = (float64) -1.0; cutsA[2] = (float64) -0.0; cutsA[3] = (float64) 1e-40; cutsA[4] = (float64) 1.0;
        cutsA[5] = (float64) 0.1; cutsA[6] = (float64) 0.2; cutsA[7] = (float64) 0.3;
        cutsA[8] = (float64) 0.4; cutsA[9] = (float64) 0.5;
        int64[] ptrA = heap int64[4];
        ptrA[0] = (int64) 0; ptrA[1] = (int64) 1; ptrA[2] = (int64) 5; ptrA[3] = (int64) 10;
        int64[] cvShape = heap int64[1]; cvShape[0] = (int64) 10;
        int64[] cpShape = heap int64[1]; cpShape[0] = (int64) 4;
        Tensor<float64> cv #= Tensor.of<float64>(cutsA, cvShape);
        Tensor<int64> cp #= Tensor.of<int64>(ptrA, cpShape);

        int64 n = (int64) 17;
        float64[] probes = heap float64[17];
        probes[0] = (float64) -5.0;   probes[1] = (float64) -1.0;  probes[2] = (float64) -0.5;
        probes[3] = (float64) 0.0;    probes[4] = (float64) 0.1;   probes[5] = (float64) 0.25;
        probes[6] = (float64) 0.5;    probes[7] = (float64) 0.5000001;
        probes[8] = (float64) 1.0;    probes[9] = (float64) 9.0;
        probes[10] = Cajeta.bitsToF64((int64) 9221120237041090560);
        probes[11] = (float64) 0.30000001;
        probes[12] = (float64) -0.0;
        probes[13] = (float64) 1e-40;
        probes[14] = (float64) -1e-40;
        probes[15] = Cajeta.bitsToF64((int64) 9218868437227405312);
        probes[16] = Cajeta.bitsToF64((int64) -4503599627370496);
        float64[] xs = heap float64[n * nf];
        int64 r = (int64) 0;
        while (r < n) {
            int64 f = (int64) 0;
            while (f < nf) {
                xs[r * nf + f] = probes[(r + f) % n];
                f = f + (int64) 1;
            }
            r = r + (int64) 1;
        }
        int64[] xShape = heap int64[2]; xShape[0] = n; xShape[1] = nf;
        Tensor<float64> x #= Tensor.of<float64>(xs, xShape);
        GpuBinnerTest.assertDeviceBins("edges", x, cp, cv);
        return;
    }

    @Test
    public void deviceFitUploadsTheValuesOnceAndNoBinMatrix() {
        FixtureLoader f #= FixtureLoader.open("tiny_reg_missing");
        Tensor<float64> x #= f.x();
        int64 n = x.shapeAt(0);
        int64 nf = x.shapeAt(1);
        float64[] label #= ApiTest.labelOf(f, n);
        Params p #= ApiTest.tinyRegParams();
        Model cpu #= GBDT.fit(x, label, n, nf, p);
        p.device = "gpu";
        int64 bins0 = GpuTrainState.binUploads;
        int64 vals0 = GpuTrainState.valueUploads;
        int64 gp0 = GpuTrainState.gpairUploads;
        Model gpu #= GBDT.fit(x, label, n, nf, p);
        Assert.equals(GpuTrainState.binUploads - bins0, (int64) 0);
        Assert.equals(GpuTrainState.valueUploads - vals0, (int64) 1);
        Assert.equals(GpuTrainState.gpairUploads - gp0, p.rounds);
        GrowDeviceTest.assertSameModel(cpu, gpu, p.rounds, n);
        return;
    }
}
