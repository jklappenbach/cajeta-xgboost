package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.tree.Tree;
import dev.cajeta.xgboost.tree.TreeBuilder;

/**
 * U4.1.2 / 4.3.1 — a single tree bit-identical to the NVIDIA reference across
 * varied regularization configs (depth, γ, min_child_weight). Each test grows
 * one `tiny_reg`-variant fixture (`tiny_reg_d2/d6/mcw10/gamma1`, CUDA xgboost
 * 3.1.2) with the matching config and asserts every node — topology, split
 * feature, float32 threshold, default direction, and base_weight. The local,
 * reference-free half of 4.1.2 (that the stopping rules bite) is covered by
 * {@link ConfigStoppingTest}.
 */
public class ConfigParityTest {

    public ConfigParityTest() { return; }

    static void assertTreeMatches(String fixture, int64 maxDepth,
                                  float64 gamma, float64 minChildWeight) {
        FixtureLoader f = FixtureLoader.open(fixture);
        float64[] g = f.gradRound(0);
        float64[] h = f.hessRound(0);
        int64 n = (int64) g.count();

        Tree t = TreeBuilder.growTree(f.bins(), f.cutPtrs(), f.cutValues(), g, h, n,
                                      maxDepth, (int64) 0,
                                      (float64) 1.0, (float64) 0.0, gamma, minChildWeight,
                                      (float64) 0.3);

        Tensor<int32>   rLC = f.treeLeftChildren(0);
        Tensor<int32>   rRC = f.treeRightChildren(0);
        Tensor<int32>   rSI = f.treeSplitIndices(0);
        Tensor<float32> rSC = f.treeSplitConditions(0);
        Tensor<int32>   rDL = f.treeDefaultLeft(0);
        Tensor<float32> rBW = f.treeBaseWeights(0);

        int64 refCount = rBW.shapeAt(0);
        Assert.that(t.nodeCount).isEqualTo(refCount);

        int64 nid = (int64) 0;
        while (nid < refCount) {
            Assert.that(t.leftChildren[nid]).isEqualTo((int64) rLC.flatGet(nid));
            Assert.that(t.rightChildren[nid]).isEqualTo((int64) rRC.flatGet(nid));
            boolean refLeaf = rLC.flatGet(nid) == (int32) -1;
            if (!refLeaf) {
                Assert.that(t.splitIndices[nid]).isEqualTo((int64) rSI.flatGet(nid));
                Assert.thatFloat((float64) t.splitConditions[nid]).isEqualTo((float64) rSC.flatGet(nid));
                boolean refLeft = rDL.flatGet(nid) == (int32) 1;
                Assert.isTrue(t.defaultLeft[nid] == refLeft);
            }
            Assert.thatFloat((float64) t.baseWeights[nid]).isEqualTo((float64) rBW.flatGet(nid));
            nid = nid + (int64) 1;
        }
    }

    @Test
    public void shallowDepthTreeBitIdentical() {
        ConfigParityTest.assertTreeMatches("tiny_reg_d2", (int64) 2, (float64) 0.0, (float64) 1.0);
    }

    @Test
    public void deepDepthTreeBitIdentical() {
        ConfigParityTest.assertTreeMatches("tiny_reg_d6", (int64) 6, (float64) 0.0, (float64) 1.0);
    }

    // RE-ENABLED (gpu-numeric-fidelity 2.1.1) — node 14 was the TILE-GRID
    // ANCHOR: the fixture's exported bin space is the device's shifted by one
    // (min-sentinel cut + 1-based bins), so the device's 32-boundary tiles land
    // at b0+1+32k in port coordinates, not b0+32k. With the corrected anchor,
    // feature 1's 96.706 candidates share a tile with an mcw-invalid 97.98
    // winner — the tile dies at the gate (instrumented-3.1.2 silicon replay,
    // 2026-07-30) and feature 4's 96.521 wins, exactly as recorded.
    @Test
    public void minChildWeightTreeBitIdentical() {
        ConfigParityTest.assertTreeMatches("tiny_reg_mcw10", (int64) 4, (float64) 0.0, (float64) 10.0);
    }

    @Test
    public void gammaTreeBitIdentical() {
        ConfigParityTest.assertTreeMatches("tiny_reg_gamma1", (int64) 4, (float64) 1.0, (float64) 1.0);
    }
}
