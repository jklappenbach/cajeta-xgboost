package dev.cajeta.xgboost.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.xgboost.predict.Importance;

/**
 * U8.1.3 — feature importance matches the reference `get_score` (`tiny_reg`).
 * Accumulates weight / total_gain / total_cover over every split node of the
 * reference trees and asserts each per-feature total matches XGBoost's
 * `get_score(importance_type=…)` (dumped from the model in `importance_*.npy`) at
 * float32 — importance is a float32-precision quantity, and cajeta's exact float64
 * sum rounds to the same float32 as `get_score`'s (which carries a float64 tail from
 * its own accumulation quirk).
 */
public class ImportanceTest {

    public ImportanceTest() { return; }

    @Test
    public void totalsMatchReferenceGetScore() {
        FixtureLoader f = FixtureLoader.open("tiny_reg");
        int64 nf = f.cutPtrs().shapeAt(0) - (int64) 1;
        int64 numTrees = (int64) 3;

        float64[] weight = heap float64[nf];
        float64[] gain = heap float64[nf];
        float64[] cover = heap float64[nf];
        int64 i = (int64) 0;
        while (i < nf) { weight[i] = (float64) 0.0; gain[i] = (float64) 0.0; cover[i] = (float64) 0.0; i = i + (int64) 1; }

        int64 t = (int64) 0;
        while (t < numTrees) {
            int64 cnt = f.treeBaseWeights((int32) t).shapeAt(0);
            Importance.addTree(f.treeLeftChildren((int32) t), f.treeSplitIndices((int32) t),
                               f.treeLossChanges((int32) t), f.treeSumHessian((int32) t),
                               cnt, weight, gain, cover);
            t = t + (int64) 1;
        }

        Tensor<float32> rW = f.importance("weight");
        Tensor<float32> rG = f.importance("total_gain");
        Tensor<float32> rC = f.importance("total_cover");
        int64 fdx = (int64) 0;
        while (fdx < nf) {
            Assert.thatFloat((float64) (float32) weight[fdx]).isEqualTo((float64) rW.flatGet(fdx));
            Assert.thatFloat((float64) (float32) gain[fdx]).isEqualTo((float64) rG.flatGet(fdx));
            Assert.thatFloat((float64) (float32) cover[fdx]).isEqualTo((float64) rC.flatGet(fdx));
            fdx = fdx + (int64) 1;
        }
        return;
    }
}
