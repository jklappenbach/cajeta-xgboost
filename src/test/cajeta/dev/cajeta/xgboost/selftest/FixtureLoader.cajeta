package dev.cajeta.xgboost.selftest;

import cajeta.math.Tensor;
import cajeta.math.npio.Npy;
import cajeta.error.RecoverableException;

/**
 * Loads a golden parity fixture (`tools/fixtures/<name>/`) into typed cajeta
 * tensors via `Npy` (plan U2.1.1). The fixture directory is located through the
 * `XGBOOST_FIXTURES` env var (set by `run-tests.sh`). Each accessor decodes the
 * `.npy` the harness wrote (see `tools/fixtures/README.md`):
 *   X/y/grad/hess/margins/preds/cut_values = float64, bins = int32,
 *   cut_ptrs = int64.
 */
public final class FixtureLoader {
    String dir;

    FixtureLoader(#String dir) { this.dir #= dir; }

    /** Open the fixture directory named `name` under `$XGBOOST_FIXTURES`. */
    public static #FixtureLoader open(String name) {
        String root = System.env.get("XGBOOST_FIXTURES");
        if (root == null) {
            throw heap RecoverableException(
                "XGBOOST_FIXTURES not set — run the suite via run-tests.sh");
        }
        return heap FixtureLoader(root + "/" + name);
    }

    #String path(String file) { return this.dir + "/" + file; }

    public #Tensor<float64> x()         { return Npy.loadF64(this.path("X.npy")); }
    public #Tensor<float64> y()         { return Npy.loadF64(this.path("y.npy")); }
    public #Tensor<float64> grad()      { return Npy.loadF64(this.path("grad.npy")); }
    public #Tensor<float64> hess()      { return Npy.loadF64(this.path("hess.npy")); }
    public #Tensor<float64> margins()   { return Npy.loadF64(this.path("margins.npy")); }
    /** REAL device grad/hess, captured on PHOENIX (RTX 4090) by
     *  tools/gpuprobe/probe_device_grads.cu — keyed by INPUT margin row
     *  (row r = grads the device computes FROM margins[r]), unlike grad.npy
     *  whose rounds >= 1 are a numpy reconstruction. */
    public #Tensor<float64> deviceGrad() { return Npy.loadF64(this.path("device_grad.npy")); }
    public #Tensor<float64> deviceHess() { return Npy.loadF64(this.path("device_hess.npy")); }
    public #Tensor<float64> preds()     { return Npy.loadF64(this.path("preds.npy")); }
    public #Tensor<int32>   bins()      { return Npy.loadI32(this.path("bins.npy")); }
    public #Tensor<int64>   cutPtrs()   { return Npy.loadI64(this.path("cut_ptrs.npy")); }
    public #Tensor<float64> cutValues() { return Npy.loadF64(this.path("cut_values.npy")); }

    /** Round `r`'s per-instance gradient as a dense float64[] (grad is [rounds, n]). */
    public #float64[] gradRound(int32 r) { return this.round(this.grad(), r); }
    public #float64[] hessRound(int32 r) { return this.round(this.hess(), r); }

    #float64[] round(Tensor<float64> t, int32 r) {
        int64 n = t.shapeAt(1);
        int64 base = (int64) r * n;
        float64[] out = heap float64[n];
        int64 i = (int64) 0;
        while (i < n) { out[i] = t.flatGet(base + i); i = i + 1; }
        return #out;
    }

    // --- reference tree arrays (extract_trees.py -> trees/t<idx>_<field>.npy) ---
    #String treePath(int32 idx, String field) {
        String s = stack Int64((int64) idx).toString();
        return this.path("trees/t" + s + "_" + field + ".npy");
    }
    public #Tensor<float32> treeBaseWeights(int32 i)     { return Npy.loadF32(this.treePath(i, "base_weights")); }
    public #Tensor<float32> treeSplitConditions(int32 i) { return Npy.loadF32(this.treePath(i, "split_conditions")); }
    public #Tensor<int32>   treeSplitIndices(int32 i)    { return Npy.loadI32(this.treePath(i, "split_indices")); }
    public #Tensor<int32>   treeDefaultLeft(int32 i)     { return Npy.loadI32(this.treePath(i, "default_left")); }
    public #Tensor<int32>   treeLeftChildren(int32 i)    { return Npy.loadI32(this.treePath(i, "left_children")); }
    public #Tensor<int32>   treeRightChildren(int32 i)   { return Npy.loadI32(this.treePath(i, "right_children")); }
    public #Tensor<float64> treeSumHessian(int32 i)      { return Npy.loadF64(this.treePath(i, "sum_hessian")); }
    public #Tensor<float32> treeLossChanges(int32 i)     { return Npy.loadF32(this.treePath(i, "loss_changes")); }

    /** Reference feature importance (`get_score`, float32), `type` = weight|total_gain|total_cover. */
    public #Tensor<float32> importance(String type) { return Npy.loadF32(this.path("importance_" + type + ".npy")); }
}
