package dev.cajeta.xgboost.objective;

import dev.cajeta.xgboost.fastmath.FastMath;

/**
 * `binary:logistic` objective (spec §3.2). All arithmetic is float32 to match
 * XGBoost's `GradientPair` / `common::Sigmoid` (`bst_float`, `1/(1+expf(-x))`):
 *
 *   p    = sigmoid(margin) = 1 / (1 + expf(−margin))
 *   grad = p − label
 *   hess = max(p·(1−p), eps),   eps = 1e-16f  (XGBoost's kRtEps for logistic hess)
 *
 * The link is the logistic sigmoid, so the base margin is `logit(base_score)` and
 * the final prediction is `sigmoid(accumulated margin)` (a probability).
 *
 * Fidelity note (gpu-numeric-fidelity U1.2.4): the reference trees were built
 * with XGBoost's device `expf`, and this now reproduces it exactly —
 * {@link dev.cajeta.xgboost.fastmath.FastMath#expf} is the bit-exact device
 * model (SFU `ex2.approx` on a reduced argument) when the probed table is
 * loaded, correctly-rounded otherwise. The whole reference op order is
 * mirrored: `x = min(-m, 88.7f)` (the overflow clamp — which also keeps the
 * argument inside the model's bit-exact domain), then
 * `denom = expf(x) + 1.0f + 1e-16f` in float32 left-to-right, then an IEEE
 * float32 divide. See xgboost `src/common/math.h::Sigmoid(float)`.
 */
public final class Logistic {

    static float32 eps() { return (float32) 0.0000000000000001; }   // 1e-16f

    static float32 kEps() { return (float32) 0.0000000000000001; }  // 1e-16f

    /** Reference `Sigmoid(float)` verbatim: clamp, device `expf`, `+kEps`, divide. */
    public static float32 sigmoid(float32 m) {
        float32 x = - m;
        if (x > (float32) 88.7) {
            x = (float32) 88.7;                    // avoid exp overflow (reference)
        }
        float32 denom = FastMath.expf(x) + (float32) 1.0 + Logistic.kEps();
        return (float32) 1.0 / denom;
    }

    /** First-order gradient for one row: `sigmoid(margin) − label`, as float64. */
    public static float64 grad(float32 margin, float64 label) {
        float32 p = Logistic.sigmoid(margin);
        return (float64) (p - (float32) label);
    }

    /** Second-order gradient: `max(p·(1−p), eps)`, as float64. */
    public static float64 hess(float32 margin, float64 label) {
        float32 p = Logistic.sigmoid(margin);
        float32 hp = p * ((float32) 1.0 - p);
        float32 h = hp < Logistic.eps() ? Logistic.eps() : hp;
        return (float64) h;
    }

    /** Base margin from `base_score` (probability → logit link). */
    public static float32 baseMargin(float64 baseScore) {
        return (float32) Math.log(baseScore / ((float64) 1.0 - baseScore));
    }

    /** Fill per-row grad/hess for all `n` rows from the current float32 margins. */
    public static void gradHess(float32[] margin, float64[] label, int64 n,
                                float64[] grad, float64[] hess) {
        int64 i = (int64) 0;
        while (i < n) {
            grad[i] = Logistic.grad(margin[i], label[i]);
            hess[i] = Logistic.hess(margin[i], label[i]);
            i = i + (int64) 1;
        }
    }
}
