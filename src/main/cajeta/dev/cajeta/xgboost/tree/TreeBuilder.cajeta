package dev.cajeta.xgboost.tree;

import cajeta.math.Tensor;
import cajeta.math.npio.Npy;

/**
 * Grows one regression tree over binned data, reproducing XGBoost's GPU `hist`
 * builder bit-for-bit (spec §4). Nodes are numbered in expansion order and
 * processed from a FIFO queue: since children are enqueued in split order, FIFO
 * processing of sequentially-numbered nodes is exactly depthwise, ascending-nid
 * expansion — matching the reference model's node numbering (`driver.h`
 * `DepthWise`, `updater_gpu_hist.cu` `ApplySplit`).
 *
 * Row membership is tracked with a `position[]` array (`position[r]` = the node
 * row `r` currently reaches); a node's histogram is built over the rows with
 * `position[r] == nid`, and a split repartitions those rows to the two children.
 *
 * A node splits iff its best split (from {@link SplitFinder}, already gated by
 * `min_child_weight`) has `loss_chg = childGain − parentGain > kRtEps`, both
 * children's quantised hessian ≠ 0, `loss_chg ≥ min_split_loss (γ)`, and
 * `depth < max_depth` (`expand_entry.cuh` `IsValid`). Otherwise it is a leaf.
 * Present rows go left iff `bin ≤ splitGidx`; missing rows follow the default.
 *
 * Each node's histogram is kept in a flat per-node store (`histG`/`histH`,
 * indexed by `nid*nbins + globalBin`). The root is built directly; on a split
 * the child with **fewer rows** is built directly and its sibling is derived by
 * subtraction (`parent − built`, exact in int64 fixed-point — spec §4.2,
 * {@link Histogram#subtract}). This halves the histogram work per level and is
 * bit-identical to building both children fresh.
 *
 * The grown tree is written into the caller's parallel out-param arrays (each
 * sized `capacity(maxDepth)`), indexed by node id: `si` split feature, `sc`
 * threshold / leaf value, `dl` default-left, `lc`/`rc` children (−1 for leaves),
 * `bw` `CalcWeight` per node, `leaf` leaf flag. Returns the node count.
 */
public final class TreeBuilder {

    static float32 kRtEps() { return (float32) 0.000001; }   // 1e-6f (include/xgboost/base.h)

    /** Backing-array size needed for a tree of the given `maxDepth`. */
    public static int64 capacity(int64 maxDepth) { return ((int64) 1) << (maxDepth + (int64) 1); }

    /**
     * Grow one tree and return it as a {@link Tree}. Builds into local arrays via
     * {@link #grow} (the out-param builder), then **moves** each backing array
     * into the Tree (`#si` …) so the returned object owns its storage — a plain
     * (borrowed) argument would dangle once this frame's arrays are reclaimed.
     */
    public static #Tree growTree(Tensor<int32> bins, Tensor<int64> cutPtrs, Tensor<float64> cutValues,
                                 float64[] grad, float64[] hess, int64 n,
                                 int64 maxDepth, int64 maxLeaves,
                                 float64 lambda, float64 alpha, float64 gamma, float64 minChildWeight,
                                 float64 eta) {
        int64 cap = TreeBuilder.capacity(maxDepth);
        int64[] si = heap int64[cap];
        float32[] sc = heap float32[cap];
        boolean[] dl = heap boolean[cap];
        int64[] lc = heap int64[cap];
        int64[] rc = heap int64[cap];
        float32[] bw = heap float32[cap];
        boolean[] leaf = heap boolean[cap];
        float64[] nodeStats = heap float64[cap * (int64) 2];
        int64[] leafOf = heap int64[n];   // scratch (row → leaf nid); discarded here
        int64 nodeCount = TreeBuilder.grow(bins, cutPtrs, cutValues, grad, hess, n,
                                           maxDepth, maxLeaves, lambda, alpha, gamma, minChildWeight,
                                           eta, si, sc, dl, lc, rc, bw, leaf, nodeStats, leafOf);
        float32[] lossChg = heap float32[cap];
        float64[] sumHess = heap float64[cap];
        int64 k = (int64) 0;
        while (k < cap) {
            lossChg[k] = (float32) nodeStats[k];
            sumHess[k] = nodeStats[cap + k];
            k = k + (int64) 1;
        }
        return heap Tree(nodeCount, #si, #sc, #dl, #lc, #rc, #bw, #leaf,
                         #lossChg, #sumHess);
    }

    /**
     * Out-param tree builder. Also fills `leafOf[r]` with the leaf node id row
     * `r` lands in (the final `position[]`), so the boosting loop can accumulate
     * each row's leaf value the way XGBoost updates its prediction cache during
     * training — the exact quantity the next round's gradient is computed from.
     */
    public static int64 grow(Tensor<int32> bins, Tensor<int64> cutPtrs, Tensor<float64> cutValues,
                             float64[] grad, float64[] hess, int64 n,
                             int64 maxDepth, int64 maxLeaves,
                             float64 lambda, float64 alpha, float64 gamma, float64 minChildWeight,
                             float64 eta,
                             int64[] si, float32[] sc, boolean[] dl,
                             int64[] lc, int64[] rc, float32[] bw, boolean[] leaf,
                             float64[] nodeStats,
                             int64[] leafOf) {
        GradientQuantiser q = GradientQuantiser.build(grad, hess, n);
        int64 nf = cutPtrs.shapeAt(0) - (int64) 1;
        int64 nbins = cutPtrs.flatGet(nf);

        int64 cap = TreeBuilder.capacity(maxDepth);
        // Per-node histogram store (flat: nid*nbins + globalBin) + node totals.
        int64[] histG = heap int64[cap * nbins];
        int64[] histH = heap int64[cap * nbins];
        int64[] totGof = heap int64[cap];
        int64[] totHof = heap int64[cap];

        int64[] depthOf = heap int64[cap];
        int64[] queue = heap int64[cap];
        int64 i = (int64) 0;
        while (i < cap) { lc[i] = (int64) -1; rc[i] = (int64) -1; si[i] = (int64) -1;
                          leaf[i] = true; depthOf[i] = (int64) 0; i = i + (int64) 1; }

        // position[r] = the current node id row r reaches (root = 0).
        int64[] position = heap int64[n];
        i = (int64) 0;
        while (i < n) { position[i] = (int64) 0; i = i + (int64) 1; }

        // Root histogram (built directly over all rows).
        TreeBuilder.buildInto(histG, histH, totGof, totHof, (int64) 0, (int64) 0,
                              bins, cutPtrs, q, grad, hess, position, nf, n);

        int64 nodeCount = (int64) 1;
        int64 numLeaves = (int64) 1;
        int64 head = (int64) 0;
        int64 tail = (int64) 0;
        queue[tail] = (int64) 0; tail = tail + (int64) 1;

        while (head < tail) {
            int64 nid = queue[head]; head = head + (int64) 1;
            int64 depth = depthOf[nid];
            int64 base = nid * nbins;

            // This node's histogram is already resident in the store.
            Histogram hist = Histogram.fromStore(histG, histH, base, nbins, nf, totGof[nid], totHof[nid]);

            // gpu-numeric-fidelity 2.2.1 — evaluate-probe input dump. With
            // XGBOOST_NODE_DUMP=<dir> and XGBOOST_NODE_DUMP_NID=<nid>, this node's
            // evaluation inputs are written to <dir> as npys and the build continues.
            // Consumed by tools/gpuprobe/probe_evaluate_gain.cu (verbatim device
            // evaluation of one node on real hardware). Zero cost when unset.
            String dumpDir = System.env.get("XGBOOST_NODE_DUMP");
            if (dumpDir != null) {
                String dumpNid = System.env.get("XGBOOST_NODE_DUMP_NID");
                if (dumpNid != null && dumpNid.equals(Int64.of(nid).toString())) {
                    TreeBuilder.dumpNode(dumpDir, histG, histH, base, nbins, nf, cutPtrs, q,
                                         totGof[nid], totHof[nid], lambda, alpha, minChildWeight);
                }
            }
            // Raw node weight (XGBoost's base_weight — no shrinkage).
            float32 rawW = SplitFinder.leafWeight(q, hist.totalG, hist.totalH, lambda, alpha, minChildWeight);

            // Per-node importance statistics (spec §5.3), packed into one array
            // as [0, cap) = loss change, [cap, 2*cap) = hessian cover. They are
            // recorded here because neither is recoverable from a finished tree,
            // so without them `predict.Importance` can only ever report `weight`
            // from a trained Model. One packed array rather than two parameters:
            // grow() is already at the argument count where the backend miscompiles
            // (cajeta INDEX: codegen-many-param-f32-truncate).
            nodeStats[cap + nid] = q.floatHess(hist.totalH);

            Split s = SplitFinder.findBest(hist, cutPtrs, cutValues, q, lambda, alpha, minChildWeight);

            boolean canSplit = false;
            float32 splitLoss = (float32) 0.0;   // recorded on the node if it splits
            if (s.valid) {
                float32 parentGain = SplitFinder.calcGain(q, hist.totalG, hist.totalH,
                                                          lambda, alpha, minChildWeight);
                float32 lossChg = s.gain - parentGain;
                splitLoss = lossChg;
                boolean hessOk = s.leftH != (int64) 0 && s.rightH != (int64) 0;
                boolean leavesOk = maxLeaves <= (int64) 0 || numLeaves < maxLeaves;
                canSplit = lossChg > TreeBuilder.kRtEps()
                        && hessOk
                        && lossChg >= (float32) gamma
                        && depth < maxDepth
                        && leavesOk;
            }

            if (canSplit) {
                numLeaves = numLeaves + (int64) 1;
                int64 li = nodeCount; nodeCount = nodeCount + (int64) 1;
                int64 ri = nodeCount; nodeCount = nodeCount + (int64) 1;

                leaf[nid] = false;
                bw[nid] = rawW;              // internal node stores the raw base_weight
                nodeStats[nid] = (float64) splitLoss;   // the gain this split bought
                si[nid] = s.findex;
                sc[nid] = s.fvalue;
                dl[nid] = s.defaultLeft;
                lc[nid] = li;
                rc[nid] = ri;
                depthOf[li] = depth + (int64) 1;
                depthOf[ri] = depth + (int64) 1;

                // Repartition this node's rows: present → left iff bin ≤ splitGidx.
                int64 b0 = cutPtrs.flatGet(s.findex);
                int64 localSplit = s.splitGidx - b0;
                int64 r = (int64) 0;
                int64 cntL = (int64) 0;
                int64 cntR = (int64) 0;
                while (r < n) {
                    if (position[r] == nid) {
                        int32 b = bins.flatGet(r * nf + s.findex);
                        boolean goLeft;
                        if (b < (int32) 0) { goLeft = s.defaultLeft; }
                        else { goLeft = (int64) b <= localSplit; }
                        if (goLeft) { position[r] = li; cntL = cntL + (int64) 1; }
                        else        { position[r] = ri; cntR = cntR + (int64) 1; }
                    }
                    r = r + (int64) 1;
                }

                // Sibling subtraction: build the smaller child directly, derive
                // the larger as parent − built (exact int64; §4.2). Both children's
                // slices persist in the store for when they're dequeued.
                if (cntL <= cntR) {
                    TreeBuilder.buildInto(histG, histH, totGof, totHof, li * nbins, li,
                                          bins, cutPtrs, q, grad, hess, position, nf, n);
                    TreeBuilder.subtractInto(histG, histH, totGof, totHof,
                                             base, li * nbins, ri * nbins, nid, li, ri, nbins);
                } else {
                    TreeBuilder.buildInto(histG, histH, totGof, totHof, ri * nbins, ri,
                                          bins, cutPtrs, q, grad, hess, position, nf, n);
                    TreeBuilder.subtractInto(histG, histH, totGof, totHof,
                                             base, ri * nbins, li * nbins, nid, ri, li, nbins);
                }

                queue[tail] = li; tail = tail + (int64) 1;
                queue[tail] = ri; tail = tail + (int64) 1;
            } else {
                leaf[nid] = true;
                // Leaf value = raw weight × learning_rate (shrinkage), float32
                // (updater_gpu_hist.cu:690 `left_weight * param.learning_rate`).
                bw[nid] = (float32) (rawW * (float32) eta);
                sc[nid] = bw[nid];
            }
        }

        // Final leaf assignment per row (every row ends at a leaf node).
        int64 rr = (int64) 0;
        while (rr < n) { leafOf[rr] = position[rr]; rr = rr + (int64) 1; }
        return nodeCount;
    }

    /**
     * Write one node's split-evaluation inputs as npys (gpu-numeric-fidelity
     * 2.2.1): the node histogram, parent sums, cut pointers, and the quantiser
     * scales + regularization config — everything probe_evaluate_gain.cu needs
     * to replay this node's evaluation verbatim on device.
     */
    static void dumpNode(String dir, int64[] histG, int64[] histH, int64 base,
                         int64 nbins, int64 nf, Tensor<int64> cutPtrs, GradientQuantiser q,
                         int64 parentG, int64 parentH,
                         float64 lambda, float64 alpha, float64 minChildWeight) {
        int64[] hshape = heap int64[1];
        hshape[0] = nbins;
        Tensor<int64> hg = Tensor.zeros<int64>(hshape);
        Tensor<int64> hh = Tensor.zeros<int64>(hshape);
        int64 b = (int64) 0;
        while (b < nbins) {
            hg.flatSet(b, histG[base + b]);
            hh.flatSet(b, histH[base + b]);
            b = b + (int64) 1;
        }
        Npy.saveI64(dir + "/hist_g.npy", hg);
        Npy.saveI64(dir + "/hist_h.npy", hh);

        int64[] pshape = heap int64[1];
        pshape[0] = (int64) 2;
        Tensor<int64> par = Tensor.zeros<int64>(pshape);
        par.flatSet((int64) 0, parentG);
        par.flatSet((int64) 1, parentH);
        Npy.saveI64(dir + "/parent.npy", par);

        int64[] cshape = heap int64[1];
        cshape[0] = nf + (int64) 1;
        Tensor<int64> cp = Tensor.zeros<int64>(cshape);
        int64 f = (int64) 0;
        while (f <= nf) { cp.flatSet(f, cutPtrs.flatGet(f)); f = f + (int64) 1; }
        Npy.saveI64(dir + "/cut_ptrs.npy", cp);

        int64[] sshape = heap int64[1];
        sshape[0] = (int64) 5;
        Tensor<float64> cfg = Tensor.zeros<float64>(sshape);
        cfg.flatSet((int64) 0, q.toFloatGrad);
        cfg.flatSet((int64) 1, q.toFloatHess);
        cfg.flatSet((int64) 2, lambda);
        cfg.flatSet((int64) 3, alpha);
        cfg.flatSet((int64) 4, minChildWeight);
        Npy.saveF64(dir + "/scales.npy", cfg);
    }

    /**
     * Accumulate node `nid`'s histogram into the store slice `[base, base+nbins)`
     * by scanning all `n` rows and summing quantized gpairs for rows with
     * `position[r] == nid`. The slice is assumed zero (each node id is written
     * once). Missing values (`bin < 0`) contribute to the node total but to no
     * bin — recovered as the default-direction gpair in {@link SplitFinder}.
     */
    static void buildInto(int64[] histG, int64[] histH, int64[] totGof, int64[] totHof,
                          int64 base, int64 nid,
                          Tensor<int32> bins, Tensor<int64> cutPtrs, GradientQuantiser q,
                          float64[] grad, float64[] hess, int64[] position, int64 nf, int64 n) {
        int64 tg = (int64) 0;
        int64 th = (int64) 0;
        int64 r = (int64) 0;
        while (r < n) {
            if (position[r] == nid) {
                int64 qg = q.fixedGrad(grad[r]);
                int64 qh = q.fixedHess(hess[r]);
                tg = tg + qg;
                th = th + qh;
                int64 f = (int64) 0;
                while (f < nf) {
                    int32 b = bins.flatGet(r * nf + f);
                    if (b >= (int32) 0) {
                        int64 gb = base + cutPtrs.flatGet(f) + (int64) b;
                        histG[gb] = histG[gb] + qg;
                        histH[gb] = histH[gb] + qh;
                    }
                    f = f + (int64) 1;
                }
            }
            r = r + (int64) 1;
        }
        totGof[nid] = tg;
        totHof[nid] = th;
    }

    /**
     * Derive `target = parent − built` in the store (per bin and node totals),
     * exact in int64 fixed-point. `parentNid`/`builtNid`/`targetNid` index the
     * per-node total arrays; the `*Base` args are `nid*nbins` slice offsets.
     */
    static void subtractInto(int64[] histG, int64[] histH, int64[] totGof, int64[] totHof,
                             int64 parentBase, int64 builtBase, int64 targetBase,
                             int64 parentNid, int64 builtNid, int64 targetNid, int64 nbins) {
        int64 b = (int64) 0;
        while (b < nbins) {
            histG[targetBase + b] = histG[parentBase + b] - histG[builtBase + b];
            histH[targetBase + b] = histH[parentBase + b] - histH[builtBase + b];
            b = b + (int64) 1;
        }
        totGof[targetNid] = totGof[parentNid] - totGof[builtNid];
        totHof[targetNid] = totHof[parentNid] - totHof[builtNid];
    }
}
