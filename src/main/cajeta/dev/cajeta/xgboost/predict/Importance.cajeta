package dev.cajeta.xgboost.predict;

import cajeta.math.Tensor;
import dev.cajeta.xgboost.booster.Model;

/**
 * Feature importance (spec §5.3), reproducing XGBoost's `get_score` totals. Over
 * every split (internal) node of every tree, accumulate per split feature:
 *
 *   weight       += 1                 (split count)
 *   total_gain   += loss_change       (the node's gain)
 *   total_cover  += sum_hessian        (the node's hessian coverage)
 *
 * Sums are accumulated in float64 (XGBoost keeps a `double` per feature), in tree
 * then node order, so the result is bit-identical to `get_score(total_gain/…)`.
 */
public final class Importance {

    /**
     * `get_score` totals for a whole trained {@link Model} — the entry point a
     * user actually has after `GBDT.fit`.
     *
     * Walks every split node of every tree, accumulating `weight` (split count),
     * `total_gain` (the node's loss change) and `total_cover` (its hessian
     * coverage) per feature. The three output arrays are indexed by feature and
     * must be `nf` long; they are ADDED to, so a caller may accumulate across
     * models by reusing them.
     *
     * The gain/cover inputs come from `Model.lossChanges` / `Model.sumHessian`,
     * which the tree builder records during growth — they cannot be recovered
     * from a finished tree, which is why importance beyond `weight` needs the
     * model to have carried them from the start.
     */
    public static void forModel(Model m, int64 nf,
                                float64[] weight, float64[] totalGain,
                                float64[] totalCover) {
        int64 r = (int64) 0;
        while (r < m.rounds) {
            int64 k = (int64) 0;
            while (k < m.nodeCount[r]) {
                int64 node = r * m.cap + k;
                if (!m.isLeaf[node]) {                       // split node
                    int64 fdx = m.splitIndices[node];
                    if (fdx >= (int64) 0 && fdx < nf) {
                        weight[fdx] = weight[fdx] + (float64) 1.0;
                        totalGain[fdx] = totalGain[fdx] + (float64) m.lossChanges[node];
                        totalCover[fdx] = totalCover[fdx] + m.sumHessian[node];
                    }
                }
                k = k + (int64) 1;
            }
            r = r + (int64) 1;
        }
    }

    /** Accumulate one tree's split-node contributions into the per-feature totals. */
    public static void addTree(Tensor<int32> leftChildren, Tensor<int32> splitIndices,
                               Tensor<float32> lossChanges, Tensor<float64> sumHessian,
                               int64 nodeCount,
                               float64[] weight, float64[] totalGain, float64[] totalCover) {
        int64 nid = (int64) 0;
        while (nid < nodeCount) {
            if (leftChildren.flatGet(nid) != (int32) -1) {           // split node
                int64 fdx = (int64) splitIndices.flatGet(nid);
                weight[fdx] = weight[fdx] + (float64) 1.0;
                totalGain[fdx] = totalGain[fdx] + (float64) lossChanges.flatGet(nid);
                totalCover[fdx] = totalCover[fdx] + sumHessian.flatGet(nid);
            }
            nid = nid + (int64) 1;
        }
    }
}
