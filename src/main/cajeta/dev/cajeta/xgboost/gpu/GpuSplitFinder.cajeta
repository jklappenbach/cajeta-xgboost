package dev.cajeta.xgboost.gpu;

import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.Wave;
import cajeta.xpu.Workgroup;
import cajeta.xpu.Bits;
import cajeta.math.sfu.SfuMath;
import dev.cajeta.xgboost.tree.GradientQuantiser;
import dev.cajeta.xgboost.tree.Histogram;
import dev.cajeta.xgboost.tree.Split;

/**
 * The GPU split evaluator (plan U12.2.1, spec §8.1): {@link
 * dev.cajeta.xgboost.tree.SplitFinder}'s Stage A — the device's tiled,
 * min_child_weight-blind per-feature argmax — as a `cajeta.xpu` kernel, one
 * 32-lane wave per feature, computing each boundary's gain with the CPU
 * loop's operations in their order. Stage B (the
 * cross-feature Update) runs on the host over the kernel's per-feature
 * records, mirroring the CPU code exactly, so a {@link Split} from here is
 * bit-identical to `SplitFinder.findBest`'s on every backend.
 *
 * **Why a wave per feature is still exact.** Bit-identity is the contract
 * (§1.4). The prefix sums are int64 and exact in any order, each lane's gain
 * uses the sequential loop's operations, and a tile's winner is its first
 * maximum, which is what the sequential strict `>` keeps.
 *
 * **In-kernel `__fdividef`.** Gain scoring replicates {@link
 * SfuMath#fdividef} inside the kernel — the probed SFU reciprocal table
 * rides along as a device buffer (`rcpTab`), so every backend computes the
 * same `a * rcp(b)` the CUDA silicon does. The table is REQUIRED here: the
 * host wrapper throws without it (callers gate on `SfuMath.hasRcpTable()`
 * and use the CPU finder), because a per-backend native division would
 * un-pin exactly the knife-edge splits the table exists to pin.
 *
 * The int64 prefix scans are exact integer arithmetic; the float64
 * dequantize multiplies and float32 narrowings are IEEE-identical on every
 * backend (verified by the U12 op-inventory probe).
 */
public final class GpuSplitFinder {

    /** One lane's split gain at a boundary whose left child holds (lG, lH). */
    @Device
    static float32 laneGain(int64 lG, int64 lH, int64 parentG, int64 parentH,
                            KernelBuffer<int32> rcpTab, float64 toFloatGrad,
                            float64 toFloatHess, float64 lambda, float64 alpha) {
        float64 gdl = (float64) lG * toFloatGrad;
        float64 hdl = (float64) lH * toFloatHess;
        float32 gl = (float32) 0.0;
        if (hdl > 0.0) {
            float64 tl = gdl;
            if (gdl > alpha) { tl = gdl - alpha; }
            else if (gdl < 0.0 - alpha) { tl = gdl + alpha; }
            else { tl = 0.0; }
            float32 num = (float32) (tl * tl);
            float32 den = (float32) (hdl + lambda);
            gl = SfuMath.fdividefDev(num, den, rcpTab);
        }
        float64 gdr = (float64) (parentG - lG) * toFloatGrad;
        float64 hdr = (float64) (parentH - lH) * toFloatHess;
        float32 gr = (float32) 0.0;
        if (hdr > 0.0) {
            float64 tr = gdr;
            if (gdr > alpha) { tr = gdr - alpha; }
            else if (gdr < 0.0 - alpha) { tr = gdr + alpha; }
            else { tr = 0.0; }
            float32 num2 = (float32) (tr * tr);
            float32 den2 = (float32) (hdr + lambda);
            gr = SfuMath.fdividefDev(num2, den2, rcpTab);
        }
        return gl + gr;
    }

    /**
     * Stage A, one 32-lane wave per feature and a lane per boundary of a
     * 32-boundary tile. Each tile's winner is its first maximum, as the
     * sequential scan's strict `>` picks.
     */
    @Kernel
    @Wave(width = 32)
    public static void featureScan(KernelBuffer<float32> outGain,
                                   KernelBuffer<int32> outMeta,
                                   KernelBuffer<int64> outStats,
                                   KernelBuffer<int64> histG,
                                   KernelBuffer<int64> histH,
                                   KernelBuffer<int32> cutOff,
                                   KernelBuffer<int64> parents,
                                   KernelBuffer<int32> rcpTab,
                                   float64 toFloatGrad, float64 toFloatHess,
                                   float64 lambda, float64 alpha,
                                   float64 minChildWeight, uint32 nf) {
        uint32 f = Workgroup.x();
        uint32 lane = Wave.laneId();
        if (f < nf) {
            int64 b0 = (int64) cutOff[f];
            int64 b1 = (int64) cutOff[f + 1];
            int64 parentG = parents[0];
            int64 parentH = parents[1];

            int64 partG = 0;
            int64 partH = 0;
            int64 sb = b0;
            while (sb < b1) {
                int64 q = sb + (int64) lane;
                if (q < b1) {
                    partG = partG + histG[q];
                    partH = partH + histH[q];
                }
                sb = sb + 32;
            }
            int64 missG = parentG - Wave.reduceSumI64(partG);
            int64 missH = parentH - Wave.reduceSumI64(partH);

            boolean featHas = false;
            float32 featGain = (float32) 0.0;
            int64 featP = 0;
            int64 featScanG = 0;
            int64 featScanH = 0;
            boolean featMissLeft = true;

            int64 carryG = 0;
            int64 carryH = 0;
            int64 tileStart = b0 + 1;
            while (tileStart < b1) {
                int64 p = tileStart + (int64) lane;
                boolean live = p < b1;
                int64 hg = 0;
                int64 hh = 0;
                if (live) {
                    hg = histG[p];
                    hh = histH[p];
                }
                int64 scanG = carryG + Wave.prefixSumI64(hg);
                int64 scanH = carryH + Wave.prefixSumI64(hh);

                float32 gainL = GpuSplitFinder.laneGain(scanG + missG, scanH + missH,
                    parentG, parentH, rcpTab, toFloatGrad, toFloatHess, lambda, alpha);
                float32 gainR = GpuSplitFinder.laneGain(scanG, scanH,
                    parentG, parentH, rcpTab, toFloatGrad, toFloatHess, lambda, alpha);
                boolean missLeft = gainL > gainR;
                float32 gain = gainR;
                if (missLeft) { gain = gainL; }

                float32 first = Wave.shuffleSyncF32(gain, 0);
                float32 cand = first;
                if (live) { cand = gain; }
                float32 top = Wave.reduceMaxF32(cand);
                uint32 win = Bits.trailingZeros(Wave.ballotSync(live && gain == top));

                uint32 mlBit = 0;
                if (missLeft) { mlBit = 1; }
                float32 tileGain = Wave.shuffleSyncF32(gain, win);
                boolean tileMissLeft = Wave.shuffleSync(mlBit, win) != 0;
                int64 tileScanG = Wave.shuffleSyncI64(scanG, win);
                int64 tileScanH = Wave.shuffleSyncI64(scanH, win);

                int64 cLH = tileScanH;
                if (tileMissLeft) { cLH = tileScanH + missH; }
                int64 cRH = parentH - cLH;
                boolean valid = (float64) cLH * toFloatHess >= minChildWeight
                             && (float64) cRH * toFloatHess >= minChildWeight;
                if (valid && (!featHas || tileGain > featGain)) {
                    featHas = true;
                    featGain = tileGain;
                    featP = tileStart + (int64) win;
                    featScanG = tileScanG;
                    featScanH = tileScanH;
                    featMissLeft = tileMissLeft;
                }

                carryG = carryG + Wave.reduceSumI64(hg);
                carryH = carryH + Wave.reduceSumI64(hh);
                tileStart = tileStart + 32;
            }

            if (lane == 0) {
                outGain[f] = featGain;
                int32 hasI = 0;
                if (featHas) { hasI = 1; }
                int32 mlI = 0;
                if (featMissLeft) { mlI = 1; }
                outMeta[f * 3] = hasI;
                outMeta[f * 3 + 1] = mlI;
                outMeta[f * 3 + 2] = (int32) featP;
                outStats[f * 4] = featScanG;
                outStats[f * 4 + 1] = featScanH;
                outStats[f * 4 + 2] = missG;
                outStats[f * 4 + 3] = missH;
            }
        }
    }

    /**
     * {@link #featureScan} for a level: one 32-lane wave per (node, feature),
     * reading node `j`'s slot of the device store at word `slotBase[j]`
     * (interleaved G and H per bin, then the totals).
     */
    @Kernel
    @Wave(width = 32)
    public static void levelScan(KernelBuffer<float32> outGain,
                                 KernelBuffer<int32> outMeta,
                                 KernelBuffer<int64> outStats,
                                 KernelBuffer<int64> store,
                                 KernelBuffer<int64> slotBase,
                                 KernelBuffer<int32> cutOff,
                                 KernelBuffer<int32> rcpTab,
                                 float64 toFloatGrad, float64 toFloatHess,
                                 float64 lambda, float64 alpha,
                                 float64 minChildWeight, uint32 nf, uint32 nodes, uint32 nbins) {
        uint32 wg = Workgroup.x();
        uint32 j = wg / nf;
        uint32 f = wg - j * nf;
        uint32 lane = Wave.laneId();
        if (j < nodes) {
            int64 base = slotBase[j];
            uint32 o = wg;
            int64 b0 = (int64) cutOff[f];
            int64 b1 = (int64) cutOff[f + 1];
            int64 parentG = store[base + (int64) nbins * 2];
            int64 parentH = store[base + (int64) nbins * 2 + 1];

            int64 partG = 0;
            int64 partH = 0;
            int64 sb = b0;
            while (sb < b1) {
                int64 q = sb + (int64) lane;
                if (q < b1) {
                    partG = partG + store[base + q * 2];
                    partH = partH + store[base + q * 2 + 1];
                }
                sb = sb + 32;
            }
            int64 missG = parentG - Wave.reduceSumI64(partG);
            int64 missH = parentH - Wave.reduceSumI64(partH);

            boolean featHas = false;
            float32 featGain = (float32) 0.0;
            int64 featP = 0;
            int64 featScanG = 0;
            int64 featScanH = 0;
            boolean featMissLeft = true;

            int64 carryG = 0;
            int64 carryH = 0;
            int64 tileStart = b0 + 1;
            while (tileStart < b1) {
                int64 p = tileStart + (int64) lane;
                boolean live = p < b1;
                int64 hg = 0;
                int64 hh = 0;
                if (live) {
                    hg = store[base + p * 2];
                    hh = store[base + p * 2 + 1];
                }
                int64 scanG = carryG + Wave.prefixSumI64(hg);
                int64 scanH = carryH + Wave.prefixSumI64(hh);

                float32 gainL = GpuSplitFinder.laneGain(scanG + missG, scanH + missH,
                    parentG, parentH, rcpTab, toFloatGrad, toFloatHess, lambda, alpha);
                float32 gainR = GpuSplitFinder.laneGain(scanG, scanH,
                    parentG, parentH, rcpTab, toFloatGrad, toFloatHess, lambda, alpha);
                boolean missLeft = gainL > gainR;
                float32 gain = gainR;
                if (missLeft) { gain = gainL; }

                float32 first = Wave.shuffleSyncF32(gain, 0);
                float32 cand = first;
                if (live) { cand = gain; }
                float32 top = Wave.reduceMaxF32(cand);
                uint32 win = Bits.trailingZeros(Wave.ballotSync(live && gain == top));

                uint32 mlBit = 0;
                if (missLeft) { mlBit = 1; }
                float32 tileGain = Wave.shuffleSyncF32(gain, win);
                boolean tileMissLeft = Wave.shuffleSync(mlBit, win) != 0;
                int64 tileScanG = Wave.shuffleSyncI64(scanG, win);
                int64 tileScanH = Wave.shuffleSyncI64(scanH, win);

                int64 cLH = tileScanH;
                if (tileMissLeft) { cLH = tileScanH + missH; }
                int64 cRH = parentH - cLH;
                boolean valid = (float64) cLH * toFloatHess >= minChildWeight
                             && (float64) cRH * toFloatHess >= minChildWeight;
                if (valid && (!featHas || tileGain > featGain)) {
                    featHas = true;
                    featGain = tileGain;
                    featP = tileStart + (int64) win;
                    featScanG = tileScanG;
                    featScanH = tileScanH;
                    featMissLeft = tileMissLeft;
                }

                carryG = carryG + Wave.reduceSumI64(hg);
                carryH = carryH + Wave.reduceSumI64(hh);
                tileStart = tileStart + 32;
            }

            if (lane == 0) {
                outGain[o] = featGain;
                int32 hasI = 0;
                if (featHas) { hasI = 1; }
                int32 mlI = 0;
                if (featMissLeft) { mlI = 1; }
                outMeta[o * 3] = hasI;
                outMeta[o * 3 + 1] = mlI;
                outMeta[o * 3 + 2] = (int32) featP;
                outStats[o * 4] = featScanG;
                outStats[o * 4 + 1] = featScanH;
                outStats[o * 4 + 2] = missG;
                outStats[o * 4 + 3] = missH;
            }
        }
    }

    /** Words per split record of {@link #levelPick}. */
    public static int64 recordWords() { return (int64) 12; }

    /**
     * Stage B for a level, a thread per node: `SplitFinder.findBest`'s
     * cross-feature update over the node's records (strict `>` after the
     * min_child_weight gate, so ties keep the lowest feature). Record `j` is
     * valid, feature, boundary, gain bits, default-left, the child sums
     * (lG, lH, rG, rH) and the node's totals.
     */
    @Kernel
    public static void levelPick(KernelBuffer<int64> rec, KernelBuffer<float32> featGain,
                                 KernelBuffer<int32> featMeta, KernelBuffer<int64> featStats,
                                 KernelBuffer<int64> store, KernelBuffer<int64> slotBase,
                                 float64 toFloatHess, float64 minChildWeight,
                                 uint32 nf, uint32 nodes, uint32 nbins) {
        uint32 j = KernelThread.globalIdX();
        if (j < nodes) {
            int64 base = slotBase[j];
            int64 parentG = store[base + (int64) nbins * 2];
            int64 parentH = store[base + (int64) nbins * 2 + 1];
            boolean haveBest = false;
            float32 bestGain = (float32) 0.0;
            int64 bf = (int64) -1;
            int64 bp = (int64) 0;
            int64 bml = (int64) 1;
            int64 blG = (int64) 0;
            int64 blH = (int64) 0;
            uint32 f = 0;
            while (f < nf) {
                uint32 o = j * nf + f;
                if (featMeta[o * 3] != 0) {
                    boolean missLeft = featMeta[o * 3 + 1] != 0;
                    int64 lG = featStats[o * 4];
                    int64 lH = featStats[o * 4 + 1];
                    if (missLeft) {
                        lG = lG + featStats[o * 4 + 2];
                        lH = lH + featStats[o * 4 + 3];
                    }
                    int64 rH = parentH - lH;
                    float32 fGain = featGain[o];
                    boolean okW = (float64) lH * toFloatHess >= minChildWeight
                               && (float64) rH * toFloatHess >= minChildWeight;
                    if (okW && (!haveBest || fGain > bestGain)) {
                        haveBest = true;
                        bestGain = fGain;
                        bf = (int64) f;
                        bp = (int64) featMeta[o * 3 + 2];
                        bml = (int64) 0;
                        if (missLeft) { bml = (int64) 1; }
                        blG = lG;
                        blH = lH;
                    }
                }
                f = f + 1;
            }
            uint32 r = j * 12;
            rec[r] = (int64) 0;
            if (haveBest) { rec[r] = (int64) 1; }
            rec[r + 1] = bf;
            rec[r + 2] = bp - (int64) 1;
            rec[r + 3] = (int64) Cajeta.f32ToBits(bestGain);
            rec[r + 4] = bml;
            rec[r + 5] = blG;
            rec[r + 6] = blH;
            rec[r + 7] = (int64) 0;
            rec[r + 8] = (int64) 0;
            if (haveBest) {
                rec[r + 7] = parentG - blG;
                rec[r + 8] = parentH - blH;
            }
            rec[r + 9] = parentG;
            rec[r + 10] = parentH;
            rec[r + 11] = (int64) 0;
        }
    }

    /**
     * Evaluates `nodes` nodes whose slots start at `slotBase`: one Stage A and
     * one Stage B launch and one sync; their records land in `rec`.
     */
    static void evaluateLevel(KernelBuffer<int64> rec, KernelBuffer<float32> gain,
                              KernelBuffer<int32> meta, KernelBuffer<int64> stats,
                              KernelBuffer<int64> store, KernelBuffer<int64> slotBase,
                              KernelBuffer<int32> cutPtr, GradientQuantiser q,
                              float64 lambda, float64 alpha, float64 minChildWeight,
                              int64 nf, int64 nodes, int64 nbins, TransferLog log) {
        KernelBuffer<int32> rcpTab = SfuMath.deviceRcpTable();
        KernelStream s #= KernelStream.current();
        uint32 un = (uint32) nodes;
        levelScan.launch(s, grid: [(uint32) (nodes * nf)], block: [32])
            (gain, meta, stats, store, slotBase, cutPtr, rcpTab, q.toFloatGrad, q.toFloatHess,
             lambda, alpha, minChildWeight, (uint32) nf, un, (uint32) nbins);
        levelPick.launch(s, grid: [(un + 63) / 64], block: [64])
            (rec, gain, meta, stats, store, slotBase, q.toFloatHess, minChildWeight,
             (uint32) nf, un, (uint32) nbins);
        s.sync();
        log.synced();
        return;
    }

    /** Launches featureScan over `nf` features, one 32-lane workgroup each, and waits for it. */
    public static void launchScan(KernelBuffer<float32> outGain, KernelBuffer<int32> outMeta,
                                  KernelBuffer<int64> outStats, KernelBuffer<int64> histG,
                                  KernelBuffer<int64> histH, KernelBuffer<int32> cutOff,
                                  KernelBuffer<int64> parents, KernelBuffer<int32> rcpTab,
                                  float64 toFloatGrad, float64 toFloatHess,
                                  float64 lambda, float64 alpha,
                                  float64 minChildWeight, uint32 nf) {
        TransferLog log = heap TransferLog();
        GpuSplitFinder.launchScan(outGain, outMeta, outStats, histG, histH, cutOff, parents, rcpTab,
                                  toFloatGrad, toFloatHess, lambda, alpha, minChildWeight, nf, log);
        return;
    }

    /** {@link #launchScan}, with its sync counted in `log`. */
    static void launchScan(KernelBuffer<float32> outGain, KernelBuffer<int32> outMeta,
                           KernelBuffer<int64> outStats, KernelBuffer<int64> histG,
                           KernelBuffer<int64> histH, KernelBuffer<int32> cutOff,
                           KernelBuffer<int64> parents, KernelBuffer<int32> rcpTab,
                           float64 toFloatGrad, float64 toFloatHess,
                           float64 lambda, float64 alpha,
                           float64 minChildWeight, uint32 nf, TransferLog log) {
        KernelStream s #= KernelStream.current();
        featureScan.launch(s, grid: [nf], block: [32])
            (outGain, outMeta, outStats, histG, histH, cutOff, parents, rcpTab,
             toFloatGrad, toFloatHess, lambda, alpha, minChildWeight, nf);
        log.sync(s);
        return;
    }

    /**
     * The GPU analog of `SplitFinder.findBest` — same arguments, same result
     * bit for bit. Stage A runs on the device (one thread per feature);
     * Stage B — the cross-feature Update (strict `>` and the
     * min_child_weight gate; ties → lowest feature) — replays the CPU code
     * over the per-feature records here on the host.
     *
     * Requires the probed SFU table (`SfuMath.hasRcpTable()`); throws
     * without it — dispatch to the CPU finder instead.
     */
    public static #Split findBest(Histogram hist, Tensor<int64> cutPtrs,
                                  Tensor<float64> cutValues,
                                  GradientQuantiser q,
                                  float64 lambda, float64 alpha,
                                  float64 minChildWeight) {
        TransferLog log = heap TransferLog();
        return GpuSplitFinder.findBest(hist, cutPtrs, cutValues, q, lambda, alpha, minChildWeight, log);
    }

    /** {@link #findBest}, with its transfers and sync counted in `log`. */
    static #Split findBest(Histogram hist, Tensor<int64> cutPtrs, Tensor<float64> cutValues,
                           GradientQuantiser q, float64 lambda, float64 alpha,
                           float64 minChildWeight, TransferLog log) {
        KernelBuffer<int32> rcpTab = SfuMath.deviceRcpTable();
        if (rcpTab == null) {
            throw heap RecoverableException("GpuSplitFinder.findBest: the SFU "
                + "reciprocal capture (RCP_TABLE) is required for bit-exact "
                + "gain scoring — use SplitFinder.findBest without it");
        }
        int64 nf = hist.nf;
        int64 nbins = hist.nbins;

        int32[] cutOffH = heap int32[nf + (int64) 1];
        int64 f = (int64) 0;
        while (f <= nf) {
            cutOffH[f] = (int32) cutPtrs.flatGet(f);
            f = f + (int64) 1;
        }
        int64[] parentsH = heap int64[2];
        parentsH[0] = hist.totalG;
        parentsH[1] = hist.totalH;

        KernelBuffer<float32> dGain = heap KernelBuffer<float32>(nf);
        KernelBuffer<int32> dMeta = heap KernelBuffer<int32>(nf * (int64) 3);
        KernelBuffer<int64> dStats = heap KernelBuffer<int64>(nf * (int64) 4);
        KernelBuffer<int64> dHistG = heap KernelBuffer<int64>(nbins);
        KernelBuffer<int64> dHistH = heap KernelBuffer<int64>(nbins);
        KernelBuffer<int32> dCut = heap KernelBuffer<int32>(nf + (int64) 1);
        KernelBuffer<int64> dParents = heap KernelBuffer<int64>(2);
        float32[] zg = heap float32[nf];
        int32[] zm = heap int32[nf * (int64) 3];
        int64[] zs = heap int64[nf * (int64) 4];
        dGain.upload(zg);
        dMeta.upload(zm);
        dStats.upload(zs);
        dHistG.upload(hist.g);
        dHistH.upload(hist.h);
        dCut.upload(cutOffH);
        dParents.upload(parentsH);
        log.upSmalls((int64) 7);

        GpuSplitFinder.launchScan(dGain, dMeta, dStats, dHistG, dHistH, dCut, dParents,
            rcpTab, q.toFloatGrad, q.toFloatHess, lambda, alpha, minChildWeight,
            (uint32) nf, log);

        float32[] featGain = heap float32[nf];
        int32[] featMeta = heap int32[nf * (int64) 3];
        int64[] featStats = heap int64[nf * (int64) 4];
        dGain.download(featGain);
        dMeta.download(featMeta);
        dStats.download(featStats);
        log.downSmalls((int64) 3);

        // Stage B — verbatim from SplitFinder.findBest.
        Split best = heap Split();
        float32 bestGain = (float32) 0.0;
        boolean haveBest = false;
        int64 parentG = hist.totalG;
        int64 parentH = hist.totalH;

        f = (int64) 0;
        while (f < nf) {
            boolean featHas = featMeta[f * (int64) 3] != (int32) 0;
            if (featHas) {
                boolean featMissLeft = featMeta[f * (int64) 3 + (int64) 1] != (int32) 0;
                int64 featP = (int64) featMeta[f * (int64) 3 + (int64) 2];
                int64 featScanG = featStats[f * (int64) 4];
                int64 featScanH = featStats[f * (int64) 4 + (int64) 1];
                int64 missG = featStats[f * (int64) 4 + (int64) 2];
                int64 missH = featStats[f * (int64) 4 + (int64) 3];
                float32 fGain = featGain[f];

                int64 lG = featMissLeft ? featScanG + missG : featScanG;
                int64 lH = featMissLeft ? featScanH + missH : featScanH;
                int64 rG = parentG - lG;
                int64 rH = parentH - lH;
                boolean okW = q.floatHess(lH) >= minChildWeight
                           && q.floatHess(rH) >= minChildWeight;
                if (okW && (!haveBest || fGain > bestGain)) {
                    haveBest = true;
                    bestGain = fGain;
                    best.valid = true;
                    best.findex = f;
                    best.gain = fGain;
                    best.defaultLeft = featMissLeft;
                    best.leftG = lG;
                    best.leftH = lH;
                    best.rightG = rG;
                    best.rightH = rH;
                    int64 splitGidx = featP - (int64) 1;
                    best.splitGidx = splitGidx;
                    if (splitGidx >= cutPtrs.flatGet(f)) {
                        best.fvalue = (float32) cutValues.flatGet(splitGidx);
                    } else {
                        best.fvalue = (float32) 0.0;
                    }
                }
            }
            f = f + (int64) 1;
        }
        return #best;
    }
}
