package dev.cajeta.xgboost.gpu;

import cajeta.math.Tensor;
import cajeta.xpu.Barrier;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import cajeta.xpu.KernelTimer;
import cajeta.xpu.Shared;
import cajeta.xpu.Workgroup;
import dev.cajeta.xgboost.tree.GradientQuantiser;
import dev.cajeta.xgboost.tree.Histogram;

/**
 * The GPU gradient histogram (plan U12, spec §8.1): the same int64
 * fixed-point per-(feature, global-bin) sums as {@link Histogram}, built by
 * a `cajeta.xpu` kernel — one thread per (row, feature) cell, scattering
 * the row's quantized gpair into its bin with integer atomics.
 *
 * **Why this is bit-identical on every backend.** Quantization happens on
 * the HOST through the same {@link GradientQuantiser} the CPU builder uses,
 * so the kernel is integer-only. Integer addition is associative and
 * commutative, so atomic scatter order — which varies freely between
 * backends, wave sizes, and runs — cannot change the sums. That is XGBoost's
 * own determinism argument for its GPU histogram, reproduced.
 *
 * Each sum is a single native int64 `atomicAdd` (toolchain ≥ v0.17.4:
 * Int64Atomics on Vulkan, native 64-bit atomics on CUDA/HIP/CPU). Earlier
 * versions of this kernel accumulated each int64 as two uint32 words with an
 * explicit atomic carry — the pre-sm_60 CUDA idiom; the native form is the
 * same exact sum with a third of the atomics traffic.
 *
 * Layout: `hist` is `[2 * nbins]` int64 — `gb*2 + {0: G, 1: H}`; `q` is
 * `[2 * n]` int64 — `r*2 + {qg, qh}`. Missing values (`bin == -1`) are
 * skipped exactly as on the CPU.
 */
public final class GpuHistogram {

    static int64 forcedRows = (int64) 0;
    static int64 tuneCount = (int64) 0;
    static boolean sharedOn = true;

    /** Bins one feature group holds in workgroup memory: 2048 G/H pairs, 32 KiB. */
    public static int64 groupBins() { return (int64) 2048; }

    /** The rows per tile the tuner times, ascending. */
    public static #int64[] tileCandidates() {
        int64[] c = heap int64[5];
        c[0] = (int64) 256;
        c[1] = (int64) 512;
        c[2] = (int64) 1024;
        c[3] = (int64) 2048;
        c[4] = (int64) 4096;
        return #c;
    }

    /** Forces every new fit's tile to `rows` rows; 0 restores the tuned tile. */
    public static void forceTileRows(int64 rows) { GpuHistogram.forcedRows = rows; }

    /** Turns the workgroup-shared build on or off for new fits; a timing hook. */
    public static void useSharedTiles(boolean on) { GpuHistogram.sharedOn = on; }

    /** Timed tile tunings so far in this execution. */
    public static int64 tunings() { return GpuHistogram.tuneCount; }

    /** Feature groups in order, `(first feature, end feature, first bin, bins)` each, within
     *  {@link #groupBins}; null when one feature alone exceeds it. */
    static #int32[] featureGroups(Tensor<int64> cutPtrs) {
        int64 nf = cutPtrs.shapeAt(0) - (int64) 1;
        int32[] out = heap int32[nf * (int64) 4];
        int64 k = (int64) 0;
        int64 f = (int64) 0;
        while (f < nf) {
            int64 b0 = cutPtrs.flatGet(f);
            int64 e = f;
            while (e < nf && cutPtrs.flatGet(e + (int64) 1) - b0 <= GpuHistogram.groupBins()) {
                e = e + (int64) 1;
            }
            if (e == f) { return null; }
            out[k * (int64) 4] = (int32) f;
            out[k * (int64) 4 + (int64) 1] = (int32) e;
            out[k * (int64) 4 + (int64) 2] = (int32) b0;
            out[k * (int64) 4 + (int64) 3] = (int32) (cutPtrs.flatGet(e) - b0);
            k = k + (int64) 1;
            f = e;
        }
        int32[] g = heap int32[k * (int64) 4];
        int64 i = (int64) 0;
        while (i < k * (int64) 4) { g[i] = out[i]; i = i + (int64) 1; }
        return #g;
    }

    /** Tile `x` of `rows` rows over feature group `y`, summed in workgroup memory and merged once per
     *  nonzero word; a `level` tile's segment comes from `plan`, else it is `sBegin`, `sCount` at `sBase`. */
    @Kernel
    public static void histTiles(KernelBuffer<int64> hist, KernelBuffer<int32> bins,
                                 KernelBuffer<int32> cutOff, KernelBuffer<int64> q,
                                 KernelBuffer<int32> ridx, KernelBuffer<int64> plan,
                                 KernelBuffer<int64> slotTab, KernelBuffer<int32> tileSplit,
                                 KernelBuffer<int32> groups, uint32 level, uint32 sBase,
                                 uint32 sBegin, uint32 sCount, uint32 rows, uint32 nf,
                                 uint32 nbins) {
        Shared<int64> acc = shared int64[4098];
        uint32 t = KernelThread.x();
        uint32 w = Workgroup.x();
        uint32 gi = Workgroup.y();
        uint32 step = Workgroup.dimX();
        uint32 base = sBase;
        uint32 begin = sBegin;
        uint32 count = sCount;
        uint32 tile = w;
        if (level == 1) {
            uint32 j = (uint32) tileSplit[w];
            base = (uint32) plan[j * 4];
            begin = (uint32) plan[j * 4 + 1];
            count = (uint32) plan[j * 4 + 2];
            tile = w - (uint32) slotTab[j * 4 + 3];
        }
        uint32 f0 = (uint32) groups[gi * 4];
        uint32 nfg = (uint32) groups[gi * 4 + 1] - f0;
        uint32 b0 = (uint32) groups[gi * 4 + 2];
        uint32 words = (uint32) groups[gi * 4 + 3] * 2;
        uint32 i = t;
        while (i < words + 2) {
            acc[i] = (int64) 0;
            i = i + step;
        }
        Barrier.workgroup();
        uint32 first = tile * rows;
        uint32 span = 0;
        if (first < count) {
            span = count - first;
            if (span > rows) { span = rows; }
        }
        uint32 cells = span * nfg;
        int64 tg = (int64) 0;
        int64 th = (int64) 0;
        uint32 c = t;
        while (c < cells) {
            uint32 k = c / nfg;
            uint32 f = f0 + (c - k * nfg);
            uint32 r = (uint32) ridx[begin + first + k];
            int64 qg = q[r * 2];
            int64 qh = q[r * 2 + 1];
            if (f == 0) {
                tg = tg + qg;
                th = th + qh;
            }
            int32 b = bins[r * nf + f];
            if (b >= 0) {
                uint32 gb = ((uint32) cutOff[f] + (uint32) b - b0) * 2;
                acc.atomicAdd(gb, qg);
                acc.atomicAdd(gb + 1, qh);
            }
            c = c + step;
        }
        if (gi == 0) {
            acc.atomicAdd(words, tg);
            acc.atomicAdd(words + 1, th);
        }
        Barrier.workgroup();
        i = t;
        while (i < words + 2) {
            int64 v = acc[i];
            if (v != (int64) 0) {
                uint32 at = base + b0 * 2 + i;
                if (i >= words) { at = base + nbins * 2 + (i - words); }
                hist.atomicAdd(at, v);
            }
            i = i + step;
        }
    }

    /** Writes split `j` over its tiles of `tileSplit`: its first tile is in `slotTab`, its count in `tab`. */
    @Kernel
    public static void levelTiles(KernelBuffer<int32> tileSplit, KernelBuffer<int64> slotTab,
                                  KernelBuffer<int32> tab, uint32 rows) {
        uint32 j = Workgroup.x();
        uint32 first = (uint32) slotTab[j * 4 + 3];
        uint32 tiles = ((uint32) tab[j * 6 + 1] / 2 + rows - 1) / rows;
        uint32 b = KernelThread.x();
        while (b < tiles) {
            tileSplit[first + b] = (int32) j;
            b = b + Workgroup.dimX();
        }
    }

    /** Launches the shared build of the segment `[begin, begin + count)` into the slot at `base`, with no sync. */
    static void launchSegmentTiles(KernelStream s, KernelBuffer<int64> hist, int64 base,
                                   KernelBuffer<int32> bins, KernelBuffer<int32> cutOff,
                                   KernelBuffer<int64> q, KernelBuffer<int32> ridx,
                                   KernelBuffer<int64> plan, KernelBuffer<int64> slotTab,
                                   KernelBuffer<int32> tileSplit, KernelBuffer<int32> groups,
                                   int64 ngroups, int64 begin, int64 count, int64 rows,
                                   int64 nf, int64 nbins) {
        uint32 words = (uint32) ((int64) 2 * nbins + (int64) 2);
        zeroRange.launch(s, grid: [(words + 255) / 256], block: [256])(hist, (uint32) base, words);
        uint32 tiles = (uint32) ((count + rows - (int64) 1) / rows);
        if (tiles > 0) {
            histTiles.launch(s, grid: [tiles, (uint32) ngroups], block: [256])
                (hist, bins, cutOff, q, ridx, plan, slotTab, tileSplit, groups, (uint32) 0,
                 (uint32) base, (uint32) begin, (uint32) count, (uint32) rows, (uint32) nf,
                 (uint32) nbins);
        }
        return;
    }

    /** {@link #buildSegment} through workgroup-shared tiles of `rows` rows, and waits. */
    static void buildSegmentTiles(KernelBuffer<int64> hist, int64 base, KernelBuffer<int32> bins,
                                  KernelBuffer<int32> cutOff, KernelBuffer<int64> q,
                                  KernelBuffer<int32> ridx, KernelBuffer<int64> plan,
                                  KernelBuffer<int64> slotTab, KernelBuffer<int32> tileSplit,
                                  KernelBuffer<int32> groups, int64 ngroups, int64 begin,
                                  int64 count, int64 rows, int64 nf, int64 nbins, TransferLog log) {
        KernelStream s #= KernelStream.current();
        GpuHistogram.launchSegmentTiles(s, hist, base, bins, cutOff, q, ridx, plan, slotTab, tileSplit,
                                        groups, ngroups, begin, count, rows, nf, nbins);
        log.sync(s);
        return;
    }

    /** The fastest median tile candidate's rows over three interleaved rounds of the segment's
     *  shared build; 0 when none could be timed. */
    static int64 tuneTiles(KernelBuffer<int64> hist, int64 base, KernelBuffer<int32> bins,
                           KernelBuffer<int32> cutOff, KernelBuffer<int64> q,
                           KernelBuffer<int32> ridx, KernelBuffer<int64> plan,
                           KernelBuffer<int64> slotTab, KernelBuffer<int32> tileSplit,
                           KernelBuffer<int32> groups, int64 ngroups, int64 begin, int64 count,
                           int64 nf, int64 nbins) {
        int64[] cands #= GpuHistogram.tileCandidates();
        int64 nc = (int64) cands.count();
        int64 rounds = (int64) 3;
        int64[] ns = heap int64[nc * rounds];
        boolean[] refused = heap boolean[nc];
        KernelStream s #= KernelStream.current();
        KernelTimer tm #= KernelTimer.create();
        int64 round = (int64) 0;
        while (round < rounds) {
            int64 j = (int64) 0;
            while (j < nc) {
                int64 i = (j + round) % nc;
                if (!refused[i]) {
                    tm.begin(s);
                    GpuHistogram.launchSegmentTiles(s, hist, base, bins, cutOff, q, ridx, plan, slotTab,
                                                    tileSplit, groups, ngroups, begin, count, cands[i],
                                                    nf, nbins);
                    tm.end(s);
                    int64 t = tm.elapsedNanos();
                    if (t < (int64) 0) { refused[i] = true; }
                    ns[i * rounds + round] = t;
                }
                j = j + (int64) 1;
            }
            round = round + (int64) 1;
        }
        tm.destroy();
        int64 best = (int64) 0;
        int64 bestT = (int64) -1;
        int64 i = (int64) 0;
        while (i < nc) {
            if (!refused[i]) {
                int64 a = ns[i * rounds];
                int64 b = ns[i * rounds + (int64) 1];
                int64 c = ns[i * rounds + (int64) 2];
                int64 med = a;
                if ((b <= a && a <= c) || (c <= a && a <= b)) { med = a; }
                else if ((a <= b && b <= c) || (c <= b && b <= a)) { med = b; }
                else { med = c; }
                if (bestT < (int64) 0 || med < bestT) {
                    bestT = med;
                    best = cands[i];
                }
            }
            i = i + (int64) 1;
        }
        GpuHistogram.tuneCount = GpuHistogram.tuneCount + (int64) 1;
        return best;
    }

    @Kernel
    public static void histScatter(KernelBuffer<int64> hist,
                                   KernelBuffer<int32> bins,
                                   KernelBuffer<int32> cutOff,
                                   KernelBuffer<int64> q,
                                   KernelBuffer<int32> pos,
                                   int32 nid, uint32 n, uint32 nf) {
        uint32 i = KernelThread.globalIdX();
        if (i < n * nf) {
            uint32 r = i / nf;
            if (pos[r] == nid) {
                int32 b = bins[i];
                if (b >= 0) {
                    uint32 f = i - r * nf;
                    uint32 gb = ((uint32) cutOff[f] + (uint32) b) * 2;
                    hist.atomicAdd(gb, q[r * 2]);
                    hist.atomicAdd(gb + 1, q[r * 2 + 1]);
                }
            }
        }
    }

    /**
     * Node histogram over a row segment: one thread per (segment row, feature)
     * cell, the same integer atomics as histScatter, into the slot at word
     * `base`. The node's totals land in the two words after the bins.
     */
    @Kernel
    public static void histSegment(KernelBuffer<int64> hist,
                                   KernelBuffer<int32> bins,
                                   KernelBuffer<int32> cutOff,
                                   KernelBuffer<int64> q,
                                   KernelBuffer<int32> ridx,
                                   uint32 base, uint32 begin, uint32 count, uint32 nf, uint32 nbins) {
        uint32 i = KernelThread.globalIdX();
        if (i < count * nf) {
            uint32 slot = i / nf;
            uint32 f = i - slot * nf;
            uint32 r = (uint32) ridx[begin + slot];
            if (f == 0) {
                hist.atomicAdd(base + nbins * 2, q[r * 2]);
                hist.atomicAdd(base + nbins * 2 + 1, q[r * 2 + 1]);
            }
            int32 b = bins[r * nf + f];
            if (b >= 0) {
                uint32 gb = base + ((uint32) cutOff[f] + (uint32) b) * 2;
                hist.atomicAdd(gb, q[r * 2]);
                hist.atomicAdd(gb + 1, q[r * 2 + 1]);
            }
        }
    }

    /** Zeroes words `[base, base + n)` of `buf`. */
    @Kernel
    public static void zeroRange(KernelBuffer<int64> buf, uint32 base, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { buf[base + i] = (int64) 0; }
    }

    /** Sibling subtraction over one slot: `store[out + i] = store[parent + i] - store[built + i]`. */
    @Kernel
    public static void subtractSlot(KernelBuffer<int64> store, uint32 parent, uint32 built,
                                    uint32 out, uint32 words) {
        uint32 i = KernelThread.globalIdX();
        if (i < words) { store[out + i] = store[parent + i] - store[built + i]; }
    }

    /** Copies the first `n` words of `src` into `dst`. */
    @Kernel
    public static void copyWords(KernelBuffer<int64> dst, KernelBuffer<int64> src, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { dst[i] = src[i]; }
    }

    /** Zeroes the first `n` words of `buf`. */
    @Kernel
    public static void zeroWords(KernelBuffer<int64> buf, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { buf[i] = (int64) 0; }
    }

    /**
     * Per split `j` of a level: the smaller child is built in the new slot of
     * `slotTab` (parent base, new base, first cell, first tile) and the larger derived in the
     * parent's; `plan` gets built base, begin, count and derived base, and `bases`
     * the two children's slot bases, left then right.
     */
    @Kernel
    public static void childSlots(KernelBuffer<int64> plan, KernelBuffer<int64> bases,
                                  KernelBuffer<int64> slotTab, KernelBuffer<int64> lefts,
                                  KernelBuffer<int32> tab, uint32 splits) {
        uint32 j = KernelThread.globalIdX();
        if (j < splits) {
            int64 left = lefts[j];
            int64 count = (int64) tab[j * 6 + 1];
            int64 begin = (int64) tab[j * 6];
            int64 parent = slotTab[j * 4];
            int64 fresh = slotTab[j * 4 + 1];
            plan[j * 4] = fresh;
            plan[j * 4 + 3] = parent;
            if (left <= count - left) {
                plan[j * 4 + 1] = begin;
                plan[j * 4 + 2] = left;
                bases[j * 2] = fresh;
                bases[j * 2 + 1] = parent;
            } else {
                plan[j * 4 + 1] = begin + left;
                plan[j * 4 + 2] = count - left;
                bases[j * 2] = parent;
                bases[j * 2 + 1] = fresh;
            }
        }
    }

    /** Zeroes the built slot of every split in `plan`. */
    @Kernel
    public static void zeroLevel(KernelBuffer<int64> store, KernelBuffer<int64> plan,
                                 uint32 splits, uint32 words) {
        uint32 i = KernelThread.globalIdX();
        if (i < splits * words) {
            uint32 j = i / words;
            store[(uint32) plan[j * 4] + (i - j * words)] = (int64) 0;
        }
    }

    /**
     * histSegment over every built child of a level: cell `i` belongs to the last
     * split whose first cell in `slotTab` is at most `i`, and cells past the
     * child's rows do nothing.
     */
    @Kernel
    public static void histLevel(KernelBuffer<int64> hist, KernelBuffer<int32> bins,
                                 KernelBuffer<int32> cutOff, KernelBuffer<int64> q,
                                 KernelBuffer<int32> ridx, KernelBuffer<int64> plan,
                                 KernelBuffer<int64> slotTab, uint32 splits, uint32 cells,
                                 uint32 nf, uint32 nbins) {
        uint32 i = KernelThread.globalIdX();
        if (i < cells) {
            uint32 lo = 0;
            uint32 hi = splits;
            while (hi - lo > 1) {
                uint32 mid = (lo + hi) / 2;
                if ((uint32) slotTab[mid * 4 + 2] <= i) { lo = mid; } else { hi = mid; }
            }
            uint32 local = i - (uint32) slotTab[lo * 4 + 2];
            uint32 slot = local / nf;
            if (slot < (uint32) plan[lo * 4 + 2]) {
                uint32 f = local - slot * nf;
                uint32 base = (uint32) plan[lo * 4];
                uint32 r = (uint32) ridx[(uint32) plan[lo * 4 + 1] + slot];
                if (f == 0) {
                    hist.atomicAdd(base + nbins * 2, q[r * 2]);
                    hist.atomicAdd(base + nbins * 2 + 1, q[r * 2 + 1]);
                }
                int32 b = bins[r * nf + f];
                if (b >= 0) {
                    uint32 gb = base + ((uint32) cutOff[f] + (uint32) b) * 2;
                    hist.atomicAdd(gb, q[r * 2]);
                    hist.atomicAdd(gb + 1, q[r * 2 + 1]);
                }
            }
        }
    }

    /** The derived slot of every split in `plan`, in place: parent minus built. */
    @Kernel
    public static void subtractLevel(KernelBuffer<int64> store, KernelBuffer<int64> plan,
                                     uint32 splits, uint32 words) {
        uint32 i = KernelThread.globalIdX();
        if (i < splits * words) {
            uint32 j = i / words;
            uint32 k = i - j * words;
            uint32 out = (uint32) plan[j * 4 + 3] + k;
            store[out] = store[out] - store[(uint32) plan[j * 4] + k];
        }
    }

    /** Builds the smaller child of each split of a level and derives the larger, with no sync: by
     *  `tiles` shared tiles when there are feature groups, else by global atomics over `cells`. */
    static void buildLevel(KernelBuffer<int64> store, KernelBuffer<int32> bins,
                           KernelBuffer<int32> cutOff, KernelBuffer<int64> q,
                           KernelBuffer<int32> ridx, KernelBuffer<int32> tab,
                           KernelBuffer<int64> lefts, KernelBuffer<int64> slotTab,
                           KernelBuffer<int64> plan, KernelBuffer<int64> bases,
                           KernelBuffer<int32> tileSplit, KernelBuffer<int32> groups,
                           int64 ngroups, int64 tiles, int64 rows,
                           int64 splits, int64 cells, int64 nf, int64 nbins) {
        KernelStream s #= KernelStream.current();
        uint32 us = (uint32) splits;
        uint32 words = (uint32) ((int64) 2 * nbins + (int64) 2);
        uint32 all = us * words;
        uint32 uc = (uint32) cells;
        childSlots.launch(s, grid: [(us + 63) / 64], block: [64])(plan, bases, slotTab, lefts, tab, us);
        zeroLevel.launch(s, grid: [(all + 255) / 256], block: [256])(store, plan, us, words);
        if (ngroups > (int64) 0) {
            uint32 ut = (uint32) tiles;
            if (ut > 0) {
                levelTiles.launch(s, grid: [us], block: [256])(tileSplit, slotTab, tab, (uint32) rows);
                histTiles.launch(s, grid: [ut, (uint32) ngroups], block: [256])
                    (store, bins, cutOff, q, ridx, plan, slotTab, tileSplit, groups, (uint32) 1,
                     (uint32) 0, (uint32) 0, (uint32) 0, (uint32) rows, (uint32) nf, (uint32) nbins);
            }
        } else if (uc > 0) {
            histLevel.launch(s, grid: [(uc + 63) / 64], block: [64])
                (store, bins, cutOff, q, ridx, plan, slotTab, us, uc, (uint32) nf, (uint32) nbins);
        }
        subtractLevel.launch(s, grid: [(all + 255) / 256], block: [256])(store, plan, us, words);
        return;
    }

    /** Derives the slot at `out` as the slot at `parent` minus the slot at `built`, and waits. */
    static void subtract(KernelBuffer<int64> store, int64 parent, int64 built, int64 out,
                         int64 words, TransferLog log) {
        KernelStream s #= KernelStream.current();
        uint32 w = (uint32) words;
        subtractSlot.launch(s, grid: [(w + 255) / 256], block: [256])
            (store, (uint32) parent, (uint32) built, (uint32) out, w);
        log.sync(s);
        return;
    }

    /** Copies the first `n` words of `src` into `dst`, and waits. */
    static void copyInto(KernelBuffer<int64> dst, KernelBuffer<int64> src, int64 n, TransferLog log) {
        KernelStream s #= KernelStream.current();
        uint32 un = (uint32) n;
        copyWords.launch(s, grid: [(un + 255) / 256], block: [256])(dst, src, un);
        log.sync(s);
        return;
    }

    /**
     * Builds the histogram of the segment `[begin, begin + count)` of `ridx` into
     * the slot of `hist` at word `base` (`2 * nbins + 2` words: G and H per bin,
     * then the totals) and waits.
     */
    static void buildSegment(KernelBuffer<int64> hist, int64 base, KernelBuffer<int32> bins,
                             KernelBuffer<int32> cutOff, KernelBuffer<int64> q,
                             KernelBuffer<int32> ridx, int64 begin, int64 count,
                             int64 nf, int64 nbins, TransferLog log) {
        KernelStream s #= KernelStream.current();
        uint32 words = (uint32) ((int64) 2 * nbins + (int64) 2);
        zeroRange.launch(s, grid: [(words + 255) / 256], block: [256])(hist, (uint32) base, words);
        uint32 cells = (uint32) (count * nf);
        if (cells > 0) {
            histSegment.launch(s, grid: [(cells + 63) / 64], block: [64])
                (hist, bins, cutOff, q, ridx, (uint32) base, (uint32) begin, (uint32) count,
                 (uint32) nf, (uint32) nbins);
        }
        log.sync(s);
        return;
    }

    /**
     * Build node `nid`'s histogram over the rows `position[r] == nid` — the
     * GPU analog of {@link Histogram#buildPos}, same result bit for bit.
     * Node totals are host-side int64 sums in ascending row order, exactly
     * the CPU builder's order.
     */
    public static #Histogram buildPos(Tensor<int32> bins, Tensor<int64> cutPtrs,
                                      GradientQuantiser quant,
                                      float64[] grad, float64[] hess,
                                      int64[] position, int64 nid, int64 n) {
        int64 nf = cutPtrs.shapeAt(0) - (int64) 1;
        int64 nbins = cutPtrs.flatGet(nf);

        // Host-side quantization (the CPU builder's own path); totals
        // accumulate here in CPU row order.
        int64[] qFixed = heap int64[n * (int64) 2];
        int32[] posH = heap int32[n];
        int64 totG = (int64) 0;
        int64 totH = (int64) 0;
        int64 r = (int64) 0;
        while (r < n) {
            int64 qg = quant.fixedGrad(grad[r]);
            int64 qh = quant.fixedHess(hess[r]);
            if (position[r] == nid) {
                totG = totG + qg;
                totH = totH + qh;
            }
            qFixed[r * (int64) 2]             = qg;
            qFixed[r * (int64) 2 + (int64) 1] = qh;
            posH[r] = (int32) position[r];
            r = r + (int64) 1;
        }
        int32[] binsH = heap int32[n * nf];
        int64 c = (int64) 0;
        while (c < n * nf) {
            binsH[c] = bins.flatGet(c);
            c = c + (int64) 1;
        }
        int32[] cutOffH = heap int32[nf];
        int64 f = (int64) 0;
        while (f < nf) {
            cutOffH[f] = (int32) cutPtrs.flatGet(f);
            f = f + (int64) 1;
        }

        KernelStream s #= KernelStream.current();
        KernelBuffer<int64> dHist = heap KernelBuffer<int64>((int64) 2 * nbins);
        KernelBuffer<int32> dBins = heap KernelBuffer<int32>(n * nf);
        KernelBuffer<int32> dCut = heap KernelBuffer<int32>(nf);
        KernelBuffer<int64> dQ = heap KernelBuffer<int64>(n * (int64) 2);
        KernelBuffer<int32> dPos = heap KernelBuffer<int32>(n);
        int64[] zeros = heap int64[(int64) 2 * nbins];
        dHist.upload(zeros);
        dBins.upload(binsH);
        dCut.upload(cutOffH);
        dQ.upload(qFixed);
        dPos.upload(posH);

        uint32 cells = (uint32) (n * nf);
        histScatter.launch(s, grid: [(cells + 63) / 64], block: [64])
            (dHist, dBins, dCut, dQ, dPos, (int32) nid, (uint32) n, (uint32) nf);
        s.sync();

        int64[] words = heap int64[(int64) 2 * nbins];
        dHist.download(words);

        int64[] gg = heap int64[nbins];
        int64[] hh = heap int64[nbins];
        int64 b = (int64) 0;
        while (b < nbins) {
            gg[b] = words[b * (int64) 2];
            hh[b] = words[b * (int64) 2 + (int64) 1];
            b = b + (int64) 1;
        }
        return heap Histogram(#gg, #hh, nbins, nf, totG, totH);
    }

    /** Root histogram over all rows — the GPU analog of {@link Histogram#buildAll}. */
    public static #Histogram buildAll(Tensor<int32> bins, Tensor<int64> cutPtrs,
                                      GradientQuantiser quant,
                                      float64[] grad, float64[] hess, int64 n) {
        int64[] position = heap int64[n];
        return GpuHistogram.buildPos(bins, cutPtrs, quant, grad, hess,
                                     position, (int64) 0, n);
    }
}
