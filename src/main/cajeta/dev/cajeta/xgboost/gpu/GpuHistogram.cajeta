package dev.cajeta.xgboost.gpu;

import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;
import dev.cajeta.xgboost.tree.GradientQuantiser;
import dev.cajeta.xgboost.tree.Histogram;

/**
 * The GPU gradient histogram (plan U12, spec §8.1): the same int64
 * fixed-point per-(feature, global-bin) sums as {@link Histogram}, built by
 * a `cajeta.xpu` kernel — one thread per (row, feature) cell, scattering
 * the row's quantized gpair into its bin with integer atomics.
 *
 * **Why this is bit-identical on every backend.** Quantization happens on
 * the HOST through the same {@link GradientQuantiser} the CPU builder uses,
 * so the kernel is integer-only. Integer addition is associative and
 * commutative, so atomic scatter order — which varies freely between
 * backends, wave sizes, and runs — cannot change the sums. That is XGBoost's
 * own determinism argument for its GPU histogram, reproduced.
 *
 * Each sum is a single native int64 `atomicAdd` (toolchain ≥ v0.17.4:
 * Int64Atomics on Vulkan, native 64-bit atomics on CUDA/HIP/CPU). Earlier
 * versions of this kernel accumulated each int64 as two uint32 words with an
 * explicit atomic carry — the pre-sm_60 CUDA idiom; the native form is the
 * same exact sum with a third of the atomics traffic.
 *
 * Layout: `hist` is `[2 * nbins]` int64 — `gb*2 + {0: G, 1: H}`; `q` is
 * `[2 * n]` int64 — `r*2 + {qg, qh}`. Missing values (`bin == -1`) are
 * skipped exactly as on the CPU.
 */
public final class GpuHistogram {

    @Kernel
    public static void histScatter(KernelBuffer<int64> hist,
                                   KernelBuffer<int32> bins,
                                   KernelBuffer<int32> cutOff,
                                   KernelBuffer<int64> q,
                                   KernelBuffer<int32> pos,
                                   int32 nid, uint32 n, uint32 nf) {
        uint32 i = KernelThread.globalIdX();
        if (i < n * nf) {
            uint32 r = i / nf;
            if (pos[r] == nid) {
                int32 b = bins[i];
                if (b >= 0) {
                    uint32 f = i - r * nf;
                    uint32 gb = ((uint32) cutOff[f] + (uint32) b) * 2;
                    hist.atomicAdd(gb, q[r * 2]);
                    hist.atomicAdd(gb + 1, q[r * 2 + 1]);
                }
            }
        }
    }

    /**
     * Node histogram over a row segment: one thread per (segment row, feature)
     * cell, the same integer atomics as histScatter, into the slot at word
     * `base`. The node's totals land in the two words after the bins.
     */
    @Kernel
    public static void histSegment(KernelBuffer<int64> hist,
                                   KernelBuffer<int32> bins,
                                   KernelBuffer<int32> cutOff,
                                   KernelBuffer<int64> q,
                                   KernelBuffer<int32> ridx,
                                   uint32 base, uint32 begin, uint32 count, uint32 nf, uint32 nbins) {
        uint32 i = KernelThread.globalIdX();
        if (i < count * nf) {
            uint32 slot = i / nf;
            uint32 f = i - slot * nf;
            uint32 r = (uint32) ridx[begin + slot];
            if (f == 0) {
                hist.atomicAdd(base + nbins * 2, q[r * 2]);
                hist.atomicAdd(base + nbins * 2 + 1, q[r * 2 + 1]);
            }
            int32 b = bins[r * nf + f];
            if (b >= 0) {
                uint32 gb = base + ((uint32) cutOff[f] + (uint32) b) * 2;
                hist.atomicAdd(gb, q[r * 2]);
                hist.atomicAdd(gb + 1, q[r * 2 + 1]);
            }
        }
    }

    /** Zeroes words `[base, base + n)` of `buf`. */
    @Kernel
    public static void zeroRange(KernelBuffer<int64> buf, uint32 base, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { buf[base + i] = (int64) 0; }
    }

    /** Sibling subtraction over one slot: `store[out + i] = store[parent + i] - store[built + i]`. */
    @Kernel
    public static void subtractSlot(KernelBuffer<int64> store, uint32 parent, uint32 built,
                                    uint32 out, uint32 words) {
        uint32 i = KernelThread.globalIdX();
        if (i < words) { store[out + i] = store[parent + i] - store[built + i]; }
    }

    /** Copies the first `n` words of `src` into `dst`. */
    @Kernel
    public static void copyWords(KernelBuffer<int64> dst, KernelBuffer<int64> src, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { dst[i] = src[i]; }
    }

    /** Zeroes the first `n` words of `buf`. */
    @Kernel
    public static void zeroWords(KernelBuffer<int64> buf, uint32 n) {
        uint32 i = KernelThread.globalIdX();
        if (i < n) { buf[i] = (int64) 0; }
    }

    /**
     * Builds the histogram of the segment `[begin, begin + count)` of `ridx` into
     * the slot of `hist` at word `base` (`2 * nbins + 2` words: G and H per bin,
     * then the totals) and waits.
     */
    /** Derives the slot at `out` as the slot at `parent` minus the slot at `built`, and waits. */
    static void subtract(KernelBuffer<int64> store, int64 parent, int64 built, int64 out,
                         int64 words, TransferLog log) {
        KernelStream s #= KernelStream.current();
        uint32 w = (uint32) words;
        subtractSlot.launch(s, grid: [(w + 255) / 256], block: [256])
            (store, (uint32) parent, (uint32) built, (uint32) out, w);
        log.sync(s);
        return;
    }

    /** Copies the first `n` words of `src` into `dst`, and waits. */
    static void copyInto(KernelBuffer<int64> dst, KernelBuffer<int64> src, int64 n, TransferLog log) {
        KernelStream s #= KernelStream.current();
        uint32 un = (uint32) n;
        copyWords.launch(s, grid: [(un + 255) / 256], block: [256])(dst, src, un);
        log.sync(s);
        return;
    }

    static void buildSegment(KernelBuffer<int64> hist, int64 base, KernelBuffer<int32> bins,
                             KernelBuffer<int32> cutOff, KernelBuffer<int64> q,
                             KernelBuffer<int32> ridx, int64 begin, int64 count,
                             int64 nf, int64 nbins, TransferLog log) {
        KernelStream s #= KernelStream.current();
        uint32 words = (uint32) ((int64) 2 * nbins + (int64) 2);
        zeroRange.launch(s, grid: [(words + 255) / 256], block: [256])(hist, (uint32) base, words);
        uint32 cells = (uint32) (count * nf);
        if (cells > 0) {
            histSegment.launch(s, grid: [(cells + 63) / 64], block: [64])
                (hist, bins, cutOff, q, ridx, (uint32) base, (uint32) begin, (uint32) count,
                 (uint32) nf, (uint32) nbins);
        }
        log.sync(s);
        return;
    }

    /**
     * Build node `nid`'s histogram over the rows `position[r] == nid` — the
     * GPU analog of {@link Histogram#buildPos}, same result bit for bit.
     * Node totals are host-side int64 sums in ascending row order, exactly
     * the CPU builder's order.
     */
    public static #Histogram buildPos(Tensor<int32> bins, Tensor<int64> cutPtrs,
                                      GradientQuantiser quant,
                                      float64[] grad, float64[] hess,
                                      int64[] position, int64 nid, int64 n) {
        int64 nf = cutPtrs.shapeAt(0) - (int64) 1;
        int64 nbins = cutPtrs.flatGet(nf);

        // Host-side quantization (the CPU builder's own path); totals
        // accumulate here in CPU row order.
        int64[] qFixed = heap int64[n * (int64) 2];
        int32[] posH = heap int32[n];
        int64 totG = (int64) 0;
        int64 totH = (int64) 0;
        int64 r = (int64) 0;
        while (r < n) {
            int64 qg = quant.fixedGrad(grad[r]);
            int64 qh = quant.fixedHess(hess[r]);
            if (position[r] == nid) {
                totG = totG + qg;
                totH = totH + qh;
            }
            qFixed[r * (int64) 2]             = qg;
            qFixed[r * (int64) 2 + (int64) 1] = qh;
            posH[r] = (int32) position[r];
            r = r + (int64) 1;
        }
        int32[] binsH = heap int32[n * nf];
        int64 c = (int64) 0;
        while (c < n * nf) {
            binsH[c] = bins.flatGet(c);
            c = c + (int64) 1;
        }
        int32[] cutOffH = heap int32[nf];
        int64 f = (int64) 0;
        while (f < nf) {
            cutOffH[f] = (int32) cutPtrs.flatGet(f);
            f = f + (int64) 1;
        }

        KernelStream s #= KernelStream.current();
        KernelBuffer<int64> dHist = heap KernelBuffer<int64>((int64) 2 * nbins);
        KernelBuffer<int32> dBins = heap KernelBuffer<int32>(n * nf);
        KernelBuffer<int32> dCut = heap KernelBuffer<int32>(nf);
        KernelBuffer<int64> dQ = heap KernelBuffer<int64>(n * (int64) 2);
        KernelBuffer<int32> dPos = heap KernelBuffer<int32>(n);
        int64[] zeros = heap int64[(int64) 2 * nbins];
        dHist.upload(zeros);
        dBins.upload(binsH);
        dCut.upload(cutOffH);
        dQ.upload(qFixed);
        dPos.upload(posH);

        uint32 cells = (uint32) (n * nf);
        histScatter.launch(s, grid: [(cells + 63) / 64], block: [64])
            (dHist, dBins, dCut, dQ, dPos, (int32) nid, (uint32) n, (uint32) nf);
        s.sync();

        int64[] words = heap int64[(int64) 2 * nbins];
        dHist.download(words);

        int64[] gg = heap int64[nbins];
        int64[] hh = heap int64[nbins];
        int64 b = (int64) 0;
        while (b < nbins) {
            gg[b] = words[b * (int64) 2];
            hh[b] = words[b * (int64) 2 + (int64) 1];
            b = b + (int64) 1;
        }
        return heap Histogram(#gg, #hh, nbins, nf, totG, totH);
    }

    /** Root histogram over all rows — the GPU analog of {@link Histogram#buildAll}. */
    public static #Histogram buildAll(Tensor<int32> bins, Tensor<int64> cutPtrs,
                                      GradientQuantiser quant,
                                      float64[] grad, float64[] hess, int64 n) {
        int64[] position = heap int64[n];
        return GpuHistogram.buildPos(bins, cutPtrs, quant, grad, hess,
                                     position, (int64) 0, n);
    }
}
