package dev.cajeta.xgboost.gpu;

import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import cajeta.xpu.KernelThread;

/** The leaf update on the device: each row's leaf value added to its margin, read from the leaves' segments. */
final class GpuLeaves {

    /**
     * Position `p` of `ridx` belongs to the last leaf of `tab` (segment begin,
     * float32 value bits; ascending begins) whose begin is at most `p`; its row's
     * margin of `group` gains that leaf's value in float32.
     */
    @Kernel
    public static void addLeaves(KernelBuffer<float32> margins, KernelBuffer<int32> ridx,
                                 KernelBuffer<int64> tab, uint32 leaves, uint32 n,
                                 uint32 groups, uint32 group) {
        uint32 p = KernelThread.globalIdX();
        if (p < n) {
            uint32 lo = 0;
            uint32 hi = leaves;
            while (hi - lo > 1) {
                uint32 mid = (lo + hi) / 2;
                if ((uint32) tab[mid * 2] <= p) { lo = mid; } else { hi = mid; }
            }
            uint32 i = (uint32) ridx[p] * groups + group;
            margins[i] = margins[i] + Cajeta.bitsToF32((int32) tab[lo * 2 + 1]);
        }
    }

    /** Launches the leaf update over `n` rows and `leaves` table entries, with no sync. */
    static void add(KernelBuffer<float32> margins, KernelBuffer<int32> ridx, KernelBuffer<int64> tab,
                    int64 leaves, int64 n, int64 groups, int64 group) {
        KernelStream s #= KernelStream.current();
        uint32 un = (uint32) n;
        addLeaves.launch(s, grid: [(un + 255) / 256], block: [256])
            (margins, ridx, tab, (uint32) leaves, un, (uint32) groups, (uint32) group);
        return;
    }
}
