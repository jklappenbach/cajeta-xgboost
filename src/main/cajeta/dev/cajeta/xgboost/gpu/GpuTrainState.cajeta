package dev.cajeta.xgboost.gpu;

import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import cajeta.xpu.KernelStream;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.tree.GradientQuantiser;
import dev.cajeta.xgboost.tree.Split;

/**
 * The device side of a fit: the bin matrix, uploaded once or binned on the
 * device ({@link #fromValues}); the labels, margins and gradient pairs
 * ({@link #beginFit}); the quantized pairs, uploaded once per tree; and `ridx`,
 * in which each node's rows are one contiguous segment in ascending row order.
 * Every upload, download and sync is counted in the fit's transfer log.
 *
 * Bit-identical to the CPU builder: the partition is a stable function of
 * each row's own bin, and the histograms are integer atomics, which commute.
 */
public final class GpuTrainState {

    KernelBuffer<int32> bins;
    KernelBuffer<int32> cutOff;
    KernelBuffer<int64> q;
    KernelBuffer<int32> ridx;
    KernelBuffer<int32> scratch;
    KernelBuffer<int32> blockCounts;
    KernelBuffer<int64> store;
    KernelBuffer<float64> labels;
    KernelBuffer<float32> margins;
    KernelBuffer<float32> gradG;
    KernelBuffer<float32> gradH;
    KernelBuffer<int32> cutPtr;
    KernelBuffer<int64> slotBase;
    KernelBuffer<float32> evalGain;
    KernelBuffer<int32> evalMeta;
    KernelBuffer<int64> evalStats;
    KernelBuffer<int64> evalRec;
    int64 evalCap;
    KernelBuffer<int64> qWords;
    KernelBuffer<float64> qSums;
    KernelBuffer<int32> levelTab;
    KernelBuffer<int32> blockSplit;
    KernelBuffer<int64> lefts;
    KernelBuffer<int64> slotTab;
    KernelBuffer<int64> plan;
    KernelBuffer<int64> leafTab;
    int64[] leafTabH;
    TransferLog log;
    int32[] tabH;
    int64[] slotTabH;
    int64[] leftsH;
    int64[] lvParent;
    int64[] lvLeft;
    int64[] lvRight;
    int64[] lvFresh;
    int64[] lvParentSlot;
    int64 lvCount;
    int64 lvBlocks;
    int64 lvCells;
    boolean lvPending;
    boolean lvBuilt;
    int32[] blockH;
    int64[] histWords;
    int64 slotWords;
    int64 slotCap;
    int64[] slotOf;
    int64[] freeSlots;
    int64 freeTop;
    int64 slotsLive;
    int64 slotsPeak;
    int64[] qFixed;
    int64[] segBegin;
    int64[] segCount;
    int64 n;
    int64 nf;
    int64 nbins;
    int64 groups;
    int64 group;
    boolean deviceGrads;

    GpuTrainState(Tensor<int64> cutPtrs, int64 n) {
        this.n = n;
        this.nf = cutPtrs.shapeAt(0) - (int64) 1;
        this.nbins = cutPtrs.flatGet(this.nf);
        int32[] cutH = heap int32[this.nf];
        int64 f = (int64) 0;
        while (f < this.nf) {
            cutH[f] = (int32) cutPtrs.flatGet(f);
            f = f + (int64) 1;
        }
        int64 blocks = (n + GpuPartition.segmentBlock() - (int64) 1) / GpuPartition.segmentBlock();
        this.bins = heap KernelBuffer<int32>(n * this.nf);
        this.cutOff = heap KernelBuffer<int32>(this.nf);
        this.q = heap KernelBuffer<int64>(n * (int64) 2);
        this.ridx = heap KernelBuffer<int32>(n);
        this.scratch = heap KernelBuffer<int32>(n);
        this.blockCounts = heap KernelBuffer<int32>(blocks);
        this.slotWords = (int64) 2 * this.nbins + (int64) 2;
        this.slotCap = (int64) 4;
        this.store = heap KernelBuffer<int64>(this.slotCap * this.slotWords);
        this.freeSlots = heap int64[this.slotCap];
        this.slotOf = heap int64[1];
        this.blockH = heap int32[blocks];
        this.histWords = heap int64[(int64) 2 * this.nbins + (int64) 2];
        this.qFixed = heap int64[n * (int64) 2];
        this.segBegin = heap int64[1];
        this.segCount = heap int64[1];
        this.log = heap TransferLog();
        this.qWords = heap KernelBuffer<int64>((int64) 8 * GpuQuantiser.words() + (int64) 1);
        this.qSums = heap KernelBuffer<float64>((int64) 4);
        this.cutOff.upload(cutH);
        int32[] ptrH = heap int32[this.nf + (int64) 1];
        f = (int64) 0;
        while (f <= this.nf) { ptrH[f] = (int32) cutPtrs.flatGet(f); f = f + (int64) 1; }
        this.cutPtr = heap KernelBuffer<int32>(this.nf + (int64) 1);
        this.cutPtr.upload(ptrH);
        this.log.upSmalls((int64) 2);
    }

    /** A run's device state over `n` rows of `bins`; the bin matrix is uploaded here, once. */
    public static #GpuTrainState create(Tensor<int32> bins, Tensor<int64> cutPtrs, int64 n) {
        GpuTrainState st = heap GpuTrainState(cutPtrs, n);
        int64 cells = n * st.nf;
        int32[] binsH = heap int32[cells];
        int32[] hb = bins.hostBuffer();
        int64 ho = bins.hostBase();
        int64 c = (int64) 0;
        while (c < cells) {
            binsH[c] = hb[ho + c];
            c = c + (int64) 1;
        }
        st.bins.upload(binsH);
        st.log.upCell();
        return #st;
    }

    /**
     * A run's device state over the raw `[n, nf]` values `x`: the values go up
     * once as float32 and are binned on the device by `cuts` (`cutPtrs`
     * offsets), so no bin matrix crosses the bus.
     */
    public static #GpuTrainState fromValues(Tensor<float64> x, Tensor<int64> cutPtrs, float32[] cuts, int64 n) {
        GpuTrainState st = heap GpuTrainState(cutPtrs, n);
        int64 nf = st.nf;
        int64 cells = n * nf;
        int32[] bits #= GpuBinner.valueBits(x, n, nf);
        KernelBuffer<int32> vals = heap KernelBuffer<int32>(cells);
        vals.upload(bits);
        st.log.upCell();
        int64 total = cutPtrs.flatGet(nf);
        int32[] cutBits = heap int32[total];
        int64 c = (int64) 0;
        while (c < total) {
            cutBits[c] = Cajeta.f32ToBits(cuts[c]);
            c = c + (int64) 1;
        }
        int32[] ptrH = heap int32[nf + (int64) 1];
        int64 f = (int64) 0;
        while (f <= nf) {
            ptrH[f] = (int32) cutPtrs.flatGet(f);
            f = f + (int64) 1;
        }
        KernelBuffer<int32> cutsD = heap KernelBuffer<int32>(total);
        KernelBuffer<int32> ptrD = heap KernelBuffer<int32>(nf + (int64) 1);
        cutsD.upload(cutBits);
        ptrD.upload(ptrH);
        st.log.upSmalls((int64) 2);
        GpuBinner.binInto(st.bins, vals, cutsD, ptrD, cells, nf, st.log);
        return #st;
    }

    /** The device bin matrix, downloaded; a test hook. */
    public #int32[] deviceBins() {
        int32[] out = heap int32[this.n * this.nf];
        this.bins.download(out);
        this.log.downCell();
        return #out;
    }

    /**
     * Starts a fit of `groups` output groups over `label`: uploads the labels
     * and the `base` margins once, and allocates the gradient pairs.
     */
    public void beginFit(float64[] label, float32 base, int64 groups) {
        this.groups = groups;
        int64 rows = this.n * groups;
        float32[] m = heap float32[rows];
        int64 i = (int64) 0;
        while (i < rows) { m[i] = base; i = i + (int64) 1; }
        this.labels = heap KernelBuffer<float64>(this.n);
        this.margins = heap KernelBuffer<float32>(rows);
        this.gradG = heap KernelBuffer<float32>(rows);
        this.gradH = heap KernelBuffer<float32>(rows);
        this.labels.upload(label, this.n);
        this.log.upRow();
        this.margins.upload(m);
        this.log.upRow();
    }

    /**
     * Starts a tree of up to `cap` nodes: uploads this tree's quantized
     * gradient pairs and makes the root's segment every row.
     */
    public void beginTree(GradientQuantiser quant, float64[] grad, float64[] hess, int64 cap) {
        int64 r = (int64) 0;
        while (r < this.n) {
            this.qFixed[r * (int64) 2] = quant.fixedGrad(grad[r]);
            this.qFixed[r * (int64) 2 + (int64) 1] = quant.fixedHess(hess[r]);
            r = r + (int64) 1;
        }
        this.log.beginTree();
        this.q.upload(this.qFixed);
        this.log.upRow();
        this.startTree(cap);
    }

    /** The root's segment is every row, and every histogram slot is free. */
    void startTree(int64 cap) {
        GpuPartition.resetSegments(this.ridx, this.n, this.log);
        if ((int64) this.segBegin.count() < cap) {
            this.segBegin = heap int64[cap];
            this.segCount = heap int64[cap];
        }
        if ((int64) this.slotOf.count() < cap) { this.slotOf = heap int64[cap]; }
        if (this.lvParent == null || (int64) this.lvParent.count() < cap) { this.sizeLevel(cap); }
        this.lvCount = (int64) 0;
        this.lvBlocks = (int64) 0;
        this.lvCells = (int64) 0;
        this.lvPending = false;
        this.lvBuilt = false;
        int64 i = (int64) 0;
        while (i < (int64) this.slotOf.count()) { this.slotOf[i] = (int64) -1; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < this.slotCap) { this.freeSlots[i] = this.slotCap - (int64) 1 - i; i = i + (int64) 1; }
        this.freeTop = this.slotCap;
        this.slotsLive = (int64) 0;
        this.segBegin[0] = (int64) 0;
        this.segCount[0] = this.n;
    }

    /** Sizes the level tables for up to `cap` splits of a level. */
    void sizeLevel(int64 cap) {
        int64 blocks = (this.n + GpuPartition.segmentBlock() - (int64) 1) / GpuPartition.segmentBlock();
        this.blockCounts = heap KernelBuffer<int32>(blocks + cap);
        this.blockSplit = heap KernelBuffer<int32>(blocks + cap);
        this.levelTab = heap KernelBuffer<int32>(cap * GpuPartition.tableWords());
        this.lefts = heap KernelBuffer<int64>(cap);
        this.slotTab = heap KernelBuffer<int64>(cap * (int64) 3);
        this.plan = heap KernelBuffer<int64>(cap * (int64) 4);
        this.leafTab = heap KernelBuffer<int64>(cap * (int64) 2);
        this.leafTabH = heap int64[cap * (int64) 2];
        this.tabH = heap int32[cap * GpuPartition.tableWords()];
        this.slotTabH = heap int64[cap * (int64) 3];
        this.leftsH = heap int64[cap];
        this.lvParent = heap int64[cap];
        this.lvLeft = heap int64[cap];
        this.lvRight = heap int64[cap];
        this.lvFresh = heap int64[cap];
        this.lvParentSlot = heap int64[cap];
    }

    /** Node `nid`'s slot, taking a free one if it has none. */
    int64 slotFor(int64 nid) {
        if (this.slotOf[nid] >= (int64) 0) { return this.slotOf[nid]; }
        int64 slot = this.takeSlot();
        this.slotOf[nid] = slot;
        return slot;
    }

    /** A free slot, doubling the store when none is. */
    int64 takeSlot() {
        if (this.freeTop == (int64) 0) {
            int64 cap2 = this.slotCap * (int64) 2;
            KernelBuffer<int64> grown = heap KernelBuffer<int64>(cap2 * this.slotWords);
            GpuHistogram.copyInto(grown, this.store, this.slotCap * this.slotWords, this.log);
            this.store #= grown;
            int64[] free2 = heap int64[cap2];
            int64 i = (int64) 0;
            while (i < this.slotCap) { free2[i] = cap2 - (int64) 1 - i; i = i + (int64) 1; }
            this.freeSlots #= free2;
            this.freeTop = this.slotCap;
            this.slotCap = cap2;
        }
        this.freeTop = this.freeTop - (int64) 1;
        int64 slot = this.freeSlots[this.freeTop];
        this.slotsLive = this.slotsLive + (int64) 1;
        if (this.slotsLive > this.slotsPeak) { this.slotsPeak = this.slotsLive; }
        return slot;
    }

    /** Returns node `nid`'s slot to the pool. */
    public void release(int64 nid) {
        int64 slot = this.slotOf[nid];
        if (slot < (int64) 0) { return; }
        this.freeSlots[this.freeTop] = slot;
        this.freeTop = this.freeTop + (int64) 1;
        this.slotOf[nid] = (int64) -1;
        this.slotsLive = this.slotsLive - (int64) 1;
    }

    /** The most histogram slots held at once in this fit. */
    public int64 slotPeak() { return this.slotsPeak; }

    /** Downloads node `nid`'s slot into the host store slice at `base` and its totals. */
    void readSlot(int64 nid, int64[] histG, int64[] histH, int64[] totGof, int64[] totHof, int64 base) {
        KernelBuffer<int64> v #= this.store.slice((uint64) (this.slotOf[nid] * this.slotWords),
                                                  (uint64) this.slotWords);
        v.download(this.histWords);
        this.log.downSmalls((int64) 1);
        int64 b = (int64) 0;
        while (b < this.nbins) {
            histG[base + b] = this.histWords[b * (int64) 2];
            histH[base + b] = this.histWords[b * (int64) 2 + (int64) 1];
            b = b + (int64) 1;
        }
        totGof[nid] = this.histWords[this.nbins * (int64) 2];
        totHof[nid] = this.histWords[this.nbins * (int64) 2 + (int64) 1];
    }

    /** Node `nid`'s histogram, built into its slot from its segment. */
    public void buildSlot(int64 nid) {
        int64 slot = this.slotFor(nid);
        GpuHistogram.buildSegment(this.store, slot * this.slotWords, this.bins, this.cutOff, this.q,
                                  this.ridx, this.segBegin[nid], this.segCount[nid], this.nf,
                                  this.nbins, this.log);
    }

    /** Node `nid`'s histogram, built into its slot from its segment, then into the host store slice at `base`. */
    public void buildNode(int64 nid, int64[] histG, int64[] histH,
                          int64[] totGof, int64[] totHof, int64 base) {
        this.buildSlot(nid);
        this.readSlot(nid, histG, histH, totGof, totHof, base);
    }

    /** Node `nid`'s slot into the host store slice at `base` and its totals. */
    public void readNode(int64 nid, int64[] histG, int64[] histH, int64[] totGof, int64[] totHof,
                         int64 base) {
        this.readSlot(nid, histG, histH, totGof, totHof, base);
    }

    /** Node `derived`'s histogram as `parent` minus `built` on the device; `parent`'s slot returns to the pool. */
    public void deriveSlot(int64 parent, int64 built, int64 derived) {
        int64 out = this.slotFor(derived);
        GpuHistogram.subtract(this.store, this.slotOf[parent] * this.slotWords,
                              this.slotOf[built] * this.slotWords, out * this.slotWords,
                              this.slotWords, this.log);
        this.release(parent);
    }

    /**
     * Node `derived`'s histogram as `parent` minus `built` on the device, then into
     * the host store slice at `base`; `parent`'s slot returns to the pool.
     */
    public void deriveNode(int64 parent, int64 built, int64 derived, int64[] histG, int64[] histH,
                           int64[] totGof, int64[] totHof, int64 base) {
        int64 out = this.slotFor(derived);
        GpuHistogram.subtract(this.store, this.slotOf[parent] * this.slotWords,
                              this.slotOf[built] * this.slotWords, out * this.slotWords,
                              this.slotWords, this.log);
        this.readSlot(derived, histG, histH, totGof, totHof, base);
        this.release(parent);
    }

    /** Index of a record's node total G. */
    public static int64 recordTotalG() { return (int64) 9; }
    /** Index of a record's node total H. */
    public static int64 recordTotalH() { return (int64) 10; }

    /**
     * Evaluates the `count` nodes `nids` from their slots in one Stage A and one
     * Stage B launch, and answers their split records
     * (`GpuSplitFinder.recordWords()` each).
     */
    public #int64[] evaluate(int64[] nids, int64 count, GradientQuantiser q,
                             float64 lambda, float64 alpha, float64 minChildWeight) {
        boolean onDevice = this.lvPending && this.lvBuilt && this.childrenAre(nids, count);
        if (this.lvPending && !onDevice) { this.waitLevel(); }
        this.ensureEval(count);
        if (!onDevice) {
            int64[] bases = heap int64[count];
            int64 j = (int64) 0;
            while (j < count) {
                bases[j] = this.slotOf[nids[j]] * this.slotWords;
                j = j + (int64) 1;
            }
            this.slotBase.upload(bases, count);
            this.log.upSmalls((int64) 1);
        }
        GpuSplitFinder.evaluateLevel(this.evalRec, this.evalGain, this.evalMeta, this.evalStats,
                                     this.store, this.slotBase, this.cutPtr, q,
                                     lambda, alpha, minChildWeight, this.nf, count, this.nbins,
                                     this.log);
        int64[] rec = heap int64[count * GpuSplitFinder.recordWords()];
        this.evalRec.download(rec, count * GpuSplitFinder.recordWords());
        this.log.downSmalls((int64) 1);
        if (this.lvPending) { this.finishLevel(); }
        return #rec;
    }

    /** Sizes the evaluation buffers for `count` nodes. */
    void ensureEval(int64 count) {
        if (count > this.evalCap) {
            int64 c = count;
            if (c < (int64) 8) { c = (int64) 8; }
            this.slotBase = heap KernelBuffer<int64>(c);
            this.evalGain = heap KernelBuffer<float32>(c * this.nf);
            this.evalMeta = heap KernelBuffer<int32>(c * this.nf * (int64) 3);
            this.evalStats = heap KernelBuffer<int64>(c * this.nf * (int64) 4);
            this.evalRec = heap KernelBuffer<int64>(c * GpuSplitFinder.recordWords());
            this.evalCap = c;
        }
    }

    /** True when `nids` are the queued level's children, left then right per split. */
    boolean childrenAre(int64[] nids, int64 count) {
        if (count != (int64) 2 * this.lvCount) { return false; }
        int64 j = (int64) 0;
        while (j < this.lvCount) {
            if (nids[(int64) 2 * j] != this.lvLeft[j]) { return false; }
            if (nids[(int64) 2 * j + (int64) 1] != this.lvRight[j]) { return false; }
            j = j + (int64) 1;
        }
        return true;
    }

    /** Record `j` of `rec` as a {@link Split}, its threshold read from `cutValues`. */
    public static #Split splitFrom(int64[] rec, int64 j, Tensor<int64> cutPtrs,
                                   Tensor<float64> cutValues) {
        int64 r = j * GpuSplitFinder.recordWords();
        Split s = heap Split();
        if (rec[r] == (int64) 0) { return #s; }
        s.valid = true;
        s.findex = rec[r + (int64) 1];
        s.splitGidx = rec[r + (int64) 2];
        s.gain = Cajeta.bitsToF32((int32) rec[r + (int64) 3]);
        s.defaultLeft = rec[r + (int64) 4] != (int64) 0;
        s.leftG = rec[r + (int64) 5];
        s.leftH = rec[r + (int64) 6];
        s.rightG = rec[r + (int64) 7];
        s.rightH = rec[r + (int64) 8];
        if (s.splitGidx >= cutPtrs.flatGet(s.findex)) {
            s.fvalue = (float32) cutValues.flatGet(s.splitGidx);
        }
        return #s;
    }

    /** Splits node `nid` into `li` and `ri` by `s` and answers `[cntL, cntR]`. */
    public #int64[] split(Split s, Tensor<int64> cutPtrs, int64 nid, int64 li, int64 ri) {
        int64 begin = this.segBegin[nid];
        int64 count = this.segCount[nid];
        int64 left = GpuPartition.splitSegment(this.ridx, this.scratch, this.blockCounts,
                                               this.blockH, this.bins, cutPtrs, s,
                                               begin, count, this.nf, this.log);
        this.segBegin[li] = begin;
        this.segCount[li] = left;
        this.segBegin[ri] = begin + left;
        this.segCount[ri] = count - left;
        int64[] counts = heap int64[2];
        counts[0] = left;
        counts[1] = count - left;
        return #counts;
    }

    /** Queues the split of node `nid` into `li` and `ri` by `s` for the level's batched partition. */
    public void addSplit(Split s, Tensor<int64> cutPtrs, int64 nid, int64 li, int64 ri) {
        int64 j = this.lvCount;
        int64 t = j * GpuPartition.tableWords();
        int64 count = this.segCount[nid];
        this.tabH[t] = (int32) this.segBegin[nid];
        this.tabH[t + (int64) 1] = (int32) count;
        this.tabH[t + (int64) 2] = (int32) this.lvBlocks;
        this.tabH[t + (int64) 3] = (int32) s.findex;
        this.tabH[t + (int64) 4] = (int32) (s.splitGidx - cutPtrs.flatGet(s.findex));
        this.tabH[t + (int64) 5] = s.defaultLeft ? (int32) 1 : (int32) 0;
        this.slotTabH[j * (int64) 3 + (int64) 2] = this.lvCells;
        this.lvBlocks = this.lvBlocks
            + (count + GpuPartition.segmentBlock() - (int64) 1) / GpuPartition.segmentBlock();
        this.lvCells = this.lvCells + (count / (int64) 2) * this.nf;
        this.lvParent[j] = nid;
        this.lvLeft[j] = li;
        this.lvRight[j] = ri;
        this.lvCount = j + (int64) 1;
    }

    /** Partitions every queued split's segment stably, with no sync. */
    public void partitionLevel() {
        if (this.lvCount == (int64) 0) { return; }
        this.levelTab.upload(this.tabH, this.lvCount * GpuPartition.tableWords());
        this.log.upSmalls((int64) 1);
        GpuPartition.splitLevel(this.ridx, this.scratch, this.blockCounts, this.blockSplit, this.lefts,
                                this.bins, this.levelTab, this.lvCount, this.lvBlocks, this.nf);
        this.lvPending = true;
    }

    /**
     * Builds each partitioned split's smaller child into a new slot and derives the
     * larger in its parent's slot, with no sync; the children's slot bases are left
     * on the device for the next {@link #evaluate}.
     */
    public void buildLevel() {
        if (!this.lvPending) { return; }
        this.ensureEval((int64) 2 * this.lvCount);
        int64 j = (int64) 0;
        while (j < this.lvCount) {
            int64 parentSlot = this.slotOf[this.lvParent[j]];
            int64 fresh = this.takeSlot();
            this.lvParentSlot[j] = parentSlot;
            this.lvFresh[j] = fresh;
            this.slotOf[this.lvParent[j]] = (int64) -1;
            this.slotTabH[j * (int64) 3] = parentSlot * this.slotWords;
            this.slotTabH[j * (int64) 3 + (int64) 1] = fresh * this.slotWords;
            j = j + (int64) 1;
        }
        this.slotTab.upload(this.slotTabH, this.lvCount * (int64) 3);
        this.log.upSmalls((int64) 1);
        GpuHistogram.buildLevel(this.store, this.bins, this.cutOff, this.q, this.ridx, this.levelTab,
                                this.lefts, this.slotTab, this.plan, this.slotBase,
                                this.lvCount, this.lvCells, this.nf, this.nbins);
        this.lvBuilt = true;
    }

    /** Waits for the queued level and answers its `[cntL, cntR]` per split. */
    public #int64[] levelCounts() {
        int64 k = this.lvCount;
        this.waitLevel();
        int64[] counts = heap int64[(int64) 2 * k];
        int64 j = (int64) 0;
        while (j < k) {
            counts[(int64) 2 * j] = this.segCount[this.lvLeft[j]];
            counts[(int64) 2 * j + (int64) 1] = this.segCount[this.lvRight[j]];
            j = j + (int64) 1;
        }
        return #counts;
    }

    /** Waits for a queued level and applies it. */
    void waitLevel() {
        if (!this.lvPending) { return; }
        this.log.sync(KernelStream.current());
        this.finishLevel();
    }

    /** Reads a finished level's left counts and sets its children's segments and slots. */
    void finishLevel() {
        this.lefts.download(this.leftsH, this.lvCount);
        this.log.downSmalls((int64) 1);
        int64 j = (int64) 0;
        while (j < this.lvCount) {
            int64 parent = this.lvParent[j];
            int64 begin = this.segBegin[parent];
            int64 count = this.segCount[parent];
            int64 left = this.leftsH[j];
            int64 li = this.lvLeft[j];
            int64 ri = this.lvRight[j];
            this.segBegin[li] = begin;
            this.segCount[li] = left;
            this.segBegin[ri] = begin + left;
            this.segCount[ri] = count - left;
            if (this.lvBuilt) {
                if (left <= count - left) {
                    this.slotOf[li] = this.lvFresh[j];
                    this.slotOf[ri] = this.lvParentSlot[j];
                } else {
                    this.slotOf[li] = this.lvParentSlot[j];
                    this.slotOf[ri] = this.lvFresh[j];
                }
            }
            j = j + (int64) 1;
        }
        this.lvCount = (int64) 0;
        this.lvBlocks = (int64) 0;
        this.lvCells = (int64) 0;
        this.lvPending = false;
        this.lvBuilt = false;
    }

    /** Each row's leaf, read once from the leaves' segments. */
    public void leafOf(int64[] leafOf, boolean[] leaf, int64 nodeCount) {
        this.waitLevel();
        int32[] rows = heap int32[this.n];
        this.ridx.download(rows);
        this.log.downRow();
        int64 nid = (int64) 0;
        while (nid < nodeCount) {
            if (leaf[nid]) {
                int64 k = this.segBegin[nid];
                int64 end = k + this.segCount[nid];
                while (k < end) {
                    leafOf[(int64) rows[k]] = nid;
                    k = k + (int64) 1;
                }
            }
            nid = nid + (int64) 1;
        }
    }

    /** The rows of node `nid`'s segment, in segment order. */
    public #int32[] segmentRows(int64 nid) {
        int32[] all = heap int32[this.n];
        this.ridx.download(all);
        this.log.downRow();
        int64 count = this.segCount[nid];
        int32[] rows = heap int32[count];
        int64 k = (int64) 0;
        while (k < count) {
            rows[k] = all[this.segBegin[nid] + k];
            k = k + (int64) 1;
        }
        return #rows;
    }

    /**
     * Adds each row's leaf value from `bw` (the leaves among `leaf`'s first
     * `nodeCount` nodes) to its device margin of the selected group, with no sync;
     * the leaf table is the only upload.
     */
    public void addLeaves(float32[] bw, boolean[] leaf, int64 nodeCount) {
        this.waitLevel();
        int64 k = (int64) 0;
        int64 nid = (int64) 0;
        while (nid < nodeCount) {
            if (leaf[nid] && this.segCount[nid] > (int64) 0) {
                int64 begin = this.segBegin[nid];
                int64 bits = (int64) Cajeta.f32ToBits(bw[nid]);
                int64 j = k;
                while (j > (int64) 0 && this.leafTabH[(j - (int64) 1) * (int64) 2] > begin) {
                    this.leafTabH[j * (int64) 2] = this.leafTabH[(j - (int64) 1) * (int64) 2];
                    this.leafTabH[j * (int64) 2 + (int64) 1] = this.leafTabH[(j - (int64) 1) * (int64) 2 + (int64) 1];
                    j = j - (int64) 1;
                }
                this.leafTabH[j * (int64) 2] = begin;
                this.leafTabH[j * (int64) 2 + (int64) 1] = bits;
                k = k + (int64) 1;
            }
            nid = nid + (int64) 1;
        }
        this.leafTab.upload(this.leafTabH, k * (int64) 2);
        this.log.upSmalls((int64) 1);
        GpuLeaves.add(this.margins, this.ridx, this.leafTab, k, this.n, this.groups, this.group);
    }

    /** Waits for the stream and downloads the device margins, `n * groups` row-major. */
    public #float32[] deviceMargins() {
        float32[] out = heap float32[this.n * this.groups];
        this.log.sync(KernelStream.current());
        this.margins.download(out);
        this.log.downRow();
        return #out;
    }

    /** Uploads the host margins, `n * groups` row-major. */
    public void uploadMargins(float32[] margin) {
        this.margins.upload(margin);
        this.log.upRow();
    }

    /** Computes the gradient pairs of `o` from the device margins into the device G and H. */
    public void gradients(Objective o) {
        GpuObjective.launch(o, this.gradG, this.gradH, this.margins, this.labels,
                            this.n, this.groups, this.log);
        this.deviceGrads = true;
    }

    /** Uploads `grad` and `hess` (`n * groups`) as the device pairs; a test hook. */
    public void loadGradients(float64[] grad, float64[] hess) {
        int64 rows = this.n * this.groups;
        float32[] g = heap float32[rows];
        float32[] h = heap float32[rows];
        int64 i = (int64) 0;
        while (i < rows) {
            g[i] = (float32) grad[i];
            h[i] = (float32) hess[i];
            i = i + (int64) 1;
        }
        this.gradG.upload(g);
        this.log.upRow();
        this.gradH.upload(h);
        this.log.upRow();
        this.deviceGrads = true;
    }

    /** True once the device holds this round's gradient pairs. */
    public boolean hasDeviceGradients() { return this.deviceGrads; }

    /** Selects output group `g` for the next tree's quantiser and pairs. */
    public void useGroup(int64 g) { this.group = g; }

    /**
     * The quantiser of the selected group's device pairs, equal to
     * `GradientQuantiser.build` on them; the pairs are quantized on the device.
     */
    public #GradientQuantiser quantise() {
        return GpuQuantiser.build(this.q, this.gradG, this.gradH, this.n, this.groups, this.group,
                                  this.qWords, this.qSums, this.log);
    }

    /** The device's quantized pairs, `[n, 2]`; a test hook. */
    public #int64[] quantizedPairs() {
        int64[] out = heap int64[this.n * (int64) 2];
        this.q.download(out);
        this.log.downRow();
        return #out;
    }

    /** Starts a tree of up to `cap` nodes over pairs already quantized on the device. */
    public void beginTree(int64 cap) {
        this.log.beginTree();
        this.startTree(cap);
    }

    /** Downloads the device G and H into `grad` and `hess`, `n * groups` row-major. */
    public void downloadGradients(float64[] grad, float64[] hess) {
        int64 rows = this.n * this.groups;
        float32[] g = heap float32[rows];
        float32[] h = heap float32[rows];
        this.gradG.download(g);
        this.log.downRow();
        this.gradH.download(h);
        this.log.downRow();
        int64 i = (int64) 0;
        while (i < rows) {
            grad[i] = (float64) g[i];
            hess[i] = (float64) h[i];
            i = i + (int64) 1;
        }
    }

    /** Uploads of n*nf cells: the bin matrix or the raw values. */
    public int64 cellUploads() { return this.log.upCells; }
    /** Uploads proportional to n. */
    public int64 rowUploads() { return this.log.upRows; }
    /** Uploads independent of n. */
    public int64 smallUploads() { return this.log.upSmall; }
    /** Downloads of n*nf cells. */
    public int64 cellDownloads() { return this.log.downCells; }
    /** Downloads proportional to n. */
    public int64 rowDownloads() { return this.log.downRows; }
    /** Downloads independent of n. */
    public int64 smallDownloads() { return this.log.downSmall; }
    /** Stream synchronizations. */
    public int64 syncs() { return this.log.syncs; }
    /** Quantisers that replayed the host's row-order sum. */
    public int64 quantiserFallbacks() { return this.log.fallbacks; }
    /** Trees begun. */
    public int64 trees() { return this.log.trees; }
    /** The most synchronizations any one tree made. */
    public int64 maxTreeSyncs() { return this.log.maxTreeSyncs(); }
    /** Cell uploads by every state since the process started. */
    public static int64 processCellUploads() { return TransferLog.processUpCells; }
    /** Row uploads by every state since the process started. */
    public static int64 processRowUploads() { return TransferLog.processUpRows; }
}
