package dev.cajeta.xgboost.gpu;

import cajeta.math.Tensor;
import cajeta.xpu.KernelBuffer;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.tree.GradientQuantiser;
import dev.cajeta.xgboost.tree.Histogram;
import dev.cajeta.xgboost.tree.Split;

/**
 * The device side of a fit: the bin matrix, uploaded once or binned on the
 * device ({@link #fromValues}); the labels, margins and gradient pairs
 * ({@link #beginFit}); the quantized pairs, uploaded once per tree; and `ridx`,
 * in which each node's rows are one contiguous segment in ascending row order.
 * Every upload, download and sync is counted in the fit's transfer log.
 *
 * Bit-identical to the CPU builder: the partition is a stable function of
 * each row's own bin, and the histograms are integer atomics, which commute.
 */
public final class GpuTrainState {

    KernelBuffer<int32> bins;
    KernelBuffer<int32> cutOff;
    KernelBuffer<int64> q;
    KernelBuffer<int32> ridx;
    KernelBuffer<int32> scratch;
    KernelBuffer<int32> blockCounts;
    KernelBuffer<int64> hist;
    KernelBuffer<float64> labels;
    KernelBuffer<float32> margins;
    KernelBuffer<float32> gradG;
    KernelBuffer<float32> gradH;
    KernelBuffer<int64> qWords;
    KernelBuffer<float64> qSums;
    TransferLog log;
    int32[] blockH;
    int64[] histWords;
    int64[] qFixed;
    int64[] segBegin;
    int64[] segCount;
    int64 n;
    int64 nf;
    int64 nbins;
    int64 groups;
    int64 group;
    boolean deviceGrads;

    GpuTrainState(Tensor<int64> cutPtrs, int64 n) {
        this.n = n;
        this.nf = cutPtrs.shapeAt(0) - (int64) 1;
        this.nbins = cutPtrs.flatGet(this.nf);
        int32[] cutH = heap int32[this.nf];
        int64 f = (int64) 0;
        while (f < this.nf) {
            cutH[f] = (int32) cutPtrs.flatGet(f);
            f = f + (int64) 1;
        }
        int64 blocks = (n + GpuPartition.segmentBlock() - (int64) 1) / GpuPartition.segmentBlock();
        this.bins = heap KernelBuffer<int32>(n * this.nf);
        this.cutOff = heap KernelBuffer<int32>(this.nf);
        this.q = heap KernelBuffer<int64>(n * (int64) 2);
        this.ridx = heap KernelBuffer<int32>(n);
        this.scratch = heap KernelBuffer<int32>(n);
        this.blockCounts = heap KernelBuffer<int32>(blocks);
        this.hist = heap KernelBuffer<int64>((int64) 2 * this.nbins + (int64) 2);
        this.blockH = heap int32[blocks];
        this.histWords = heap int64[(int64) 2 * this.nbins + (int64) 2];
        this.qFixed = heap int64[n * (int64) 2];
        this.segBegin = heap int64[1];
        this.segCount = heap int64[1];
        this.log = heap TransferLog();
        this.qWords = heap KernelBuffer<int64>((int64) 8 * GpuQuantiser.words() + (int64) 1);
        this.qSums = heap KernelBuffer<float64>((int64) 4);
        this.cutOff.upload(cutH);
        this.log.upSmalls((int64) 1);
    }

    /** A run's device state over `n` rows of `bins`; the bin matrix is uploaded here, once. */
    public static #GpuTrainState create(Tensor<int32> bins, Tensor<int64> cutPtrs, int64 n) {
        GpuTrainState st = heap GpuTrainState(cutPtrs, n);
        int64 cells = n * st.nf;
        int32[] binsH = heap int32[cells];
        int32[] hb = bins.hostBuffer();
        int64 ho = bins.hostBase();
        int64 c = (int64) 0;
        while (c < cells) {
            binsH[c] = hb[ho + c];
            c = c + (int64) 1;
        }
        st.bins.upload(binsH);
        st.log.upCell();
        return #st;
    }

    /**
     * A run's device state over the raw `[n, nf]` values `x`: the values go up
     * once as float32 and are binned on the device by `cuts` (`cutPtrs`
     * offsets), so no bin matrix crosses the bus.
     */
    public static #GpuTrainState fromValues(Tensor<float64> x, Tensor<int64> cutPtrs, float32[] cuts, int64 n) {
        GpuTrainState st = heap GpuTrainState(cutPtrs, n);
        int64 nf = st.nf;
        int64 cells = n * nf;
        int32[] bits #= GpuBinner.valueBits(x, n, nf);
        KernelBuffer<int32> vals = heap KernelBuffer<int32>(cells);
        vals.upload(bits);
        st.log.upCell();
        int64 total = cutPtrs.flatGet(nf);
        int32[] cutBits = heap int32[total];
        int64 c = (int64) 0;
        while (c < total) {
            cutBits[c] = Cajeta.f32ToBits(cuts[c]);
            c = c + (int64) 1;
        }
        int32[] ptrH = heap int32[nf + (int64) 1];
        int64 f = (int64) 0;
        while (f <= nf) {
            ptrH[f] = (int32) cutPtrs.flatGet(f);
            f = f + (int64) 1;
        }
        KernelBuffer<int32> cutsD = heap KernelBuffer<int32>(total);
        KernelBuffer<int32> ptrD = heap KernelBuffer<int32>(nf + (int64) 1);
        cutsD.upload(cutBits);
        ptrD.upload(ptrH);
        st.log.upSmalls((int64) 2);
        GpuBinner.binInto(st.bins, vals, cutsD, ptrD, cells, nf, st.log);
        return #st;
    }

    /** The device bin matrix, downloaded; a test hook. */
    public #int32[] deviceBins() {
        int32[] out = heap int32[this.n * this.nf];
        this.bins.download(out);
        this.log.downCell();
        return #out;
    }

    /**
     * Starts a fit of `groups` output groups over `label`: uploads the labels
     * and the `base` margins once, and allocates the gradient pairs.
     */
    public void beginFit(float64[] label, float32 base, int64 groups) {
        this.groups = groups;
        int64 rows = this.n * groups;
        float32[] m = heap float32[rows];
        int64 i = (int64) 0;
        while (i < rows) { m[i] = base; i = i + (int64) 1; }
        this.labels = heap KernelBuffer<float64>(this.n);
        this.margins = heap KernelBuffer<float32>(rows);
        this.gradG = heap KernelBuffer<float32>(rows);
        this.gradH = heap KernelBuffer<float32>(rows);
        this.labels.upload(label, this.n);
        this.log.upRow();
        this.margins.upload(m);
        this.log.upRow();
    }

    /**
     * Starts a tree of up to `cap` nodes: uploads this tree's quantized
     * gradient pairs and makes the root's segment every row.
     */
    public void beginTree(GradientQuantiser quant, float64[] grad, float64[] hess, int64 cap) {
        int64 r = (int64) 0;
        while (r < this.n) {
            this.qFixed[r * (int64) 2] = quant.fixedGrad(grad[r]);
            this.qFixed[r * (int64) 2 + (int64) 1] = quant.fixedHess(hess[r]);
            r = r + (int64) 1;
        }
        this.log.beginTree();
        this.q.upload(this.qFixed);
        this.log.upRow();
        GpuPartition.resetSegments(this.ridx, this.n, this.log);
        if ((int64) this.segBegin.count() < cap) {
            this.segBegin = heap int64[cap];
            this.segCount = heap int64[cap];
        }
        this.segBegin[0] = (int64) 0;
        this.segCount[0] = this.n;
    }

    /** Node `nid`'s histogram into the store slice at `base`, and its totals. */
    public void buildNode(int64 nid, int64[] histG, int64[] histH,
                          int64[] totGof, int64[] totHof, int64 base) {
        GpuHistogram.buildSegment(this.hist, this.bins, this.cutOff, this.q, this.ridx,
                                  this.segBegin[nid], this.segCount[nid], this.nf, this.nbins,
                                  this.log);
        this.hist.download(this.histWords);
        this.log.downSmalls((int64) 1);
        int64 b = (int64) 0;
        while (b < this.nbins) {
            histG[base + b] = this.histWords[b * (int64) 2];
            histH[base + b] = this.histWords[b * (int64) 2 + (int64) 1];
            b = b + (int64) 1;
        }
        totGof[nid] = this.histWords[this.nbins * (int64) 2];
        totHof[nid] = this.histWords[this.nbins * (int64) 2 + (int64) 1];
    }

    /** Splits node `nid` into `li` and `ri` by `s` and answers `[cntL, cntR]`. */
    public #int64[] split(Split s, Tensor<int64> cutPtrs, int64 nid, int64 li, int64 ri) {
        int64 begin = this.segBegin[nid];
        int64 count = this.segCount[nid];
        int64 left = GpuPartition.splitSegment(this.ridx, this.scratch, this.blockCounts,
                                               this.blockH, this.bins, cutPtrs, s,
                                               begin, count, this.nf, this.log);
        this.segBegin[li] = begin;
        this.segCount[li] = left;
        this.segBegin[ri] = begin + left;
        this.segCount[ri] = count - left;
        int64[] counts = heap int64[2];
        counts[0] = left;
        counts[1] = count - left;
        return #counts;
    }

    /** Each row's leaf, read once from the leaves' segments. */
    public void leafOf(int64[] leafOf, boolean[] leaf, int64 nodeCount) {
        int32[] rows = heap int32[this.n];
        this.ridx.download(rows);
        this.log.downRow();
        int64 nid = (int64) 0;
        while (nid < nodeCount) {
            if (leaf[nid]) {
                int64 k = this.segBegin[nid];
                int64 end = k + this.segCount[nid];
                while (k < end) {
                    leafOf[(int64) rows[k]] = nid;
                    k = k + (int64) 1;
                }
            }
            nid = nid + (int64) 1;
        }
    }

    /** The rows of node `nid`'s segment, in segment order. */
    public #int32[] segmentRows(int64 nid) {
        int32[] all = heap int32[this.n];
        this.ridx.download(all);
        this.log.downRow();
        int64 count = this.segCount[nid];
        int32[] rows = heap int32[count];
        int64 k = (int64) 0;
        while (k < count) {
            rows[k] = all[this.segBegin[nid] + k];
            k = k + (int64) 1;
        }
        return #rows;
    }

    /** Uploads the host margins, `n * groups` row-major. */
    public void uploadMargins(float32[] margin) {
        this.margins.upload(margin);
        this.log.upRow();
    }

    /** Computes the gradient pairs of `o` from the device margins into the device G and H. */
    public void gradients(Objective o) {
        GpuObjective.launch(o, this.gradG, this.gradH, this.margins, this.labels,
                            this.n, this.groups, this.log);
        this.deviceGrads = true;
    }

    /** Uploads `grad` and `hess` (`n * groups`) as the device pairs; a test hook. */
    public void loadGradients(float64[] grad, float64[] hess) {
        int64 rows = this.n * this.groups;
        float32[] g = heap float32[rows];
        float32[] h = heap float32[rows];
        int64 i = (int64) 0;
        while (i < rows) {
            g[i] = (float32) grad[i];
            h[i] = (float32) hess[i];
            i = i + (int64) 1;
        }
        this.gradG.upload(g);
        this.log.upRow();
        this.gradH.upload(h);
        this.log.upRow();
        this.deviceGrads = true;
    }

    /** True once the device holds this round's gradient pairs. */
    public boolean hasDeviceGradients() { return this.deviceGrads; }

    /** Selects output group `g` for the next tree's quantiser and pairs. */
    public void useGroup(int64 g) { this.group = g; }

    /**
     * The quantiser of the selected group's device pairs, equal to
     * `GradientQuantiser.build` on them; the pairs are quantized on the device.
     */
    public #GradientQuantiser quantise() {
        return GpuQuantiser.build(this.q, this.gradG, this.gradH, this.n, this.groups, this.group,
                                  this.qWords, this.qSums, this.log);
    }

    /** The device's quantized pairs, `[n, 2]`; a test hook. */
    public #int64[] quantizedPairs() {
        int64[] out = heap int64[this.n * (int64) 2];
        this.q.download(out);
        this.log.downRow();
        return #out;
    }

    /** Starts a tree of up to `cap` nodes over pairs already quantized on the device. */
    public void beginTree(int64 cap) {
        this.log.beginTree();
        GpuPartition.resetSegments(this.ridx, this.n, this.log);
        if ((int64) this.segBegin.count() < cap) {
            this.segBegin = heap int64[cap];
            this.segCount = heap int64[cap];
        }
        this.segBegin[0] = (int64) 0;
        this.segCount[0] = this.n;
    }

    /** Downloads the device G and H into `grad` and `hess`, `n * groups` row-major. */
    public void downloadGradients(float64[] grad, float64[] hess) {
        int64 rows = this.n * this.groups;
        float32[] g = heap float32[rows];
        float32[] h = heap float32[rows];
        this.gradG.download(g);
        this.log.downRow();
        this.gradH.download(h);
        this.log.downRow();
        int64 i = (int64) 0;
        while (i < rows) {
            grad[i] = (float64) g[i];
            hess[i] = (float64) h[i];
            i = i + (int64) 1;
        }
    }

    /** {@link GpuSplitFinder#findBest} on `hist`, counted in this fit's log. */
    public #Split findBest(Histogram hist, Tensor<int64> cutPtrs, Tensor<float64> cutValues,
                           GradientQuantiser q, float64 lambda, float64 alpha,
                           float64 minChildWeight) {
        return GpuSplitFinder.findBest(hist, cutPtrs, cutValues, q, lambda, alpha, minChildWeight,
                                       this.log);
    }

    /** Uploads of n*nf cells: the bin matrix or the raw values. */
    public int64 cellUploads() { return this.log.upCells; }
    /** Uploads proportional to n. */
    public int64 rowUploads() { return this.log.upRows; }
    /** Uploads independent of n. */
    public int64 smallUploads() { return this.log.upSmall; }
    /** Downloads of n*nf cells. */
    public int64 cellDownloads() { return this.log.downCells; }
    /** Downloads proportional to n. */
    public int64 rowDownloads() { return this.log.downRows; }
    /** Downloads independent of n. */
    public int64 smallDownloads() { return this.log.downSmall; }
    /** Stream synchronizations. */
    public int64 syncs() { return this.log.syncs; }
    /** Quantisers that replayed the host's row-order sum. */
    public int64 quantiserFallbacks() { return this.log.fallbacks; }
    /** Trees begun. */
    public int64 trees() { return this.log.trees; }
    /** The most synchronizations any one tree made. */
    public int64 maxTreeSyncs() { return this.log.maxTreeSyncs(); }
    /** Cell uploads by every state since the process started. */
    public static int64 processCellUploads() { return TransferLog.processUpCells; }
    /** Row uploads by every state since the process started. */
    public static int64 processRowUploads() { return TransferLog.processUpRows; }
}
