package dev.cajeta.xgboost.booster;

/**
 * A trained regression forest: `rounds` trees stored as flat arrays, each tree
 * padded to a fixed per-tree `cap` (= `TreeBuilder.capacity(maxDepth)`) so tree
 * `r`'s node `k` lives at index `r*cap + k`. This mirrors XGBoost's model layout
 * (a list of trees, each with parallel node arrays) without an owned-object array
 * — one flat allocation per field, indexed by `(round, node)`.
 *
 * `baseMargin` is `base_score` under the objective's link (identity for
 * `reg:squarederror`), the value every row's margin starts at. A leaf's value is
 * carried in `baseWeights`/`splitConditions` (raw `CalcWeight × learning_rate`);
 * internal nodes carry the raw `CalcWeight` in `baseWeights` and the split
 * threshold in `splitConditions`. Leaves have `leftChildren == rightChildren == -1`.
 *
 * `deterministic` is training-mode metadata (spec §1.7.3): true iff the model was
 * trained under the deterministic, bit-exact config. It defaults to true (the
 * deterministic engine) and is flipped by the labeled non-deterministic entry
 * point ({@code api.GBDT.fitNonDeterministic}); it survives serialization so a
 * result's reproducibility stays auditable.
 *
 * The array fields are **owned** (`#=`); callers move them in.
 */
public final class Model {
    public int64 rounds;
    public int64 cap;                 // per-tree stride (node ids 0..nodeCount[r])
    public float32 baseMargin;        // base_score under the link
    public boolean deterministic;     // trained under the bit-exact config? (§1.7.3)
    public int64[] nodeCount;         // [rounds] node count of each tree
    public int64[] splitIndices;      // [rounds*cap] split feature (internal)
    public float32[] splitConditions; // threshold (internal) / leaf value (leaf)
    public boolean[] defaultLeft;     // missing → left
    public int64[] leftChildren;      // -1 for leaves
    public int64[] rightChildren;     // -1 for leaves
    public float32[] baseWeights;     // raw CalcWeight (internal) / leaf value (leaf)
    public boolean[] isLeaf;
    // Per-node importance statistics (spec §5.3), the inputs `get_score`'s
    // total_gain / total_cover are summed from. Recorded during growth because
    // they are NOT recoverable from the stored tree afterwards: the split's
    // gain improvement and the node's hessian coverage leave no trace in the
    // thresholds or weights. Without them `predict.Importance` could only ever
    // report `weight` from a trained Model.
    public float32[] lossChanges;     // [rounds*cap] split gain improvement; 0 on leaves
    public float64[] sumHessian;      // [rounds*cap] hessian coverage of each node

    Model(int64 rounds, int64 cap, float32 baseMargin, int64[] nodeCount,
          int64[] si, float32[] sc, boolean[] dl,
          int64[] lc, int64[] rc, float32[] bw, boolean[] leaf,
          float32[] lossChg, float64[] sumHess) {
        this.rounds = rounds;
        this.cap = cap;
        this.baseMargin = baseMargin;
        this.deterministic = true;
        this.nodeCount #= nodeCount;
        this.splitIndices #= si;
        this.splitConditions #= sc;
        this.defaultLeft #= dl;
        this.leftChildren #= lc;
        this.rightChildren #= rc;
        this.baseWeights #= bw;
        this.isLeaf #= leaf;
        this.lossChanges #= lossChg;
        this.sumHessian #= sumHess;
    }
}
