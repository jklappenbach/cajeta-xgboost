package dev.cajeta.xgboost.booster;

/**
 * Model (de)serialization (spec §5.2). A {@link Model} is a header (`rounds`,
 * `cap`, `baseMargin`, `deterministic`) plus `nodeCount[rounds]` and nine flat
 * `[rounds*cap]` node arrays; this writes them as a self-describing little-endian
 * buffer (one 8-byte word per scalar — float32 fields via their bit pattern) and
 * reads them back into an identical Model. Round-trip is bit-exact by construction
 * — including the `deterministic` training-mode flag (§1.7.3) — so a loaded model
 * predicts identically to the original and its reproducibility stays auditable.
 */
public final class ModelIO {

    static int64 words(int64 rounds, int64 cap) {
        return (int64) 5 + rounds + (int64) 9 * rounds * cap;   // header + nodeCount + 9 arrays
    }

    public static #int8[] serialize(Model m) {
        int64 R = m.rounds;
        int64 C = m.cap;
        int64 A = R * C;
        int8[] buf = heap int8[ModelIO.words(R, C) * (int64) 8];
        Cajeta.storeU64(buf, (int64) 0, R);
        Cajeta.storeU64(buf, (int64) 8, C);
        Cajeta.storeU64(buf, (int64) 16, (int64) Cajeta.f32ToBits(m.baseMargin));
        Cajeta.storeU64(buf, (int64) 24, m.deterministic ? (int64) 1 : (int64) 0);
        Cajeta.storeU64(buf, (int64) 32, m.numClass);
        int64 off = (int64) 40;
        int64 i = (int64) 0;
        while (i < R) { Cajeta.storeU64(buf, off, m.nodeCount[i]); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, m.splitIndices[i]); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, (int64) Cajeta.f32ToBits(m.splitConditions[i])); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, m.defaultLeft[i] ? (int64) 1 : (int64) 0); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, m.leftChildren[i]); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, m.rightChildren[i]); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, (int64) Cajeta.f32ToBits(m.baseWeights[i])); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, m.isLeaf[i] ? (int64) 1 : (int64) 0); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, (int64) Cajeta.f32ToBits(m.lossChanges[i])); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { Cajeta.storeU64(buf, off, Cajeta.f64ToBits(m.sumHessian[i])); off = off + (int64) 8; i = i + (int64) 1; }
        return #buf;
    }

    public static #Model deserialize(int8[] buf) {
        int64 R = Cajeta.loadU64(buf, (int64) 0);
        int64 C = Cajeta.loadU64(buf, (int64) 8);
        float32 base = Cajeta.bitsToF32((int32) Cajeta.loadU64(buf, (int64) 16));
        boolean deterministic = Cajeta.loadU64(buf, (int64) 24) == (int64) 1;
        int64 numClass = Cajeta.loadU64(buf, (int64) 32);
        int64 A = R * C;
        int64[]   nodeCount = heap int64[R];
        int64[]   si = heap int64[A];
        float32[] sc = heap float32[A];
        boolean[] dl = heap boolean[A];
        int64[]   lc = heap int64[A];
        int64[]   rc = heap int64[A];
        float32[] bw = heap float32[A];
        boolean[] leaf = heap boolean[A];
        float32[] lch = heap float32[A];
        float64[] sh = heap float64[A];
        int64 off = (int64) 40;
        int64 i = (int64) 0;
        while (i < R) { nodeCount[i] = Cajeta.loadU64(buf, off); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { si[i] = Cajeta.loadU64(buf, off); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { sc[i] = Cajeta.bitsToF32((int32) Cajeta.loadU64(buf, off)); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { dl[i] = Cajeta.loadU64(buf, off) == (int64) 1; off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { lc[i] = Cajeta.loadU64(buf, off); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { rc[i] = Cajeta.loadU64(buf, off); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { bw[i] = Cajeta.bitsToF32((int32) Cajeta.loadU64(buf, off)); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { leaf[i] = Cajeta.loadU64(buf, off) == (int64) 1; off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { lch[i] = Cajeta.bitsToF32((int32) Cajeta.loadU64(buf, off)); off = off + (int64) 8; i = i + (int64) 1; }
        i = (int64) 0;
        while (i < A) { sh[i] = Cajeta.bitsToF64(Cajeta.loadU64(buf, off)); off = off + (int64) 8; i = i + (int64) 1; }
        Model m = heap Model(R, C, base, #nodeCount, #si, #sc, #dl, #lc, #rc, #bw, #leaf, #lch, #sh);
        m.deterministic = deterministic;
        m.numClass = numClass;
        return #m;
    }
}
