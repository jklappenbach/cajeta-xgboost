package dev.cajeta.xgboost.booster;

import cajeta.math.Tensor;
import dev.cajeta.xgboost.objective.SquaredError;
import dev.cajeta.xgboost.objective.Logistic;
import dev.cajeta.xgboost.objective.Softmax;
import dev.cajeta.xgboost.objective.Objective;
import dev.cajeta.xgboost.tree.TreeBuilder;

/**
 * The gradient-boosting loop for `reg:squarederror` (spec §3.1, §3.4, §3.5),
 * reproducing XGBoost's per-round update bit-for-bit.
 *
 * Each row's margin starts at the base margin (`base_score` under the identity
 * link). Per round: compute per-row (grad, hess) in float32 from the current
 * margins ({@link SquaredError}), grow one tree over that gradient
 * ({@link TreeBuilder#grow}), then add each row's leaf value to its margin — in
 * **float32**, using the training-time leaf assignment (`leafOf`) the builder
 * returns. That is exactly how XGBoost updates its prediction cache during
 * training, so the accumulated margin (and hence the next round's gradient) stays
 * bit-identical. Leaf values already carry the `learning_rate` shrinkage.
 *
 * For `reg:squarederror` the link is the identity, so the final prediction is the
 * accumulated margin after the last round.
 */
public final class Booster {

    /** The margin every row starts at, under the objective's link. */
    static float32 baseMarginOf(Objective o, float64 baseScore) {
        if (o == Objective.LOGISTIC) {
            return Logistic.baseMargin(baseScore);
        }
        if (o == Objective.SOFTMAX) {
            return Softmax.baseMargin(baseScore);
        }
        return SquaredError.baseMargin(baseScore);
    }

    /** Per-(row, class) gradient pair for the objective. */
    static void gradHessOf(Objective o, float32[] margin, float64[] label,
                           int64 n, int64 K, float64[] grad, float64[] hess) {
        if (o == Objective.LOGISTIC) {
            Logistic.gradHess(margin, label, n, grad, hess);
            return;
        }
        if (o == Objective.SOFTMAX) {
            Softmax.gradHess(margin, label, n, K, grad, hess);
            return;
        }
        SquaredError.gradHess(margin, label, n, grad, hess);
    }

    /**
     * Train a `rounds`-tree regression forest over the binned matrix.
     *
     * @param label      per-row targets (float64), length `n`.
     * @param baseScore  initial score (identity link → base margin).
     * @param marginHistory out-param, length `rounds*n`: the cumulative margin of
     *                   every row after each round (`r*n + row`). The last round's
     *                   slice is the final prediction. Pass a `rounds*n` array.
     */
    public static #Model train(Tensor<int32> bins, Tensor<int64> cutPtrs, Tensor<float64> cutValues,
                               float64[] label, int64 n, int64 rounds,
                               int64 maxDepth, int64 maxLeaves,
                               float64 lambda, float64 alpha, float64 gamma, float64 minChildWeight,
                               float64 eta, float64 baseScore,
                               Objective objective, int64 numClass,
                               float32[] marginHistory) {
        int64 cap = TreeBuilder.capacity(maxDepth);
        // Output groups per round. K trees are grown per round, one per class,
        // each over ITS OWN gradient slice — the objective is the only thing
        // that differs between a regression fit and a K-class fit; the sketch,
        // the fixed-point histogram and the split search never learn about it.
        int64 K = (objective == Objective.SOFTMAX) ? numClass : (int64) 1;
        if (K < (int64) 1) { K = (int64) 1; }
        int64 trees = rounds * K;

        int64[] nodeCount = heap int64[trees];
        int64[]   fSI = heap int64[trees * cap];
        float32[] fSC = heap float32[trees * cap];
        boolean[] fDL = heap boolean[trees * cap];
        int64[]   fLC = heap int64[trees * cap];
        int64[]   fRC = heap int64[trees * cap];
        float32[] fBW = heap float32[trees * cap];
        boolean[] fLF = heap boolean[trees * cap];
        float32[] fLCH = heap float32[trees * cap];   // per-node split gain
        float64[] fSH  = heap float64[trees * cap];   // per-node hessian cover

        float32 base = Booster.baseMarginOf(objective, baseScore);
        float32[] margin = heap float32[n * K];
        int64 i = (int64) 0;
        while (i < n * K) { margin[i] = base; i = i + (int64) 1; }

        float64[] grad = heap float64[n * K];
        float64[] hess = heap float64[n * K];
        float64[] gradK = heap float64[n];   // one class's slice
        float64[] hessK = heap float64[n];
        int64[] leafOf = heap int64[n];

        int64 r = (int64) 0;
        while (r < rounds) {
            // (1) Per-row (per-class) gradient pair from the current margins.
            Booster.gradHessOf(objective, margin, label, n, K, grad, hess);
            int64 g = (int64) 0;
            while (g < K) {
                // This class's gradient slice: row-major [n*K], class g at
                // stride K. For K == 1 this is a straight copy of grad/hess,
                // so the single-group path stays value-identical.
                int64 ii = (int64) 0;
                while (ii < n) {
                    gradK[ii] = grad[ii * K + g];
                    hessK[ii] = hess[ii * K + g];
                    ii = ii + (int64) 1;
                }

                // (2) Grow this class's tree into scratch arrays; capture leafOf.
                int64[]   si = heap int64[cap];
                float32[] sc = heap float32[cap];
                boolean[] dl = heap boolean[cap];
                int64[]   lc = heap int64[cap];
                int64[]   rc = heap int64[cap];
                float32[] bw = heap float32[cap];
                boolean[] lf = heap boolean[cap];
                float32[] lch = heap float32[cap];
                float64[] shs = heap float64[cap];
                int64 nc = TreeBuilder.grow(bins, cutPtrs, cutValues, gradK, hessK, n,
                                            maxDepth, maxLeaves, lambda, alpha, gamma, minChildWeight,
                                            eta, si, sc, dl, lc, rc, bw, lf, lch, shs, leafOf);
                // Tree index is round-major: r*K + g, so class g's trees are
                // every K-th tree — XGBoost's own layout.
                int64 t = r * K + g;
                nodeCount[t] = nc;

                // (3) Persist the tree into the forest slice t*cap.
                int64 off = t * cap;
                int64 k = (int64) 0;
                while (k < cap) {
                    fSI[off + k] = si[k]; fSC[off + k] = sc[k]; fDL[off + k] = dl[k];
                    fLC[off + k] = lc[k]; fRC[off + k] = rc[k]; fBW[off + k] = bw[k];
                    fLF[off + k] = lf[k];
                    fLCH[off + k] = lch[k]; fSH[off + k] = shs[k];
                    k = k + (int64) 1;
                }

                // (4) Accumulate each row's leaf value into THIS CLASS's margin,
                //     and record the cumulative margin for this round.
                int64 hoff = r * n * K;
                i = (int64) 0;
                while (i < n) {
                    float32 leafVal = bw[leafOf[i]];   // leafOf[i] is a leaf → shrunk value
                    margin[i * K + g] = margin[i * K + g] + leafVal;
                    marginHistory[hoff + i * K + g] = margin[i * K + g];
                    i = i + (int64) 1;
                }
                g = g + (int64) 1;
            }
            r = r + (int64) 1;
        }

        Model m = heap Model(trees, cap, base, #nodeCount,
                             #fSI, #fSC, #fDL, #fLC, #fRC, #fBW, #fLF,
                             #fLCH, #fSH);
        m.numClass = K;
        return #m;
    }
}
