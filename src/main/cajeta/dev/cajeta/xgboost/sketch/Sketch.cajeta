package dev.cajeta.xgboost.sketch;

import cajeta.math.Tensor;

/**
 * Quantile cut-point builder (spec §2, §7.2) — reproduces XGBoost's GPU device sketch
 * (`device=cuda`, `tree_method=hist`) `cut_values` bit-for-bit, both the no-prune case
 * (a feature with ≤ `max_bin` distinct values) and the **pruned** GK weighted-quantile
 * case (more distinct values than `max_bin`). All summary math is float32 (`RType`),
 * matching `src/common/quantile.{h,cu}`.
 *
 * Per feature the pipeline is (unweighted, deterministic, single batch):
 *   1. gather present float32, sort ascending, collapse to the distinct summary
 *      `e[j] = {rmin=C_j, rmax=C_j+n_j, wmin=n_j, value=v_j}` (§quantile.cu ScanInput).
 *   2. **Stage A** — if `#distinct > requiredSampleCuts(n)` (the in-`Push` budget,
 *      `RequiredSampleCutsPerColumn`/`LimitSizeLevel`), prune to that budget.
 *   3. **Stage C** — `MakeCuts` prunes to `max_bin + 1` (`quantile.cu:616`).
 *   Both prunes are XGBoost's `WQSummary::SetPrune` (`quantile.h:220`), bit-identical
 *   to the GPU `PruneImpl` for a single summary.
 *   4. emit `k = min(s, max_bin)` cut values (`quantile.cu:690-750`): the exported
 *      per-feature cuts are `[min_sentinel, S[1], …, S[k-1], max_sentinel]`, where the
 *      min/max sentinels are computed in **float64** (the `fabs(v) + 1e-5` promotes the
 *      `1e-5` double literal, then narrows to float on store).
 *
 * This generalizes the U9 no-prune closed form: for `#distinct ≤ max_bin` no prune
 * fires and the result is identical to before.
 */
public final class Sketch {

    static boolean isNaN(float32 v) {
        return (Cajeta.f32ToBits(v) & (int32) 0x7FFFFFFF) > (int32) 0x7F800000;
    }

    /** Ascending insertion sort of `a[0, m)`. */
    static void sortAsc(float32[] a, int64 m) {
        int64 i = (int64) 1;
        while (i < m) {
            float32 key = a[i];
            int64 j = i - (int64) 1;
            while (j >= (int64) 0 && a[j] > key) { a[j + (int64) 1] = a[j]; j = j - (int64) 1; }
            a[j + (int64) 1] = key;
            i = i + (int64) 1;
        }
    }

    /** ceil for v > 0 without depending on a libm binding. */
    static int64 ceilPos(float64 v) {
        int64 t = (int64) v;
        if ((float64) t < v) { t = t + (int64) 1; }
        return t;
    }

    /**
     * `RequiredSampleCutsPerColumn` (`src/common/hist_util.cu:31-37` + `LimitSizeLevel`,
     * `quantile.h:544-558`): the in-`Push` prune budget for a column, given the batch
     * row count. `eps = 1/(kFactor*max_bin)`, `kFactor = 8`.
     */
    static int64 requiredSampleCuts(int64 numRows, int64 maxBin) {
        float64 eps = (float64) 1.0 / ((float64) 8.0 * (float64) maxBin);
        int64 nlevel = (int64) 1;
        int64 limitSize = (int64) 0;
        while (true) {
            int64 ls = Sketch.ceilPos((float64) nlevel / eps) + (int64) 1;   // ceil(nlevel/eps)+1
            if (ls > numRows) { ls = numRows; }                              // min(maxn, limit_size)
            limitSize = ls;
            int64 lhs = ((int64) 1 << nlevel) * limitSize;                   // (1<<nlevel)*limit_size
            if (lhs >= numRows) { break; }
            nlevel = nlevel + (int64) 1;
        }
        return limitSize;
    }

    /**
     * `WQSummary::SetPrune` (`quantile.h:220-250`) on parallel float32 summary arrays.
     * Prunes `in[0, size)` to at most `to` entries into `out*`; returns the new size.
     * If `size <= to` it copies verbatim.
     */
    static int64 setPrune(float32[] irm, float32[] irx, float32[] iwm, float32[] iv, int64 size, int64 to,
                          float32[] orm, float32[] orx, float32[] owm, float32[] ov) {
        if (size <= to) {
            int64 c = (int64) 0;
            while (c < size) { orm[c] = irm[c]; orx[c] = irx[c]; owm[c] = iwm[c]; ov[c] = iv[c]; c = c + (int64) 1; }
            return size;
        }
        float32 begin = irx[0];                       // src.data[0].rmax
        float32 range = irm[size - (int64) 1] - irx[0];   // src[last].rmin - src[0].rmax
        int64 nn = to - (int64) 1;
        orm[0] = irm[0]; orx[0] = irx[0]; owm[0] = iwm[0]; ov[0] = iv[0];
        int64 osize = (int64) 1;
        int64 i = (int64) 1;
        int64 lastidx = (int64) 0;
        int64 k = (int64) 1;
        while (k < nn) {
            float32 dx2 = (float32) 2.0 * (((float32) k * range) / (float32) nn + begin);
            while (i < size - (int64) 1 && dx2 >= irx[i + (int64) 1] + irm[i + (int64) 1]) {
                i = i + (int64) 1;
            }
            if (i == size - (int64) 1) { break; }
            float32 rMinNextI = irm[i] + iwm[i];                       // src[i].RMinNext()
            float32 rMaxPrevI1 = irx[i + (int64) 1] - iwm[i + (int64) 1];  // src[i+1].RMaxPrev()
            if (dx2 < rMinNextI + rMaxPrevI1) {
                if (i != lastidx) {
                    orm[osize] = irm[i]; orx[osize] = irx[i]; owm[osize] = iwm[i]; ov[osize] = iv[i];
                    osize = osize + (int64) 1; lastidx = i;
                }
            } else {
                int64 i1 = i + (int64) 1;
                if (i1 != lastidx) {
                    orm[osize] = irm[i1]; orx[osize] = irx[i1]; owm[osize] = iwm[i1]; ov[osize] = iv[i1];
                    osize = osize + (int64) 1; lastidx = i1;
                }
            }
            k = k + (int64) 1;
        }
        if (lastidx != size - (int64) 1) {
            int64 last = size - (int64) 1;
            orm[osize] = irm[last]; orx[osize] = irx[last]; owm[osize] = iwm[last]; ov[osize] = iv[last];
            osize = osize + (int64) 1;
        }
        return osize;
    }

    /**
     * GPU-parity quantile cuts. Fills `cutPtrs[nf+1]` and returns the concatenated
     * per-feature cut values (bit-exact to XGBoost's `get_quantile_cut()`), handling
     * both the no-prune and pruned cases.
     */
    public static #float32[] cuts(Tensor<float64> x, int64 n, int64 nf, int64 maxBin,
                                  int64[] cutPtrs) {
        float32[] out = heap float32[nf * (maxBin + (int64) 1)];
        float32[] col = heap float32[n];
        // distinct summary + two prune scratch buffers (each ≤ #distinct ≤ n).
        float32[] drm = heap float32[n]; float32[] drx = heap float32[n];
        float32[] dwm = heap float32[n]; float32[] dv  = heap float32[n];
        float32[] arm = heap float32[n]; float32[] arx = heap float32[n];
        float32[] awm = heap float32[n]; float32[] av  = heap float32[n];
        float32[] brm = heap float32[n]; float32[] brx = heap float32[n];
        float32[] bwm = heap float32[n]; float32[] bv  = heap float32[n];
        float64 eps = (float64) 0.00001;   // 1e-5 (double literal, per source)
        int64 pos = (int64) 0;
        cutPtrs[0] = (int64) 0;

        int64 f = (int64) 0;
        while (f < nf) {
            // gather present, sort.
            int64 m = (int64) 0;
            int64 r = (int64) 0;
            while (r < n) {
                float32 v = (float32) x.flatGet(r * nf + f);
                if (!Sketch.isNaN(v)) { col[m] = v; m = m + (int64) 1; }
                r = r + (int64) 1;
            }
            Sketch.sortAsc(col, m);

            if (m > (int64) 0) {
                // collapse to the distinct summary e[j] = {C_j, C_j+n_j, n_j, v_j}.
                int64 D = (int64) 0;
                int64 cum = (int64) 0;
                int64 idx = (int64) 0;
                while (idx < m) {
                    float32 v = col[idx];
                    int64 cnt = (int64) 1;
                    int64 j = idx + (int64) 1;
                    while (j < m && col[j] == v) { cnt = cnt + (int64) 1; j = j + (int64) 1; }
                    drm[D] = (float32) cum;
                    drx[D] = (float32) (cum + cnt);
                    dwm[D] = (float32) cnt;
                    dv[D]  = v;
                    D = D + (int64) 1;
                    cum = cum + cnt;
                    idx = j;
                }

                // Stage A — in-Push prune to min(requiredSampleCuts(n), present).
                int64 ncpf = Sketch.requiredSampleCuts(n, maxBin);
                int64 toA = ncpf < m ? ncpf : m;
                int64 sA = Sketch.setPrune(drm, drx, dwm, dv, D, toA, arm, arx, awm, av);

                // Stage C — MakeCuts prune to max_bin + 1.
                int64 toC = maxBin + (int64) 1;
                int64 s = Sketch.setPrune(arm, arx, awm, av, sA, toC, brm, brx, bwm, bv);

                // emit k = min(s, maxBin) cut values, prepended by the min sentinel.
                int64 k = s < maxBin ? s : maxBin;
                float32 s0 = bv[0];
                float64 mag0 = (float64) Math.abs(s0);
                out[pos] = (float32) ((float64) s0 - (mag0 + eps)); pos = pos + (int64) 1;   // min sentinel
                int64 e = (int64) 1;
                while (e < k) { out[pos] = bv[e]; pos = pos + (int64) 1; e = e + (int64) 1; }  // S[1..k-1]
                float32 smax = bv[s - (int64) 1];                                             // back() = global max
                float64 magM = (float64) Math.abs(smax);
                out[pos] = (float32) ((float64) smax + (magM + eps)); pos = pos + (int64) 1;   // max sentinel
            }
            cutPtrs[f + (int64) 1] = pos;
            f = f + (int64) 1;
        }

        float32[] res = heap float32[pos];
        int64 t = (int64) 0;
        while (t < pos) { res[t] = out[t]; t = t + (int64) 1; }
        return #res;
    }

    /**
     * No-prune convenience (U9): requires every feature to have ≤ `maxBin` distinct
     * present values. Delegates to {@link #cuts} (which handles both cases) — kept so
     * the no-prune parity test and any no-prune caller read intent directly.
     */
    public static #float32[] cutsNoPrune(Tensor<float64> x, int64 n, int64 nf, int64 maxBin,
                                         int64[] cutPtrs) {
        return Sketch.cuts(x, n, nf, maxBin, cutPtrs);
    }
}
