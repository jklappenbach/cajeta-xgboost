package dev.cajeta.xgboost.sketch;

import cajeta.concurrent.Carriers;
import cajeta.math.Tensor;

/**
 * Quantile cut-point builder (spec §2, §7.2) — reproduces XGBoost 3.1.2's
 * `QuantileDMatrix(numpy)` cuts bit-for-bit. Established for
 * gpu-numeric-fidelity U3: that construction sketches on the **CPU
 * HostSketchContainer during DMatrix construction** (`WQuantileSketch
 * <float,float>` — the GK queue/level sketch of `src/common/quantile.h`), NOT
 * the GPU device sketch; pip 3.1.2 CPU reproduces every golden fixture cut
 * exactly. All rank arithmetic is float32; the only doubles are `eps`,
 * `LimitSizeLevel`, and the two sentinel expressions.
 *
 * Per column (unweighted, dense, single batch, one worker):
 *   1. stream values in ROW ORDER (quantile.h:855), `(float32)` narrowing on
 *      read, NaN filtered; each Push carries weight 1.0f.
 *   2. the GK sketch: a `2*limit_size` queue folding consecutive equal values
 *      (quantile.h:98); on overflow, `MakeSummary` (sort + collapse + float32
 *      rank prefix) feeds the binary-counter level tree via `PushTemp` —
 *      `SetPrune(limit_size)` + `SetCombine` (+ its trailing `FixError`
 *      clamps) per carry (quantile.h:591-613).
 *   3. `GetSummary` folds the residual queue and all levels (quantile.h:614).
 *   4. `AllReduce` (single worker): prune to `min(column_size, max_bin*8)`
 *      (quantile.cc:318-334); `MakeCuts`: prune to `min(that, max_bin)+1`
 *      (quantile.cc:415-433).
 *   5. cuts per feature = `[min_sentinel, a[1..required-1].value (strictly
 *      increasing), max_sentinel]` (quantile.cc:375-387, 427, 444-448); the
 *      sentinels are DOUBLE chains using the double value of the FLOAT literal
 *      `1e-5f`, narrowed once on store; min = `(mval - |mval|) - eps` (two
 *      left-to-right subtractions), max = `cpt + (|cpt| + eps)`.
 */
public final class Sketch {

    static boolean isNaN(float32 v) {
        return (Cajeta.f32ToBits(v) & (int32) 0x7FFFFFFF) > (int32) 0x7F800000;
    }

    /** The double value of the FLOAT literal `1e-5f` (0x3727C5AC) — the
     *  sentinel expressions promote it to double, so `1.0000000474974513e-5`,
     *  not `1e-5`. */
    static float64 epsSentinel() {
        return (float64) Cajeta.bitsToF32((int32) 0x3727C5AC);
    }

    /** ceil for v > 0 without a libm binding. */
    static int64 ceilPos(float64 v) {
        int64 t = (int64) v;
        if ((float64) t < v) { t = t + (int64) 1; }
        return t;
    }

    /**
     * `LimitSizeLevel` (quantile.h:544-561): `limit_size =
     * min(maxn, ceil(nlevel/eps)+1)` at the first nlevel with
     * `(1<<nlevel)*limit_size >= maxn`. `eps = 1.0 / ((float)n_bins * 8.0f)`
     * (float product, double divide — quantile.cc:473).
     */
    static int64 limitSize(int64 maxn, int64 nBins) {
        float64 eps = (float64) 1.0 / (float64) ((float32) nBins * (float32) 8.0);
        int64 nlevel = (int64) 1;
        int64 limit = (int64) 0;
        while (true) {
            limit = Sketch.ceilPos((float64) nlevel / eps) + (int64) 1;
            if (limit > maxn) { limit = maxn; }
            if (((int64) 1 << nlevel) * limit >= maxn) { break; }
            nlevel = nlevel + (int64) 1;
        }
        return limit;
    }

    /** The `nlevel` at which {@link #limitSize} stops; a column's level tree never climbs past it. */
    static int64 limitLevels(int64 maxn, int64 nBins) {
        float64 eps = (float64) 1.0 / (float64) ((float32) nBins * (float32) 8.0);
        int64 nlevel = (int64) 1;
        while (true) {
            int64 limit = Sketch.ceilPos((float64) nlevel / eps) + (int64) 1;
            if (limit > maxn) { limit = maxn; }
            if (((int64) 1 << nlevel) * limit >= maxn) { break; }
            nlevel = nlevel + (int64) 1;
        }
        return nlevel;
    }

    /** Ascending order key of a non-NaN float32: distinct bits give distinct keys, `-0` just below `+0`. */
    static int64 orderKey(float32 v) {
        int64 b = (int64) Cajeta.f32ToBits(v);
        if (b < (int64) 0) { return (int64) 2147483647 - (b & (int64) 2147483647); }
        return b + ((int64) 1 << 31);
    }

    /** Stable sort of the parallel (value, weight) arrays by {@link #orderKey}: insertion below 33 entries, else an 11-bit LSD radix sort. */
    static void sortQueue(float32[] v, float32[] w, int64 m, ColumnWork ws) {
        if (m <= (int64) 32) {
            int64 i = (int64) 1;
            while (i < m) {
                float32 cv = v[i];
                float32 cw = w[i];
                int64 ck = Sketch.orderKey(cv);
                int64 j = i - (int64) 1;
                while (j >= (int64) 0 && Sketch.orderKey(v[j]) > ck) {
                    v[j + (int64) 1] = v[j];
                    w[j + (int64) 1] = w[j];
                    j = j - (int64) 1;
                }
                v[j + (int64) 1] = cv;
                w[j + (int64) 1] = cw;
                i = i + (int64) 1;
            }
            return;
        }
        int64[] ka = ws.key;
        int64[] kb = ws.key2;
        float32[] va = v;
        float32[] vb = ws.v2;
        float32[] wa = w;
        float32[] wb = ws.w2;
        int64[] h = ws.hist;
        int64 i = (int64) 0;
        while (i < m) { ka[i] = Sketch.orderKey(v[i]); i = i + (int64) 1; }
        boolean inScratch = false;
        int64 shift = (int64) 0;
        while (shift < (int64) 32) {
            int64 d = (int64) 0;
            while (d < (int64) 2048) { h[d] = (int64) 0; d = d + (int64) 1; }
            i = (int64) 0;
            while (i < m) {
                d = (ka[i] >> shift) & (int64) 2047;
                h[d] = h[d] + (int64) 1;
                i = i + (int64) 1;
            }
            if (h[(ka[0] >> shift) & (int64) 2047] != m) {
                int64 run = (int64) 0;
                d = (int64) 0;
                while (d < (int64) 2048) { int64 c = h[d]; h[d] = run; run = run + c; d = d + (int64) 1; }
                i = (int64) 0;
                while (i < m) {
                    d = (ka[i] >> shift) & (int64) 2047;
                    int64 p = h[d];
                    kb[p] = ka[i];
                    vb[p] = va[i];
                    wb[p] = wa[i];
                    h[d] = p + (int64) 1;
                    i = i + (int64) 1;
                }
                int64[] tk = ka; ka = kb; kb = tk;
                float32[] tv = va; va = vb; vb = tv;
                float32[] tw = wa; wa = wb; wb = tw;
                inScratch = !inScratch;
            }
            shift = shift + (int64) 11;
        }
        if (inScratch) {
            i = (int64) 0;
            while (i < m) { v[i] = va[i]; w[i] = wa[i]; i = i + (int64) 1; }
        }
    }

    /** True when the first `m` values hold both -0 and +0, the only equal values whose bits differ. */
    static boolean mixedZeros(float32[] v, int64 m) {
        boolean neg = false;
        boolean pos = false;
        int64 i = (int64) 0;
        while (i < m) {
            if (v[i] == (float32) 0.0) {
                if (Cajeta.f32ToBits(v[i]) == (int32) 0) { pos = true; } else { neg = true; }
            }
            i = i + (int64) 1;
        }
        return neg && pos;
    }

    /**
     * libstdc++'s `std::sort` by value, step for step (introsort, threshold 16,
     * median of three, heapsort past depth `2 lg m`), so equal values land where XGBoost's do.
     */
    public static void stdSort(float32[] v, float32[] w, int64 m) {
        if (m < (int64) 2) { return; }
        int64 lg = (int64) -1;
        int64 k = m;
        while (k > (int64) 0) { k = k >> (int64) 1; lg = lg + (int64) 1; }
        Sketch.introLoop(v, w, (int64) 0, m, lg * (int64) 2);
        if (m > (int64) 16) {
            Sketch.insertionSort(v, w, (int64) 0, (int64) 16);
            int64 i = (int64) 16;
            while (i < m) { Sketch.linearInsert(v, w, i); i = i + (int64) 1; }
        } else {
            Sketch.insertionSort(v, w, (int64) 0, m);
        }
    }

    /** libstdc++'s `std::partial_sort(first, last, last)`, the fallback {@link #stdSort} takes past its depth limit; a test hook. */
    public static void stdPartialSort(float32[] v, float32[] w, int64 m) {
        Sketch.heapSortRange(v, w, (int64) 0, m);
    }

    static void swapAt(float32[] v, float32[] w, int64 a, int64 b) {
        float32 tv = v[a]; v[a] = v[b]; v[b] = tv;
        float32 tw = w[a]; w[a] = w[b]; w[b] = tw;
    }

    /** `__introsort_loop`. */
    static void introLoop(float32[] v, float32[] w, int64 first, int64 last, int64 depth) {
        int64 hi = last;
        int64 d = depth;
        while (hi - first > (int64) 16) {
            if (d == (int64) 0) {
                Sketch.heapSortRange(v, w, first, hi);
                return;
            }
            d = d - (int64) 1;
            int64 mid = first + (hi - first) / (int64) 2;
            int64 a = first + (int64) 1;
            int64 c = hi - (int64) 1;
            if (v[a] < v[mid]) {
                if (v[mid] < v[c]) { Sketch.swapAt(v, w, first, mid); }
                else if (v[a] < v[c]) { Sketch.swapAt(v, w, first, c); }
                else { Sketch.swapAt(v, w, first, a); }
            } else if (v[a] < v[c]) { Sketch.swapAt(v, w, first, a); }
            else if (v[mid] < v[c]) { Sketch.swapAt(v, w, first, c); }
            else { Sketch.swapAt(v, w, first, mid); }
            int64 lo = first + (int64) 1;
            int64 up = hi;
            float32 pivot = v[first];
            while (true) {
                while (v[lo] < pivot) { lo = lo + (int64) 1; }
                up = up - (int64) 1;
                while (pivot < v[up]) { up = up - (int64) 1; }
                if (!(lo < up)) { break; }
                Sketch.swapAt(v, w, lo, up);
                lo = lo + (int64) 1;
            }
            Sketch.introLoop(v, w, lo, hi, d);
            hi = lo;
        }
    }

    /** `__insertion_sort` over `[first, last)`. */
    static void insertionSort(float32[] v, float32[] w, int64 first, int64 last) {
        if (first == last) { return; }
        int64 i = first + (int64) 1;
        while (i < last) {
            if (v[i] < v[first]) {
                float32 cv = v[i];
                float32 cw = w[i];
                int64 j = i;
                while (j > first) { v[j] = v[j - (int64) 1]; w[j] = w[j - (int64) 1]; j = j - (int64) 1; }
                v[first] = cv;
                w[first] = cw;
            } else {
                Sketch.linearInsert(v, w, i);
            }
            i = i + (int64) 1;
        }
    }

    /** `__unguarded_linear_insert` of the entry at `at`. */
    static void linearInsert(float32[] v, float32[] w, int64 at) {
        float32 cv = v[at];
        float32 cw = w[at];
        int64 hole = at;
        int64 next = at - (int64) 1;
        while (cv < v[next]) {
            v[hole] = v[next];
            w[hole] = w[next];
            hole = next;
            next = next - (int64) 1;
        }
        v[hole] = cv;
        w[hole] = cw;
    }

    /** `__partial_sort(first, last, last)`: `__make_heap` then `__sort_heap`. */
    static void heapSortRange(float32[] v, float32[] w, int64 first, int64 last) {
        int64 len = last - first;
        if (len >= (int64) 2) {
            int64 parent = (len - (int64) 2) / (int64) 2;
            while (true) {
                Sketch.adjustHeap(v, w, first, parent, len, v[first + parent], w[first + parent]);
                if (parent == (int64) 0) { break; }
                parent = parent - (int64) 1;
            }
        }
        int64 end = last;
        while (end - first > (int64) 1) {
            end = end - (int64) 1;
            float32 cv = v[end];
            float32 cw = w[end];
            v[end] = v[first];
            w[end] = w[first];
            Sketch.adjustHeap(v, w, first, (int64) 0, end - first, cv, cw);
        }
    }

    /** `__adjust_heap` then `__push_heap` of `(cv, cw)` into the hole. */
    static void adjustHeap(float32[] v, float32[] w, int64 first, int64 holeIndex, int64 len, float32 cv, float32 cw) {
        int64 top = holeIndex;
        int64 hole = holeIndex;
        int64 second = holeIndex;
        while (second < (len - (int64) 1) / (int64) 2) {
            second = (int64) 2 * (second + (int64) 1);
            if (v[first + second] < v[first + second - (int64) 1]) { second = second - (int64) 1; }
            v[first + hole] = v[first + second];
            w[first + hole] = w[first + second];
            hole = second;
        }
        if ((len & (int64) 1) == (int64) 0 && second == (len - (int64) 2) / (int64) 2) {
            second = (int64) 2 * (second + (int64) 1);
            v[first + hole] = v[first + second - (int64) 1];
            w[first + hole] = w[first + second - (int64) 1];
            hole = second - (int64) 1;
        }
        int64 parent = (hole - (int64) 1) / (int64) 2;
        while (hole > top && v[first + parent] < cv) {
            v[first + hole] = v[first + parent];
            w[first + hole] = w[first + parent];
            hole = parent;
            parent = (hole - (int64) 1) / (int64) 2;
        }
        v[first + hole] = cv;
        w[first + hole] = cw;
    }

    /**
     * `Queue::MakeSummary` (quantile.h:105-120): sort by value, collapse equal
     * values (float32 weight sums), emit entries with the float32 running rank
     * prefix `wsum`. Returns the summary size. A queue holding both zeros sorts
     * as `std::sort` does, since which zero leads a run is visible in the cuts.
     */
    static int64 makeSummary(float32[] qv, float32[] qw, int64 qtail, ColumnWork ws,
                             float32[] rm, float32[] rx, float32[] wm, float32[] v) {
        if (Sketch.mixedZeros(qv, qtail)) { Sketch.stdSort(qv, qw, qtail); }
        else { Sketch.sortQueue(qv, qw, qtail, ws); }
        int64 size = (int64) 0;
        float32 wsum = (float32) 0.0;
        int64 i = (int64) 0;
        while (i < qtail) {
            int64 j = i + (int64) 1;
            float32 w = qw[i];
            while (j < qtail && qv[j] == qv[i]) { w = w + qw[j]; j = j + (int64) 1; }
            rm[size] = wsum;
            rx[size] = wsum + w;
            wm[size] = w;
            v[size] = qv[i];
            size = size + (int64) 1;
            wsum = wsum + w;
            i = j;
        }
        return size;
    }

    /** {@link #makeSummary} of `m` queue entries, sorted in place, into `rm, rx, wm, v`; a test hook. */
    public static int64 queueSummary(float32[] qv, float32[] qw, int64 m,
                                     float32[] rm, float32[] rx, float32[] wm, float32[] v) {
        ColumnWork ws #= ColumnWork.create((m + (int64) 1) / (int64) 2 + (int64) 1, (int64) 1);
        return Sketch.makeSummary(qv, qw, m, ws, rm, rx, wm, v);
    }

    /**
     * `WQSummary::SetPrune` (quantile.h:214-250) — the sequential CPU prune.
     * All arithmetic float32. Copies verbatim when `size <= maxsize`.
     */
    static int64 setPrune(float32[] irm, float32[] irx, float32[] iwm, float32[] iv, int64 size,
                          int64 maxsize,
                          float32[] orm, float32[] orx, float32[] owm, float32[] ov) {
        if (size <= maxsize) {
            int64 c = (int64) 0;
            while (c < size) { orm[c] = irm[c]; orx[c] = irx[c]; owm[c] = iwm[c]; ov[c] = iv[c]; c = c + (int64) 1; }
            return size;
        }
        float32 begin = irx[0];
        float32 range = irm[size - (int64) 1] - irx[0];
        int64 nn = maxsize - (int64) 1;
        orm[0] = irm[0]; orx[0] = irx[0]; owm[0] = iwm[0]; ov[0] = iv[0];
        int64 osize = (int64) 1;
        int64 i = (int64) 1;
        int64 lastidx = (int64) 0;
        int64 k = (int64) 1;
        while (k < nn) {
            float32 dx2 = (float32) 2.0 * (((float32) k * range) / (float32) nn + begin);
            while (i < size - (int64) 1 && dx2 >= irx[i + (int64) 1] + irm[i + (int64) 1]) {
                i = i + (int64) 1;
            }
            if (i == size - (int64) 1) { break; }
            float32 rMinNextI = irm[i] + iwm[i];
            float32 rMaxPrevI1 = irx[i + (int64) 1] - iwm[i + (int64) 1];
            if (dx2 < rMinNextI + rMaxPrevI1) {
                if (i != lastidx) {
                    orm[osize] = irm[i]; orx[osize] = irx[i]; owm[osize] = iwm[i]; ov[osize] = iv[i];
                    osize = osize + (int64) 1; lastidx = i;
                }
            } else {
                int64 i1 = i + (int64) 1;
                if (i1 != lastidx) {
                    orm[osize] = irm[i1]; orx[osize] = irx[i1]; owm[osize] = iwm[i1]; ov[osize] = iv[i1];
                    osize = osize + (int64) 1; lastidx = i1;
                }
            }
            k = k + (int64) 1;
        }
        if (lastidx != size - (int64) 1) {
            int64 last = size - (int64) 1;
            orm[osize] = irm[last]; orx[osize] = irx[last]; owm[osize] = iwm[last]; ov[osize] = iv[last];
            osize = osize + (int64) 1;
        }
        return osize;
    }

    /**
     * `WQSummary::SetCombine` (quantile.h:251-317) — merge two summaries (`b` read from
 * offset `bo`) with
     * float32 rank sums — followed by its trailing `FixError` clamp pass
     * (quantile.h:327-354: rmin non-decreasing with the carry only advancing
     * on un-clamped entries, rmax non-decreasing, rmax >= rmin+wmin).
     */
    static int64 setCombine(float32[] arm, float32[] arx, float32[] awm, float32[] av, int64 an,
                            float32[] brm, float32[] brx, float32[] bwm, float32[] bv, int64 bo, int64 bn,
                            float32[] orm, float32[] orx, float32[] owm, float32[] ov) {
        int64 osize = (int64) 0;
        if (an == (int64) 0) {
            while (osize < bn) { orm[osize] = brm[bo + osize]; orx[osize] = brx[bo + osize]; owm[osize] = bwm[bo + osize]; ov[osize] = bv[bo + osize]; osize = osize + (int64) 1; }
            return osize;
        }
        if (bn == (int64) 0) {
            while (osize < an) { orm[osize] = arm[osize]; orx[osize] = arx[osize]; owm[osize] = awm[osize]; ov[osize] = av[osize]; osize = osize + (int64) 1; }
            return osize;
        }
        int64 a = (int64) 0;
        int64 b = (int64) 0;
        float32 aprevRmin = (float32) 0.0;
        float32 bprevRmin = (float32) 0.0;
        while (a < an && b < bn) {
            if (av[a] == bv[bo + b]) {
                orm[osize] = arm[a] + brm[bo + b];
                orx[osize] = arx[a] + brx[bo + b];
                owm[osize] = awm[a] + bwm[bo + b];
                ov[osize] = av[a];
                aprevRmin = arm[a] + awm[a];
                bprevRmin = brm[bo + b] + bwm[bo + b];
                osize = osize + (int64) 1; a = a + (int64) 1; b = b + (int64) 1;
            } else if (av[a] < bv[bo + b]) {
                orm[osize] = arm[a] + bprevRmin;
                orx[osize] = arx[a] + (brx[bo + b] - bwm[bo + b]);
                owm[osize] = awm[a];
                ov[osize] = av[a];
                aprevRmin = arm[a] + awm[a];
                osize = osize + (int64) 1; a = a + (int64) 1;
            } else {
                orm[osize] = brm[bo + b] + aprevRmin;
                orx[osize] = brx[bo + b] + (arx[a] - awm[a]);
                owm[osize] = bwm[bo + b];
                ov[osize] = bv[bo + b];
                bprevRmin = brm[bo + b] + bwm[bo + b];
                osize = osize + (int64) 1; b = b + (int64) 1;
            }
        }
        if (a < an) {
            float32 brmax = brx[bo + bn - (int64) 1];
            while (a < an) {
                orm[osize] = arm[a] + bprevRmin;
                orx[osize] = arx[a] + brmax;
                owm[osize] = awm[a];
                ov[osize] = av[a];
                osize = osize + (int64) 1; a = a + (int64) 1;
            }
        }
        if (b < bn) {
            float32 armax = arx[an - (int64) 1];
            while (b < bn) {
                orm[osize] = brm[bo + b] + aprevRmin;
                orx[osize] = brx[bo + b] + armax;
                owm[osize] = bwm[bo + b];
                ov[osize] = bv[bo + b];
                osize = osize + (int64) 1; b = b + (int64) 1;
            }
        }
        // FixError (quantile.h:327-354): note prev_rmin advances ONLY when the
        // entry was not clamped; prev_rmax always tracks the updated rmax.
        float32 prevRmin = (float32) 0.0;
        float32 prevRmax = (float32) 0.0;
        int64 i = (int64) 0;
        while (i < osize) {
            if (orm[i] < prevRmin) { orm[i] = prevRmin; }
            else { prevRmin = orm[i]; }
            if (orx[i] < prevRmax) { orx[i] = prevRmax; }
            float32 rminNext = orm[i] + owm[i];
            if (orx[i] < rminNext) { orx[i] = rminNext; }
            prevRmax = orx[i];
            i = i + (int64) 1;
        }
        return osize;
    }

    /** The valid (non-NaN) count of a column. */
    static int64 validCount(float32[] col, int64 n) {
        int64 c = (int64) 0;
        int64 r = (int64) 0;
        while (r < n) {
            if (!Sketch.isNaN(col[r])) { c = c + (int64) 1; }
            r = r + (int64) 1;
        }
        return c;
    }

    /** Buffers that hold any column of `n` rows sketched to `maxBin` bins with every value valid. */
    static #ColumnWork workFor(int64 n, int64 maxBin) {
        int64 nBins = maxBin < n ? maxBin : n;
        if (nBins < (int64) 1) { nBins = (int64) 1; }
        int64 rows = n < (int64) 1 ? (int64) 1 : n;
        return ColumnWork.create(Sketch.limitSize(rows, nBins), Sketch.limitLevels(rows, nBins) + (int64) 2);
    }

    /**
     * Streams a column of `colSize` valid values through the GK queue and level
     * tree (quantile.h:563-641), leaving `GetSummary`'s result in `ws.s*`;
     * returns its size.
     */
    static int64 summarize(float32[] col, int64 n, int64 limit, ColumnWork ws) {
        int64 qcap = limit * (int64) 2;
        int64 ls = ws.limit;
        float32[] qv = ws.qv; float32[] qw = ws.qw;
        float32[] trm = ws.trm; float32[] trx = ws.trx; float32[] twm = ws.twm; float32[] tv = ws.tv;
        float32[] srm = ws.srm; float32[] srx = ws.srx; float32[] swm = ws.swm; float32[] sv = ws.sv;
        float32[] lrm = ws.lrm; float32[] lrx = ws.lrx; float32[] lwm = ws.lwm; float32[] lv = ws.lv;
        int64[] lsize = ws.lsize;
        int64 c = (int64) 0;
        while (c < ws.slots) { lsize[c] = (int64) 0; c = c + (int64) 1; }
        int64 qtail = (int64) 0;
        boolean levelsUsed = false;
        int64 maxLevel = (int64) 0;

        int64 r = (int64) 0;
        while (r < n) {
            float32 val = col[r];
            if (!Sketch.isNaN(val)) {
                if (qtail == qcap && qv[qtail - (int64) 1] != val) {
                    int64 tn = Sketch.makeSummary(qv, qw, qtail, ws, trm, trx, twm, tv);
                    qtail = (int64) 0;
                    levelsUsed = true;
                    int64 l = (int64) 1;
                    while (true) {
                        if (l > maxLevel) { maxLevel = l; }
                        int64 lb = l * ls;
                        int64 pn = Sketch.setPrune(trm, trx, twm, tv, tn, limit, srm, srx, swm, sv);
                        if (lsize[l] == (int64) 0) {
                            int64 cc = (int64) 0;
                            while (cc < pn) { lrm[lb + cc] = srm[cc]; lrx[lb + cc] = srx[cc]; lwm[lb + cc] = swm[cc]; lv[lb + cc] = sv[cc]; cc = cc + (int64) 1; }
                            lsize[l] = pn;
                            break;
                        }
                        tn = Sketch.setCombine(srm, srx, swm, sv, pn, lrm, lrx, lwm, lv, lb, lsize[l], trm, trx, twm, tv);
                        if (tn > limit) {
                            lsize[l] = (int64) 0;
                            l = l + (int64) 1;
                        } else {
                            int64 cc = (int64) 0;
                            while (cc < tn) { lrm[lb + cc] = trm[cc]; lrx[lb + cc] = trx[cc]; lwm[lb + cc] = twm[cc]; lv[lb + cc] = tv[cc]; cc = cc + (int64) 1; }
                            lsize[l] = tn;
                            break;
                        }
                    }
                }
                if (qtail == (int64) 0 || qv[qtail - (int64) 1] != val) {
                    qv[qtail] = val; qw[qtail] = (float32) 1.0; qtail = qtail + (int64) 1;
                } else {
                    qw[qtail - (int64) 1] = qw[qtail - (int64) 1] + (float32) 1.0;
                }
            }
            r = r + (int64) 1;
        }

        int64 on = Sketch.makeSummary(qv, qw, qtail, ws, trm, trx, twm, tv);
        if (!levelsUsed) {
            if (on > limit) {
                return Sketch.setPrune(trm, trx, twm, tv, on, limit, srm, srx, swm, sv);
            }
            int64 cc = (int64) 0;
            while (cc < on) { srm[cc] = trm[cc]; srx[cc] = trx[cc]; swm[cc] = twm[cc]; sv[cc] = tv[cc]; cc = cc + (int64) 1; }
            return on;
        }
        int64 s0 = Sketch.setPrune(trm, trx, twm, tv, on, limit, srm, srx, swm, sv);
        int64 l = (int64) 1;
        while (l <= maxLevel) {
            if (lsize[l] != (int64) 0) {
                int64 lb = l * ls;
                if (s0 == (int64) 0) {
                    int64 cc = (int64) 0;
                    while (cc < lsize[l]) { srm[cc] = lrm[lb + cc]; srx[cc] = lrx[lb + cc]; swm[cc] = lwm[lb + cc]; sv[cc] = lv[lb + cc]; cc = cc + (int64) 1; }
                    s0 = lsize[l];
                } else {
                    int64 tn = Sketch.setCombine(srm, srx, swm, sv, s0, lrm, lrx, lwm, lv, lb, lsize[l], trm, trx, twm, tv);
                    s0 = Sketch.setPrune(trm, trx, twm, tv, tn, limit, srm, srx, swm, sv);
                }
            }
            l = l + (int64) 1;
        }
        return s0;
    }

    /**
     * One column's cuts into `out` from index 0, returning how many were
     * written (at most `maxBin + 1`). `col` holds the column's values in row
     * order, narrowed to float32, NaN for missing. Uses `ws` when it is large
     * enough, else buffers of its own.
     */
    static int64 sketchColumn(float32[] col, int64 n, int64 maxBin, float64 eps, float32[] out, ColumnWork ws) {
        int64 colSize = Sketch.validCount(col, n);
        if (colSize == (int64) 0) { return (int64) 0; }
        int64 nBins = maxBin < colSize ? maxBin : colSize;
        if (nBins < (int64) 1) { nBins = (int64) 1; }
        int64 limit = Sketch.limitSize(colSize, nBins);
        int64 slots = Sketch.limitLevels(colSize, nBins) + (int64) 2;
        if (!ws.fits(limit, slots)) {
            ColumnWork own #= ColumnWork.create(limit, slots);
            return Sketch.cutsOf(col, n, colSize, limit, maxBin, eps, out, own);
        }
        return Sketch.cutsOf(col, n, colSize, limit, maxBin, eps, out, ws);
    }

    /** `AllReduce`'s and `MakeCuts`' prunes of the column's summary, then the sentinels (quantile.cc:318-448). */
    static int64 cutsOf(float32[] col, int64 n, int64 colSize, int64 limit, int64 maxBin, float64 eps,
                        float32[] out, ColumnWork ws) {
        int64 gs = Sketch.summarize(col, n, limit, ws);
        float32[] trm = ws.trm; float32[] trx = ws.trx; float32[] twm = ws.twm; float32[] tv = ws.tv;
        float32[] srm = ws.srm; float32[] srx = ws.srx; float32[] swm = ws.swm; float32[] sv = ws.sv;
        int64 inter = (int64) ((float32) maxBin * (float32) 8.0);
        if (colSize < inter) { inter = colSize; }
        int64 rn = Sketch.setPrune(srm, srx, swm, sv, gs, inter, trm, trx, twm, tv);
        int64 maxNumBins = inter < maxBin ? inter : maxBin;
        int64 an = Sketch.setPrune(trm, trx, twm, tv, rn, maxNumBins + (int64) 1, srm, srx, swm, sv);

        int64 pos = (int64) 0;
        float64 mval = (float64) sv[0];
        float64 amag = mval < (float64) 0.0 ? (float64) 0.0 - mval : mval;
        out[pos] = (float32) ((mval - amag) - eps); pos = pos + (int64) 1;
        int64 required = an < maxNumBins ? an : maxNumBins;
        int64 e = (int64) 1;
        while (e < required) {
            float32 cpt = sv[e];
            if (e == (int64) 1 || cpt > out[pos - (int64) 1]) {
                out[pos] = cpt; pos = pos + (int64) 1;
            }
            e = e + (int64) 1;
        }
        float64 cptL = (float64) sv[an - (int64) 1];
        float64 cmag = cptL < (float64) 0.0 ? (float64) 0.0 - cptL : cptL;
        out[pos] = (float32) (cptL + (cmag + eps)); pos = pos + (int64) 1;
        return pos;
    }

    /** One column's cuts into `out` (at least `maxBin + 1` long), with buffers of its own; returns the count. */
    public static int64 columnCuts(float32[] col, int64 n, int64 maxBin, float32[] out) {
        ColumnWork ws #= Sketch.workFor(n, maxBin);
        return Sketch.sketchColumn(col, n, maxBin, Sketch.epsSentinel(), out, ws);
    }

    /** The column's `GetSummary` result into `rm, rx, wm, v` (each at least `n` long); returns its size. A test hook. */
    public static int64 columnSummary(float32[] col, int64 n, int64 maxBin,
                                      float32[] rm, float32[] rx, float32[] wm, float32[] v) {
        int64 colSize = Sketch.validCount(col, n);
        if (colSize == (int64) 0) { return (int64) 0; }
        int64 nBins = maxBin < colSize ? maxBin : colSize;
        if (nBins < (int64) 1) { nBins = (int64) 1; }
        int64 limit = Sketch.limitSize(colSize, nBins);
        ColumnWork ws #= ColumnWork.create(limit, Sketch.limitLevels(colSize, nBins) + (int64) 2);
        int64 gs = Sketch.summarize(col, n, limit, ws);
        int64 g = (int64) 0;
        while (g < gs) { rm[g] = ws.srm[g]; rx[g] = ws.srx[g]; wm[g] = ws.swm[g]; v[g] = ws.sv[g]; g = g + (int64) 1; }
        return gs;
    }

    /** Sketches the columns `f, f + stride, ...` of the contiguous host tensor `x` into their slots of `slots`, recording each count. */
    static async int32 sketchColumns(Tensor<float64> x, int64 n, int64 nf, int64 maxBin,
                                     float64 eps, int64 first, int64 stride,
                                     float32[] slots, int64[] counts) {
        int64 width = maxBin + (int64) 1;
        float32[] col = heap float32[n];
        float32[] cut = heap float32[width];
        ColumnWork ws #= Sketch.workFor(n, maxBin);
        float64[] xb = x.hostBuffer();
        int64 xo = x.hostBase();
        int64 f = first;
        while (f < nf) {
            int64 r = (int64) 0;
            while (r < n) {
                col[r] = (float32) xb[xo + r * nf + f];
                r = r + (int64) 1;
            }
            int64 k = Sketch.sketchColumn(col, n, maxBin, eps, cut, ws);
            int64 j = (int64) 0;
            while (j < k) {
                slots[f * width + j] = cut[j];
                j = j + (int64) 1;
            }
            counts[f] = k;
            f = f + stride;
        }
        return (int32) 0;
    }

    /**
     * GPU-parity quantile cuts: fills `cutPtrs[nf+1]`, returns the concatenated
     * per-feature `[min_sentinel, interior…, max_sentinel]` values, bit-exact to
     * `QuantileDMatrix(numpy).get_quantile_cut()` on xgboost 3.1.2. Columns are
     * sketched in parallel, two tasks per carrier.
     */
    public static #float32[] cuts(Tensor<float64> x, int64 n, int64 nf, int64 maxBin,
                                  int64[] cutPtrs) {
        return Sketch.cutsWith(x, n, nf, maxBin, cutPtrs, (int64) Carriers.count() * (int64) 2);
    }

    /** {@link #cuts} over at most `tasks` concurrent column tasks; the result does not depend on it. */
    public static #float32[] cutsWith(Tensor<float64> x, int64 n, int64 nf, int64 maxBin,
                                      int64[] cutPtrs, int64 tasks) {
        int64 width = maxBin + (int64) 1;
        float32[] slots = heap float32[nf * width];
        int64[] counts = heap int64[nf];
        float64 eps = Sketch.epsSentinel();
        int64 t = tasks;
        if (t > nf) { t = nf; }
        if (t < (int64) 1) { t = (int64) 1; }
        scope {
            int64 first = (int64) 0;
            while (first < t) {
                spawn sketchColumns(x, n, nf, maxBin, eps, first, t, slots, counts);
                first = first + (int64) 1;
            }
        }
        int64 pos = (int64) 0;
        cutPtrs[0] = (int64) 0;
        int64 f = (int64) 0;
        while (f < nf) {
            pos = pos + counts[f];
            cutPtrs[f + (int64) 1] = pos;
            f = f + (int64) 1;
        }
        float32[] res = heap float32[pos];
        pos = (int64) 0;
        f = (int64) 0;
        while (f < nf) {
            int64 j = (int64) 0;
            while (j < counts[f]) {
                res[pos] = slots[f * width + j];
                pos = pos + (int64) 1;
                j = j + (int64) 1;
            }
            f = f + (int64) 1;
        }
        return #res;
    }

    /** No-prune convenience (U9): delegates to {@link #cuts}. */
    public static #float32[] cutsNoPrune(Tensor<float64> x, int64 n, int64 nf, int64 maxBin,
                                         int64[] cutPtrs) {
        return Sketch.cuts(x, n, nf, maxBin, cutPtrs);
    }
}