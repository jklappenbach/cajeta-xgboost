package dev.cajeta.xgboost;

/**
 * cajeta-xgboost — a nucleo-native gradient-boosted decision tree library that
 * reproduces XGBoost's NVIDIA GPU `hist` algorithm BIT-FOR-BIT on every cajeta
 * backend (CPU / AMD / NVIDIA). Determinism is the default and the guarantee.
 *
 * This is the library entry class (the `--emit=cja` root). The GBDT surface —
 * the histogram tree builder, the boosting loop, the objectives, and the
 * bit-exact parity harness — lands unit by unit per the cajeta-xgboost plan.
 */
public final class XGBoost {
    /** The library version. Mirrors `details.version` in cajeta.json, which
     *  is the single source of truth. Raise both in the same cut. */
    public static #String version() { return "0.4.0"; }

    /** `--emit=cja` entry. */
    public static int32 run() { return 0; }
}
